---
export const prerender = false;

import Layout from '../components/Layout.astro';
import SongDetail from '../components/SongDetail.astro';
import { adminDb } from '../lib/firebase-admin';
import { generateSlug } from '../lib/chordParser';

interface Chord {
  id: string;
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const base = import.meta.env.BASE_URL || '';
const { slug } = Astro.params;

let chord: Chord | null = null;

if (slug) {
  const snapshot = await adminDb
    .collection('chords')
    .get();

  for (const doc of snapshot.docs) {
    const data = doc.data();

    const generatedSlug =
      generateSlug(
        String(data.title || '')
      );

    if (generatedSlug === slug) {
      chord = {
        id: doc.id,
        ...data,
      } as Chord;

      break;
    }
  }
}

if (!chord) {
  return Astro.redirect(`${base}/`);
}

const {
  title,
  artist,
  key,
  content,
} = chord;
---

<Layout title={`${title} — SENAR`}>
  <main class="song-page">

    <!-- =====================================================
         TOP NAV
    ====================================================== -->

    <header class="song-page-header">
      <a
        href={`${base}/`}
        class="back-link"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path d="M19 12H5"></path>
          <path d="m11 18-6-6 6-6"></path>
        </svg>

        <span>Semua lagu</span>
      </a>

      <span class="page-label">
        SENAR / CHORD
      </span>
    </header>

    <!-- =====================================================
         SONG
    ====================================================== -->

    <SongDetail
      title={title}
      artist={artist}
      key={key}
      content={content}
    />

  </main>
</Layout>

<style>
  .song-page {
    width: 100%;
  }

  .song-page-header {
    width: 100%;
    max-width: 900px;

    margin:
      0
      auto;

    padding:
      24px
      28px
      0;

    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 20px;
  }

  .back-link {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    color: #737373;

    font-size: 10px;

    font-weight: 650;

    text-decoration: none;

    transition:
      color 150ms ease,
      transform 150ms ease;
  }

  .back-link:hover {
    color: #090909;

    transform:
      translateX(-2px);
  }

  .back-link svg {
    width: 13px;
    height: 13px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .page-label {
    color: #b1b1b1;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 800;

    letter-spacing:
      0.14em;
  }

  @media (max-width: 600px) {
    .song-page-header {
      padding-inline:
        18px;
    }
  }

  @media (max-width: 480px) {
    .song-page-header {
      padding-inline:
        14px;
    }

    .page-label {
      display: none;
    }
  }
</style>