---
export const prerender = false;

import Layout from '../../components/Layout.astro';
import { parseSongContent } from '../../lib/chordParser';

const base = import.meta.env.BASE_URL || '/';

const normalizedBase =
  base === '/'
    ? ''
    : base.endsWith('/')
      ? base.slice(0, -1)
      : base;
---

<Layout title="Tambah Chord — SENAR">
  <main
    class="editor-page"
    data-base={normalizedBase}
  >

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="editor-header">

      <div class="editor-heading">

        <a
          href={`${normalizedBase}/admin`}
          class="back-link"
          aria-label="Kembali ke library admin"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>

          <span>Library</span>
        </a>

        <div class="editor-eyebrow">
          <span
            class="eyebrow-line"
            aria-hidden="true"
          ></span>

          <span>
            SENAR / NEW ENTRY
          </span>
        </div>

        <h1>
          Tambah chord
        </h1>

        <p>
          Buat entri lagu baru untuk library
          chord ukulele SENAR.
        </p>

      </div>

      <div class="editor-top-actions">

        <span
          class="save-status"
          data-save-status
          role="status"
          aria-live="polite"
        >
          NEW
        </span>

        <a
          href={`${normalizedBase}/admin`}
          class="preview-link"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>

          <span>Kembali</span>
        </a>

      </div>

    </header>

    <!-- ======================================================
         EDITOR LAYOUT
    ======================================================= -->

    <div class="editor-layout">

      <!-- ====================================================
           MAIN FORM
      ===================================================== -->

      <section
        class="editor-main"
        aria-label="Form chord baru"
      >

        <form
          id="createForm"
          class="create-form"
        >

          <!-- ==================================================
               SONG INFORMATION
          =================================================== -->

          <div class="editor-section">

            <div class="section-heading">

              <div class="section-heading-main">

                <span
                  class="section-index"
                  aria-hidden="true"
                >
                  01
                </span>

                <div>
                  <span class="section-kicker">
                    SONG INFORMATION
                  </span>

                  <h2>
                    Informasi lagu
                  </h2>
                </div>

              </div>

            </div>

            <div class="metadata-grid">

              <label class="field field-title">
                <span class="field-label">
                  Judul lagu
                  <b aria-hidden="true">*</b>
                  <span class="sr-only">
                    wajib diisi
                  </span>
                </span>

                <input
                  type="text"
                  id="title"
                  name="title"
                  required
                  maxlength="160"
                  autocomplete="off"
                  autocapitalize="sentences"
                  class="field-input field-input-large"
                  placeholder="Contoh: Rasa Cinta Ini"
                  data-field
                />
              </label>

              <label class="field">
                <span class="field-label">
                  Artis
                  <b aria-hidden="true">*</b>
                  <span class="sr-only">
                    wajib diisi
                  </span>
                </span>

                <input
                  type="text"
                  id="artist"
                  name="artist"
                  required
                  maxlength="120"
                  autocomplete="off"
                  autocapitalize="words"
                  class="field-input"
                  placeholder="Nama artis"
                  data-field
                />
              </label>

              <label class="field field-key">
                <span class="field-label">
                  Kunci
                  <small>opsional</small>
                </span>

                <input
                  type="text"
                  id="key"
                  name="key"
                  maxlength="8"
                  autocomplete="off"
                  autocapitalize="characters"
                  class="field-input key-input"
                  placeholder="C"
                  spellcheck="false"
                  data-field
                />
              </label>

            </div>

          </div>

          <!-- ==================================================
               CHORD EDITOR
          =================================================== -->

          <div
            class="editor-section chord-editor-section"
          >

            <div
              class="section-heading editor-section-heading"
            >

              <div class="section-heading-main">

                <span
                  class="section-index"
                  aria-hidden="true"
                >
                  02
                </span>

                <div>
                  <span class="section-kicker">
                    CHORD CONTENT
                  </span>

                  <h2>
                    Chord &amp; lirik
                  </h2>
                </div>

              </div>

              <div class="content-stats">

                <div>
                  <span>LINES</span>

                  <strong data-line-count>
                    0
                  </strong>
                </div>

                <div>
                  <span>CHARS</span>

                  <strong data-char-count>
                    0
                  </strong>
                </div>

              </div>

            </div>

            <!-- FORMAT BAR -->

            <div class="editor-toolbar">

              <div class="toolbar-group">

                <span class="toolbar-label">
                  FORMAT
                </span>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Intro]"
                >
                  Intro
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Verse 1]"
                >
                  Verse
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Chorus]"
                >
                  Chorus
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Bridge]"
                >
                  Bridge
                </button>

              </div>

              <div class="toolbar-hint">
                <span>[C]Rasa [G]cinta</span>
                <span aria-hidden="true">·</span>
                <span>TAB = indent</span>
              </div>

            </div>

            <!-- TEXT EDITOR -->

            <div class="editor-wrapper">

              <div
                class="line-numbers"
                data-line-numbers
                aria-hidden="true"
              >
                <span>1</span>
              </div>

              <textarea
                id="content"
                name="content"
                rows="24"
                required
                spellcheck="false"
                autocomplete="off"
                autocapitalize="sentences"
                wrap="off"
                data-content-editor
                class="content-editor"
                aria-label="Isi chord dan lirik"
                placeholder="[Intro]

[C] [G] [Am] [F]

[Verse 1]
[C]Rasa [G]cinta ini
[Am]tak pernah [F]hilang

[Chorus]
[C]...
[G]..."
              ></textarea>

            </div>

            <div class="editor-footer">
              <span>
                Plain text chord format
              </span>

              <span>
                Ukulele · GCEA
              </span>
            </div>

          </div>

          <!-- ==================================================
               ACTIONS
          =================================================== -->

          <div class="form-actions">

            <button
              type="button"
              id="cancelBtn"
              class="cancel-button"
            >
              Batal
            </button>

            <button
              type="button"
              id="previewBtn"
              class="preview-button"
            >
              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"
                ></path>

                <circle
                  cx="12"
                  cy="12"
                  r="2.5"
                ></circle>
              </svg>

              <span>Preview</span>
            </button>

            <button
              type="submit"
              id="saveBtn"
              class="save-button"
            >
              <span data-save-label>
                Simpan chord
              </span>

              <svg
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M5 12h13"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </button>

          </div>

        </form>

      </section>

      <!-- ====================================================
           LIVE PREVIEW
      ===================================================== -->

      <aside
        class="preview-panel"
        aria-label="Live preview"
      >

        <div class="preview-panel-header">

          <div>
            <span class="section-kicker">
              LIVE PREVIEW
            </span>

            <h2>
              Song preview
            </h2>
          </div>

          <span class="preview-state">
            LIVE
          </span>

        </div>

        <div
          id="previewArea"
          class="song-preview"
        >

          <header class="preview-song-header">

            <span class="preview-eyebrow">
              CHORD &amp; LYRICS
            </span>

            <h3 data-preview-title>
              Untitled song
            </h3>

            <div class="preview-meta">

              <span data-preview-artist>
                Unknown artist
              </span>

              <span
                class="preview-key-wrap"
                data-preview-key-wrap
                hidden
              >
                <span
                  class="preview-dot"
                  aria-hidden="true"
                ></span>

                <span>
                  KEY
                  <strong
                    data-preview-key
                  ></strong>
                </span>
              </span>

            </div>

          </header>

          <div
            class="preview-content"
            data-preview-content
            aria-live="polite"
          >
            <div class="preview-placeholder">
              Mulai mengetik chord dan lirik
              untuk melihat preview.
            </div>
          </div>

        </div>

        <div class="preview-footer">

          <span>
            Preview tidak menyimpan perubahan
          </span>

          <span>
            LIVE
          </span>

        </div>

      </aside>

    </div>

    <!-- ======================================================
         FOOTER
    ======================================================= -->

    <footer class="editor-bottom">

      <div>
        <span class="danger-label">
          NEW RECORD
        </span>

        <code>
          AUTO-ID
        </code>
      </div>

      <span>
        Chord baru akan ditambahkan
        ke library SENAR.
      </span>

    </footer>

  </main>
</Layout>

<script>
  import { parseSongContent } from '../../lib/chordParser';

  type PreviewBlock =
    | {
        type: 'blank';
      }
    | {
        type: 'section';
        value: string;
      }
    | {
        type: 'line';
        chords: Array<{
          value: string;
          position: number;
        }>;
        lyric: string;
      }
    | {
        type: 'instrumental';
        chords: Array<{
          value: string;
          position: number;
        }>;
      }
    | {
        type: 'lyric';
        lyric: string;
      };

  document.addEventListener(
    'astro:page-load',
    () => {
      const page =
        document.querySelector<HTMLElement>(
          '.editor-page'
        );

      if (!page) {
        return;
      }

      if (
        page.dataset.initialized === 'true'
      ) {
        return;
      }

      page.dataset.initialized = 'true';

      const basePath =
        page.dataset.base || '';

      const form =
        document.querySelector<HTMLFormElement>(
          '#createForm'
        );

      const saveBtn =
        document.querySelector<HTMLButtonElement>(
          '#saveBtn'
        );

      const saveLabel =
        document.querySelector<HTMLElement>(
          '[data-save-label]'
        );

      const saveStatus =
        document.querySelector<HTMLElement>(
          '[data-save-status]'
        );

      const cancelBtn =
        document.querySelector<HTMLButtonElement>(
          '#cancelBtn'
        );

      const previewBtn =
        document.querySelector<HTMLButtonElement>(
          '#previewBtn'
        );

      const titleInput =
        document.querySelector<HTMLInputElement>(
          '#title'
        );

      const artistInput =
        document.querySelector<HTMLInputElement>(
          '#artist'
        );

      const keyInput =
        document.querySelector<HTMLInputElement>(
          '#key'
        );

      const contentInput =
        document.querySelector<HTMLTextAreaElement>(
          '#content'
        );

      const lineCount =
        document.querySelector<HTMLElement>(
          '[data-line-count]'
        );

      const charCount =
        document.querySelector<HTMLElement>(
          '[data-char-count]'
        );

      const lineNumbers =
        document.querySelector<HTMLElement>(
          '[data-line-numbers]'
        );

      const previewTitle =
        document.querySelector<HTMLElement>(
          '[data-preview-title]'
        );

      const previewArtist =
        document.querySelector<HTMLElement>(
          '[data-preview-artist]'
        );

      const previewKey =
        document.querySelector<HTMLElement>(
          '[data-preview-key]'
        );

      const previewKeyWrap =
        document.querySelector<HTMLElement>(
          '[data-preview-key-wrap]'
        );

      const previewContent =
        document.querySelector<HTMLElement>(
          '[data-preview-content]'
        );

      if (
        !form ||
        !saveBtn ||
        !saveLabel ||
        !saveStatus ||
        !cancelBtn ||
        !previewBtn ||
        !titleInput ||
        !artistInput ||
        !keyInput ||
        !contentInput ||
        !lineCount ||
        !charCount ||
        !lineNumbers ||
        !previewTitle ||
        !previewArtist ||
        !previewKey ||
        !previewKeyWrap ||
        !previewContent
      ) {
        return;
      }

      let isDirty = false;
      let isSaving = false;

      /*
       * ======================================================
       * HELPERS
       * ======================================================
       */

      const escapeHTML = (
        value: string
      ): string => {
        return String(value)
          .replaceAll('&', '&amp;')
          .replaceAll('<', '&lt;')
          .replaceAll('>', '&gt;')
          .replaceAll('"', '&quot;')
          .replaceAll(
            "'",
            '&#39;'
          );
      };

      const setSaveStatus = (
        value: string,
        draft = false
      ): void => {
        saveStatus.textContent =
          value;

        saveStatus.classList.toggle(
          'is-draft',
          draft
        );
      };

      const focusField = (
        field: HTMLInputElement | HTMLTextAreaElement
      ): void => {
        field.focus();

        requestAnimationFrame(() => {
          const length =
            field.value.length;

          try {
            field.setSelectionRange(
              length,
              length
            );
          } catch {
            // Some field types may reject selection ranges.
          }
        });
      };

      /*
       * ======================================================
       * STATS
       * ======================================================
       */

      const updateStats = (): void => {
        const value =
          contentInput.value;

        const lineTotal =
          value.length === 0
            ? 0
            : value.split('\n').length;

        lineCount.textContent =
          String(lineTotal);

        charCount.textContent =
          String(value.length);
      };

      /*
       * ======================================================
       * LINE NUMBERS
       * ======================================================
       */

      const updateLineNumbers = (): void => {
        const lineTotal =
          Math.max(
            1,
            contentInput.value.split('\n').length
          );

        const fragment =
          document.createDocumentFragment();

        for (
          let index = 1;
          index <= lineTotal;
          index += 1
        ) {
          const span =
            document.createElement(
              'span'
            );

          span.textContent =
            String(index);

          fragment.appendChild(
            span
          );
        }

        lineNumbers.replaceChildren(
          fragment
        );

        lineNumbers.scrollTop =
          contentInput.scrollTop;
      };

      /*
       * ======================================================
       * PREVIEW METADATA
       * ======================================================
       */

      const updatePreviewMetadata =
        (): void => {
          const title =
            titleInput.value.trim();

          const artist =
            artistInput.value.trim();

          const key =
            keyInput.value.trim();

          previewTitle.textContent =
            title ||
            'Untitled song';

          previewArtist.textContent =
            artist ||
            'Unknown artist';

          previewKey.textContent =
            key;

          previewKeyWrap.hidden =
            key.length === 0;
        };

      /*
       * ======================================================
       * PREVIEW BLOCK RENDERING
       * ======================================================
       */

      const createChordElement = (
        chord: {
          value: string;
          position: number;
        }
      ): HTMLSpanElement => {
        const element =
          document.createElement(
            'span'
          );

        element.className =
          'preview-chord';

        element.dataset.position =
          String(
            chord.position
          );

        element.textContent =
          chord.value;

        return element;
      };

      const createLyricElement = (
        value: string
      ): HTMLSpanElement => {
        const element =
          document.createElement(
            'span'
          );

        element.className =
          'preview-lyric';

        element.textContent =
          value;

        return element;
      };

      const renderPreview = (): void => {
        const raw =
          contentInput.value;

        if (!raw.trim()) {
          const placeholder =
            document.createElement(
              'div'
            );

          placeholder.className =
            'preview-placeholder';

          placeholder.textContent =
            'Mulai mengetik chord dan lirik untuk melihat preview.';

          previewContent.replaceChildren(
            placeholder
          );

          return;
        }

        let parsed:
          | PreviewBlock[]
          | null = null;

        try {
          parsed =
            parseSongContent(
              raw
            ) as PreviewBlock[];
        } catch (error) {
          console.error(
            'Preview parser error:',
            error
          );

          const fallback =
            document.createElement(
              'div'
            );

          fallback.className =
            'preview-parse-error';

          fallback.textContent =
            'Preview belum dapat membaca format ini. Data tetap bisa disimpan.';

          previewContent.replaceChildren(
            fallback
          );

          return;
        }

        const fragment =
          document.createDocumentFragment();

        parsed.forEach(
          (
            block,
            index
          ) => {

            if (
              block.type === 'blank'
            ) {
              const element =
                document.createElement(
                  'div'
                );

              element.className =
                'preview-empty-line';

              element.style.setProperty(
                '--preview-index',
                String(index)
              );

              fragment.appendChild(
                element
              );

              return;
            }

            if (
              block.type ===
              'section'
            ) {
              const wrapper =
                document.createElement(
                  'div'
                );

              wrapper.className =
                'preview-section';

              wrapper.style.setProperty(
                '--preview-index',
                String(index)
              );

              const line =
                document.createElement(
                  'span'
                );

              line.className =
                'preview-section-line';

              const label =
                document.createElement(
                  'span'
                );

              label.textContent =
                String(
                  block.value || ''
                )
                  .replace(
                    /^\[/,
                    ''
                  )
                  .replace(
                    /\]$/,
                    ''
                  )
                  .trim();

              wrapper.append(
                line,
                label
              );

              fragment.appendChild(
                wrapper
              );

              return;
            }

            if (
              block.type === 'line'
            ) {
              const wrapper =
                document.createElement(
                  'div'
                );

              wrapper.className =
                'preview-line';

              wrapper.style.setProperty(
                '--preview-index',
                String(index)
              );

              const chordRow =
                document.createElement(
                  'div'
                );

              chordRow.className =
                'preview-chord-row';

              block.chords.forEach(
                (chord) => {
                  chordRow.appendChild(
                    createChordElement(
                      chord
                    )
                  );
                }
              );

              const lyricRow =
                document.createElement(
                  'div'
                );

              lyricRow.className =
                'preview-lyric-row';

              lyricRow.appendChild(
                createLyricElement(
                  block.lyric
                )
              );

              wrapper.append(
                chordRow,
                lyricRow
              );

              fragment.appendChild(
                wrapper
              );

              return;
            }

            if (
              block.type ===
              'instrumental'
            ) {
              const wrapper =
                document.createElement(
                  'div'
                );

              wrapper.className =
                'preview-line preview-instrumental-line';

              wrapper.style.setProperty(
                '--preview-index',
                String(index)
              );

              const chordRow =
                document.createElement(
                  'div'
                );

              chordRow.className =
                'preview-chord-row'
                + ' preview-chord-row-only';

              block.chords.forEach(
                (chord) => {
                  chordRow.appendChild(
                    createChordElement(
                      chord
                    )
                  );
                }
              );

              wrapper.appendChild(
                chordRow
              );

              fragment.appendChild(
                wrapper
              );

              return;
            }

            if (
              block.type === 'lyric'
            ) {
              const wrapper =
                document.createElement(
                  'div'
                );

              wrapper.className =
                'preview-line preview-lyric-only';

              wrapper.style.setProperty(
                '--preview-index',
                String(index)
              );

              wrapper.appendChild(
                createLyricElement(
                  block.lyric
                )
              );

              fragment.appendChild(
                wrapper
              );
            }
          }
        );

        previewContent.replaceChildren(
          fragment
        );
      };

      /*
       * ======================================================
       * FULL PREVIEW UPDATE
       * ======================================================
       */

      const updatePreview = (): void => {
        updatePreviewMetadata();
        renderPreview();
        updateStats();
        updateLineNumbers();
      };

      /*
       * ======================================================
       * DIRTY STATE
       * ======================================================
       */

      const updateDirtyState =
        (): void => {
          const dirty =
            titleInput.value.trim() !== '' ||
            artistInput.value.trim() !== '' ||
            keyInput.value.trim() !== '' ||
            contentInput.value.trim() !== '';

          isDirty =
            dirty &&
            !isSaving;

          setSaveStatus(
            dirty
              ? 'DRAFT'
              : 'NEW',
            dirty
          );
        };

      /*
       * ======================================================
       * INPUT EVENTS
       * ======================================================
       */

      const watchedInputs = [
        titleInput,
        artistInput,
        keyInput,
        contentInput,
      ];

      watchedInputs.forEach(
        (input) => {
          input.addEventListener(
            'input',
            () => {
              updatePreview();
              updateDirtyState();
            }
          );
        }
      );

      /*
       * ======================================================
       * TEXTAREA SCROLL
       * ======================================================
       */

      contentInput.addEventListener(
        'scroll',
        () => {
          lineNumbers.scrollTop =
            contentInput.scrollTop;
        }
      );

      /*
       * ======================================================
       * TAB INSERT
       * ======================================================
       */

      contentInput.addEventListener(
        'keydown',
        (event) => {
          if (
            event.key !== 'Tab'
          ) {
            return;
          }

          event.preventDefault();

          const start =
            contentInput.selectionStart;

          const end =
            contentInput.selectionEnd;

          const before =
            contentInput.value.slice(
              0,
              start
            );

          const after =
            contentInput.value.slice(
              end
            );

          contentInput.value =
            `${before}  ${after}`;

          const nextCursor =
            start + 2;

          contentInput.selectionStart =
            nextCursor;

          contentInput.selectionEnd =
            nextCursor;

          updatePreview();
          updateDirtyState();
        }
      );

      /*
       * ======================================================
       * FORMAT INSERT
       * ======================================================
       */

      document
        .querySelectorAll<HTMLButtonElement>(
          '[data-insert]'
        )
        .forEach(
          (button) => {
            button.addEventListener(
              'click',
              () => {
                const value =
                  button.dataset.insert ||
                  '';

                const start =
                  contentInput.selectionStart;

                const end =
                  contentInput.selectionEnd;

                const current =
                  contentInput.value;

                const before =
                  current.slice(
                    0,
                    start
                  );

                const after =
                  current.slice(
                    end
                  );

                const prefix =
                  before.length > 0 &&
                  !before.endsWith('\n')
                    ? '\n'
                    : '';

                const suffix =
                  '\n';

                const insertion =
                  `${prefix}${value}${suffix}`;

                contentInput.value =
                  `${before}${insertion}${after}`;

                const nextCursor =
                  start +
                  insertion.length;

                contentInput.selectionStart =
                  nextCursor;

                contentInput.selectionEnd =
                  nextCursor;

                contentInput.focus();

                updatePreview();
                updateDirtyState();
              }
            );
          }
        );

      /*
       * ======================================================
       * PREVIEW BUTTON
       * ======================================================
       */

      previewBtn.addEventListener(
        'click',
        () => {
          updatePreview();

          const panel =
            document.querySelector<HTMLElement>(
              '.preview-panel'
            );

          panel?.scrollIntoView({
            behavior:
              window.matchMedia(
                '(prefers-reduced-motion: reduce)'
              ).matches
                ? 'auto'
                : 'smooth',
            block: 'start',
          });
        }
      );

      /*
       * ======================================================
       * CANCEL
       * ======================================================
       */

      cancelBtn.addEventListener(
        'click',
        () => {
          if (isDirty) {
            const confirmed =
              window.confirm(
                'Data yang sudah kamu masukkan akan hilang. Kembali ke library?'
              );

            if (!confirmed) {
              return;
            }
          }

          window.location.assign(
            `${basePath}/admin`
          );
        }
      );

      /*
       * ======================================================
       * SAVE
       * ======================================================
       */

      form.addEventListener(
        'submit',
        async (event) => {
          event.preventDefault();

          if (isSaving) {
            return;
          }

          const title =
            titleInput.value.trim();

          const artist =
            artistInput.value.trim();

          const key =
            keyInput.value
              .trim()
              .replace(/\s+/g, ' ');

          const content =
            contentInput.value.trim();

          if (!title) {
            window.alert(
              'Judul lagu harus diisi.'
            );

            focusField(
              titleInput
            );

            return;
          }

          if (!artist) {
            window.alert(
              'Artis harus diisi.'
            );

            focusField(
              artistInput
            );

            return;
          }

          if (!content) {
            window.alert(
              'Isi chord harus diisi.'
            );

            focusField(
              contentInput
            );

            return;
          }

          isSaving = true;

          isDirty = false;

          saveBtn.disabled = true;

          cancelBtn.disabled =
            true;

          previewBtn.disabled =
            true;

          saveLabel.textContent =
            'Menyimpan…';

          setSaveStatus(
            'SAVING...'
          );

          try {
            const response =
              await fetch(
                `${basePath}/api/admin/chords`,
                {
                  method: 'POST',

                  credentials:
                    'same-origin',

                  headers: {
                    'Content-Type':
                      'application/json',

                    Accept:
                      'application/json',
                  },

                  body:
                    JSON.stringify({
                      title,
                      artist,
                      key,
                      content,
                    }),
                }
              );

            if (!response.ok) {
              let message =
                'Gagal menyimpan chord.';

              try {
                const data =
                  await response.json();

                if (
                  data &&
                  typeof data.error ===
                    'string' &&
                  data.error.trim()
                ) {
                  message =
                    data.error;
                } else if (
                  data &&
                  typeof data.message ===
                    'string' &&
                  data.message.trim()
                ) {
                  message =
                    data.message;
                }
              } catch {
                // Non-JSON response.
              }

              throw new Error(
                message
              );
            }

            saveLabel.textContent =
              'Tersimpan';

            setSaveStatus(
              'SAVED'
            );

            window.setTimeout(
              () => {
                window.location.assign(
                  `${basePath}/admin`
                );
              },
              350
            );
          } catch (error) {
            console.error(
              'Create chord error:',
              error
            );

            isSaving = false;

            isDirty = true;

            saveBtn.disabled =
              false;

            cancelBtn.disabled =
              false;

            previewBtn.disabled =
              false;

            saveLabel.textContent =
              'Simpan chord';

            setSaveStatus(
              'ERROR',
              true
            );

            window.alert(
              error instanceof Error
                ? error.message
                : 'Gagal menyimpan chord.'
            );
          }
        }
      );

      /*
       * ======================================================
       * CMD/CTRL + S
       * ======================================================
       */

      const handleSaveShortcut =
        (event: KeyboardEvent) => {
          if (
            (event.ctrlKey ||
              event.metaKey) &&
            event.key.toLowerCase() ===
              's'
          ) {
            event.preventDefault();

            if (!isSaving) {
              form.requestSubmit();
            }
          }
        };

      window.addEventListener(
        'keydown',
        handleSaveShortcut
      );

      /*
       * ======================================================
       * BEFORE LEAVE
       * ======================================================
       */

      const handleBeforeUnload =
        (event: BeforeUnloadEvent) => {
          if (!isDirty) {
            return;
          }

          event.preventDefault();

          event.returnValue = '';
        };

      window.addEventListener(
        'beforeunload',
        handleBeforeUnload
      );

      /*
       * ======================================================
       * INITIAL STATE
       * ======================================================
       */

      updatePreview();
      updateDirtyState();

      requestAnimationFrame(
        () => {
          page.classList.add(
            'is-ready'
          );
        }
      );
    }
  );
</script>

