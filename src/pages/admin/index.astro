---
export const prerender = false;

import Layout from '../../components/Layout.astro';
import { adminDb } from '../../lib/firebase-admin';
import { generateSlug } from '../../lib/chordParser';

interface Chord {
  id: string;
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const base = import.meta.env.BASE_URL || '/';

const normalizedBase =
  base === '/'
    ? ''
    : base.endsWith('/')
      ? base.slice(0, -1)
      : base;

let chords: Array<Chord & { slug: string }> = [];
let errorMessage: string | null = null;

try {
  const snapshot = await adminDb
    .collection('chords')
    .orderBy('title', 'asc')
    .get();

  chords = snapshot.docs.map((doc) => {
    const data = doc.data();

    const title =
      typeof data.title === 'string' &&
      data.title.trim()
        ? data.title.trim()
        : 'Untitled';

    const artist =
      typeof data.artist === 'string' &&
      data.artist.trim()
        ? data.artist.trim()
        : 'Unknown artist';

    const key =
      typeof data.key === 'string' &&
      data.key.trim()
        ? data.key.trim()
        : undefined;

    const content =
      typeof data.content === 'string'
        ? data.content
        : '';

    return {
      id: doc.id,
      title,
      artist,
      key,
      content,
      slug: generateSlug(title),
    };
  });
} catch (error: unknown) {
  console.error('Error loading admin chord library:', error);

  errorMessage =
    'Gagal memuat library chord. Periksa koneksi Firebase dan konfigurasi Firebase Admin.';
}

const songCount = chords.length;
const songCountLabel = String(songCount).padStart(2, '0');
---

<Layout title="Admin — SENAR">
  <main
    class="admin-page"
    data-base={normalizedBase}
  >

    <!-- ======================================================
         HEADER
    ======================================================= -->

    <header class="admin-header">
      <div class="admin-header-main">
        <div class="admin-eyebrow">
          <span
            class="eyebrow-mark"
            aria-hidden="true"
          ></span>

          <span>
            SENAR / ADMIN
          </span>
        </div>

        <div class="admin-heading-row">
          <div class="admin-title-block">
            <h1>Library</h1>

            <p>
              Kelola seluruh chord dan lirik
              yang tersedia di SENAR.
            </p>
          </div>

          <div
            class="library-stat"
            aria-label={`${songCount} tracks`}
          >
            <span>TRACKS</span>

            <strong aria-hidden="true">
              {songCountLabel}
            </strong>
          </div>
        </div>
      </div>

      <nav
        class="admin-actions"
        aria-label="Admin actions"
      >
        <a
          href={`${normalizedBase}/`}
          class="secondary-action"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>

          <span>Website</span>
        </a>

        <a
          href={`${normalizedBase}/admin/create`}
          class="primary-action"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M12 5v14"></path>
            <path d="M5 12h14"></path>
          </svg>

          <span>Tambah Chord</span>
        </a>
      </nav>
    </header>

    <!-- ======================================================
         TOOLBAR
    ======================================================= -->

    <section
      class="admin-toolbar"
      aria-label="Library controls"
    >
      <div class="toolbar-left">
        <span class="toolbar-title">
          CHORD LIBRARY
        </span>

        <span
          class="toolbar-divider"
          aria-hidden="true"
        ></span>

        <span
          class="toolbar-count"
          data-toolbar-count
          aria-live="polite"
        >
          {songCount}
          {songCount === 1
            ? 'track'
            : 'tracks'}
        </span>
      </div>

      <div class="toolbar-right">
        <label
          class="admin-search"
          aria-label="Cari lagu atau artis"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <circle
              cx="11"
              cy="11"
              r="6.5"
            ></circle>

            <path d="m16 16 5 5"></path>
          </svg>

          <input
            type="search"
            placeholder="Cari lagu atau artis..."
            autocomplete="off"
            autocapitalize="none"
            spellcheck="false"
            enterkeyhint="search"
            data-admin-search
            aria-controls="adminLibraryList"
          />

          <button
            type="button"
            class="search-clear"
            data-clear-search
            aria-label="Hapus pencarian"
            title="Hapus pencarian"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M6 6l12 12"></path>
              <path d="M18 6 6 18"></path>
            </svg>
          </button>

          <kbd aria-hidden="true">
            /
          </kbd>
        </label>

        <button
          type="button"
          id="logoutBtn"
          class="logout-button"
        >
          Logout
        </button>
      </div>
    </section>

    <!-- ======================================================
         STATUS
    ======================================================= -->

    <div
      class="admin-status"
      data-admin-status
      role="status"
      aria-live="polite"
      aria-atomic="true"
    ></div>

    <!-- ======================================================
         ERROR STATE
    ======================================================= -->

    {errorMessage && (
      <section
        class="admin-error"
        role="alert"
      >
        <div
          class="error-icon"
          aria-hidden="true"
        >
          <svg viewBox="0 0 24 24">
            <path d="M12 9v4"></path>
            <path d="M12 17h.01"></path>

            <path
              d="M10.3 3.7 2.7 17a2 2 0 0 0 1.7 3h15.2a2 2 0 0 0 1.7-3L13.7 3.7a2 2 0 0 0-3.4 0Z"
            ></path>
          </svg>
        </div>

        <div class="error-content">
          <span class="error-label">
            SYSTEM ERROR
          </span>

          <h2>
            Gagal memuat library
          </h2>

          <p>
            {errorMessage}
          </p>
        </div>
      </section>
    )}

    <!-- ======================================================
         EMPTY STATE
    ======================================================= -->

    {!errorMessage && songCount === 0 && (
      <section class="admin-empty">
        <div
          class="empty-index"
          aria-hidden="true"
        >
          00
        </div>

        <div class="empty-content">
          <span class="empty-label">
            LIBRARY EMPTY
          </span>

          <h2>
            Belum ada chord
          </h2>

          <p>
            Tambahkan lagu pertama ke library
            SENAR untuk mulai membangun koleksi.
          </p>

          <a
            href={`${normalizedBase}/admin/create`}
            class="empty-action"
          >
            <span>
              Tambah chord pertama
            </span>

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M5 12h13"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </section>
    )}

    <!-- ======================================================
         LIBRARY
    ======================================================= -->

    {!errorMessage && songCount > 0 && (
      <section class="admin-library">

        <div
          class="library-table-head"
          aria-hidden="true"
        >
          <span>NO.</span>
          <span>SONG</span>
          <span>KEY</span>
          <span>ACTIONS</span>
        </div>

        <div
          class="library-list"
          id="adminLibraryList"
          data-library
        >
          {chords.map((chord, index) => (
            <article
              class="admin-song"
              data-song
              data-title={chord.title}
              data-artist={chord.artist}
              style={`--song-index:${index}`}
            >
              <div
                class="song-number"
                aria-hidden="true"
              >
                {String(index + 1).padStart(2, '0')}
              </div>

              <div class="song-information">
                <h2 title={chord.title}>
                  {chord.title}
                </h2>

                <p title={chord.artist}>
                  {chord.artist}
                </p>
              </div>

              <div class="song-key">
                {chord.key ? (
                  <>
                    <span>KEY</span>

                    <strong>
                      {chord.key}
                    </strong>
                  </>
                ) : (
                  <span class="no-key">
                    —
                  </span>
                )}
              </div>

              <div class="song-actions">
                <a
                  href={`${normalizedBase}/admin/${chord.slug}`}
                  class="edit-button"
                  aria-label={`Edit ${chord.title}`}
                >
                  <span>Edit</span>

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M12 20h9"></path>

                    <path
                      d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"
                    ></path>
                  </svg>
                </a>

                <button
                  type="button"
                  class="delete-button"
                  data-delete-button
                  data-id={chord.id}
                  data-title={chord.title}
                  aria-label={`Hapus ${chord.title}`}
                >
                  <span>
                    Hapus
                  </span>

                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path d="M4 7h16"></path>
                    <path d="M10 11v6"></path>
                    <path d="M14 11v6"></path>
                    <path d="M6 7l1 14h10l1-14"></path>
                    <path d="M9 7V4h6v3"></path>
                  </svg>
                </button>
              </div>

              <span
                class="song-hover-line"
                aria-hidden="true"
              ></span>
            </article>
          ))}
        </div>

        <!-- Search empty -->

        <div
          class="library-search-empty"
          data-search-empty
          hidden
          role="status"
          aria-live="polite"
        >
          <span>
            NO MATCH
          </span>

          <h3>
            Tidak ada hasil
          </h3>

          <p>
            Tidak ditemukan lagu atau artis
            yang sesuai dengan pencarian.
          </p>

          <button
            type="button"
            data-reset-search
          >
            Tampilkan semua
          </button>
        </div>
      </section>
    )}

    <!-- ======================================================
         FOOTER
    ======================================================= -->

    <footer class="admin-footer">
      <div
        class="footer-line"
        aria-hidden="true"
      ></div>

      <div class="footer-content">
        <span>
          SENAR ADMIN
        </span>

        <span>
          {songCount} RECORDS
        </span>

        <span>
          {new Date().getFullYear()}
        </span>
      </div>
    </footer>
  </main>
</Layout>

<script>
  document.addEventListener(
    'astro:page-load',
    () => {
      const page =
        document.querySelector<HTMLElement>(
          '.admin-page'
        );

      if (!page) {
        return;
      }

      const basePath =
        page.dataset.base || '';

      const logoutBtn =
        document.querySelector<HTMLButtonElement>(
          '#logoutBtn'
        );

      const searchInput =
        document.querySelector<HTMLInputElement>(
          '[data-admin-search]'
        );

      const clearSearch =
        document.querySelector<HTMLButtonElement>(
          '[data-clear-search]'
        );

      const resetSearch =
        document.querySelector<HTMLButtonElement>(
          '[data-reset-search]'
        );

      const searchEmpty =
        document.querySelector<HTMLElement>(
          '[data-search-empty]'
        );

      const toolbarCount =
        document.querySelector<HTMLElement>(
          '[data-toolbar-count]'
        );

      const status =
        document.querySelector<HTMLElement>(
          '[data-admin-status]'
        );

      const songs =
        Array.from(
          document.querySelectorAll<HTMLElement>(
            '[data-song]'
          )
        );

      const deleteButtons =
        Array.from(
          document.querySelectorAll<HTMLButtonElement>(
            '[data-delete-button]'
          )
        );

      /*
       * ======================================================
       * HELPERS
       * ======================================================
       */

      const normalize = (
        value: string
      ): string => {
        return value
          .toLowerCase()
          .normalize('NFD')
          .replace(
            /[\u0300-\u036f]/g,
            ''
          )
          .trim();
      };

      const showStatus = (
        message: string,
        type:
          | 'success'
          | 'error' = 'success'
      ) => {
        if (!status) {
          return;
        }

        status.textContent = message;

        status.dataset.state = type;

        window.setTimeout(() => {
          if (
            status.textContent ===
            message
          ) {
            status.textContent = '';

            status.removeAttribute(
              'data-state'
            );
          }
        }, 3200);
      };

      /*
       * ======================================================
       * LOGOUT
       * ======================================================
       */

      logoutBtn?.addEventListener(
        'click',
        async () => {
          if (!logoutBtn) {
            return;
          }

          const originalText =
            logoutBtn.textContent ||
            'Logout';

          logoutBtn.disabled = true;

          logoutBtn.textContent =
            'Logging out…';

          try {
            const response =
              await fetch(
                `${basePath}/api/admin/logout`,
                {
                  method: 'POST',
                  credentials: 'same-origin',
                  headers: {
                    Accept:
                      'application/json',
                  },
                }
              );

            if (!response.ok) {
              throw new Error(
                `Logout failed: ${response.status}`
              );
            }

            window.location.assign(
              `${basePath}/`
            );
          } catch (error) {
            console.error(
              'Logout error:',
              error
            );

            logoutBtn.disabled = false;

            logoutBtn.textContent =
              originalText;

            showStatus(
              'Logout gagal. Silakan coba lagi.',
              'error'
            );
          }
        }
      );

      /*
       * ======================================================
       * SEARCH
       * ======================================================
       */

      const songEntries =
        songs.map((element) => ({
          element,
          title: normalize(
            element.dataset.title || ''
          ),
          artist: normalize(
            element.dataset.artist || ''
          ),
        }));

      const updateSearch = () => {
        if (!searchInput) {
          return;
        }

        const query =
          normalize(
            searchInput.value
          );

        let visibleCount = 0;

        for (
          const song
          of songEntries
        ) {
          const matches =
            query === '' ||
            song.title.includes(query) ||
            song.artist.includes(query);

          song.element.hidden =
            !matches;

          if (matches) {
            visibleCount += 1;
          }
        }

        if (clearSearch) {
          clearSearch.hidden =
            query.length === 0;
        }

        if (toolbarCount) {
          toolbarCount.textContent =
            query.length === 0
              ? `${songEntries.length} ${
                  songEntries.length === 1
                    ? 'track'
                    : 'tracks'
                }`
              : `${visibleCount} ${
                  visibleCount === 1
                    ? 'result'
                    : 'results'
                }`;
        }

        if (searchEmpty) {
          searchEmpty.hidden =
            visibleCount !== 0 ||
            query.length === 0;
        }

        page.classList.toggle(
          'is-searching',
          query.length > 0
        );
      };

      searchInput?.addEventListener(
        'input',
        updateSearch
      );

      clearSearch?.addEventListener(
        'click',
        () => {
          if (!searchInput) {
            return;
          }

          searchInput.value = '';

          updateSearch();

          searchInput.focus();
        }
      );

      resetSearch?.addEventListener(
        'click',
        () => {
          if (!searchInput) {
            return;
          }

          searchInput.value = '';

          updateSearch();

          searchInput.focus();
        }
      );

      /*
       * ======================================================
       * KEYBOARD SHORTCUTS
       * ======================================================
       */

      window.addEventListener(
        'keydown',
        (event) => {
          const target =
            event.target;

          const isTyping =
            target instanceof
              HTMLInputElement ||
            target instanceof
              HTMLTextAreaElement ||
            target instanceof
              HTMLSelectElement ||
            (
              target instanceof
                HTMLElement &&
              target.isContentEditable
            );

          /*
           * Escape while searching:
           * clear first, then blur.
           */
          if (
            event.key === 'Escape' &&
            target === searchInput &&
            searchInput
          ) {
            event.preventDefault();

            if (
              searchInput.value.length > 0
            ) {
              searchInput.value = '';

              updateSearch();

              return;
            }

            searchInput.blur();

            return;
          }

          if (isTyping) {
            return;
          }

          /*
           * /
           * Focus search.
           */
          if (
            event.key === '/' &&
            searchInput
          ) {
            event.preventDefault();

            searchInput.focus();

            return;
          }

          /*
           * CMD/CTRL + K
           * Focus search.
           */
          if (
            event.key.toLowerCase() === 'k' &&
            (event.metaKey ||
              event.ctrlKey) &&
            searchInput
          ) {
            event.preventDefault();

            searchInput.focus();
          }
        }
      );

      /*
       * ======================================================
       * DELETE
       * ======================================================
       */

      deleteButtons.forEach(
        (button) => {
          button.addEventListener(
            'click',
            async () => {
              const id =
                button.dataset.id;

              const title =
                button.dataset.title ||
                'this chord';

              if (!id) {
                showStatus(
                  'ID chord tidak ditemukan.',
                  'error'
                );

                return;
              }

              const confirmed =
                window.confirm(
                  `Hapus chord "${title}"?\n\nTindakan ini tidak dapat dibatalkan.`
                );

              if (!confirmed) {
                return;
              }

              const originalHTML =
                button.innerHTML;

              button.disabled = true;

              button.innerHTML =
                '<span>Menghapus…</span>';

              try {
                const response =
                  await fetch(
                    `${basePath}/api/admin/chords/${encodeURIComponent(id)}`,
                    {
                      method: 'DELETE',
                      credentials:
                        'same-origin',
                      headers: {
                        Accept:
                          'application/json',
                      },
                    }
                  );

                if (!response.ok) {
                  let message =
                    'Gagal menghapus chord.';

                  try {
                    const data =
                      await response.json();

                    if (
                      data &&
                      typeof data.message ===
                        'string' &&
                      data.message.trim()
                    ) {
                      message =
                        data.message;
                    }
                  } catch {
                    // Ignore non-JSON responses.
                  }

                  throw new Error(
                    message
                  );
                }

                const row =
                  button.closest<HTMLElement>(
                    '.admin-song'
                  );

                if (row) {
                  row.classList.add(
                    'is-deleting'
                  );
                }

                showStatus(
                  `"${title}" berhasil dihapus.`
                );

                window.setTimeout(
                  () => {
                    window.location.reload();
                  },
                  260
                );
              } catch (error) {
                console.error(
                  'Delete error:',
                  error
                );

                button.disabled =
                  false;

                button.innerHTML =
                  originalHTML;

                showStatus(
                  error instanceof Error
                    ? error.message
                    : 'Terjadi kesalahan saat menghapus chord.',
                  'error'
                );
              }
            }
          );
        }
      );

      /*
       * ======================================================
       * PAGE ENTER
       * ======================================================
       */

      requestAnimationFrame(
        () => {
          page.classList.add(
            'is-ready'
          );
        }
      );

      /*
       * Ensure initial search state
       * is always correct.
       */
      updateSearch();
    }
  );
</script>

<style is:global>
  /* =========================================================
     ROOT
  ========================================================== */

  .admin-page {
    --black: #090909;
    --ink: #171717;
    --muted: #737373;
    --soft: #a3a3a3;
    --line: #e3e3e3;
    --lighter: #f7f7f7;
    --white: #ffffff;

    width: 100%;
    max-width: 1050px;

    margin: 0 auto;

    padding:
      30px
      14px
      calc(
        58px +
        env(safe-area-inset-bottom)
      );

    color: var(--ink);

    -webkit-tap-highlight-color:
      transparent;
  }

  /* =========================================================
     HEADER
  ========================================================== */

  .admin-header {
    display: flex;
    flex-direction: column;

    align-items: stretch;

    gap: 24px;

    margin-bottom: 30px;
  }

  .admin-header-main {
    min-width: 0;
  }

  .admin-eyebrow {
    display: flex;
    align-items: center;

    gap: 9px;

    margin-bottom: 15px;

    color: var(--muted);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 0.17em;
  }

  .eyebrow-mark {
    flex: 0 0 auto;

    width: 19px;
    height: 1px;

    background: var(--black);
  }

  .admin-heading-row {
    display: block;
  }

  .admin-title-block {
    min-width: 0;
  }

  .admin-heading-row h1 {
    margin: 0;

    color: var(--black);

    font-size:
      clamp(
        2.7rem,
        14vw,
        4.6rem
      );

    line-height: 0.86;

    font-weight: 900;

    letter-spacing: -0.065em;
  }

  .admin-heading-row p {
    max-width: 360px;

    margin: 15px 0 0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }

  .library-stat {
    display: flex;
    flex-direction: column;

    align-items: flex-start;

    margin-top: 19px;
  }

  .library-stat span {
    margin-bottom: 3px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.14em;
  }

  .library-stat strong {
    color: var(--black);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 28px;

    line-height: 0.9;

    font-weight: 800;

    letter-spacing: -0.08em;
  }

  /* =========================================================
     ACTIONS
  ========================================================== */

  .admin-actions {
    display: grid;

    grid-template-columns:
      1fr
      1fr;

    gap: 6px;
  }

  .primary-action,
  .secondary-action {
    display: inline-flex;

    align-items: center;
    justify-content: center;

    gap: 7px;

    min-height: 39px;

    padding:
      0
      11px;

    text-decoration: none;

    font-size: 9px;

    font-weight: 750;

    touch-action:
      manipulation;

    transition:
      background 160ms ease,
      color 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .primary-action {
    border:
      1px
      solid
      var(--black);

    background: var(--black);

    color: white;
  }

  .primary-action:hover {
    background: white;

    color: var(--black);
  }

  .secondary-action {
    border:
      1px
      solid
      var(--line);

    background: white;

    color: var(--muted);
