    function cloneShape(shape: ChordShape): ChordShape {
      return {
        frets: [...shape.frets],
        fingers: [...shape.fingers],
        barres: shape.barres.map((barre: Barre) => ({
          ...barre,
        })),
      };
    }

    function normalizeRoot(value: string): string | null {
      const normalized = String(value || '')
        .trim()
        .replace('♯', '#')
        .replace('♭', 'b');

      const alias = ROOT_ALIASES[normalized] ?? normalized;

      if (NOTE_PC[alias] === undefined) {
        return null;
      }

      return NOTES_SHARP[NOTE_PC[alias]];
    }

    function normalizeQuality(raw: string): string {
      let q = String(raw || '')
        .trim()
        .replaceAll(' ', '')
        .replaceAll('(', '')
        .replaceAll(')', '')
        .replaceAll('Δ', 'maj7')
        .replaceAll('°', 'dim')
        .replaceAll('ø', 'm7b5')
        .replaceAll('−', 'm');

      q = QUALITY_ALIASES[q] ?? q;

      return Object.prototype.hasOwnProperty.call(
        QUALITIES,
        q,
      )
        ? q
        : q;
    }

    function parseChord(chord: string): ParsedChord | null {
      const clean = String(chord || '').trim();

      if (
        !clean ||
        clean === 'N.C.' ||
        clean === 'NC' ||
        clean === 'N/C'
      ) {
        return null;
      }

      const match = clean.match(
        /^([A-Ga-g](?:#|b|♯|♭)?)([^/]*?)(?:\/([A-Ga-g](?:#|b|♯|♭)?))?$/,
      );

      if (!match) {
        return null;
      }

      const root = normalizeRoot(match[1]);

      if (!root) {
        return null;
      }

      const quality = normalizeQuality(match[2]);
      const bass = match[3]
        ? normalizeRoot(match[3])
        : null;

      return {
        original: clean,
        root,
        rootPc: NOTE_PC[root],
        quality,
        bass,
        bassPc: bass === null
          ? null
          : NOTE_PC[bass],
      };
    }

    function chordDefinition(
      parsed: ParsedChord,
    ): ChordDefinition | null {
      return QUALITIES[parsed.quality] || null;
    }

    function shapeIsValid(
      frets: number[],
      parsed: ParsedChord,
      definition: ChordDefinition,
    ): boolean {
      if (!Array.isArray(frets) || frets.length !== 4) {
        return false;
      }

      const pitchClasses = frets.map(
        (fret: number, index: number) => {
          if (fret < 0) {
            return null;
          }

          return (
            TUNING_PC[index] + fret
          ) % 12;
        },
      );

      const sounding = pitchClasses.filter(
        (value): value is number => value !== null,
      );

      if (
        !sounding.length ||
        !sounding.includes(parsed.rootPc)
      ) {
        return false;
      }

      const allowed = new Set(
        definition.intervals.map(
          interval =>
            (parsed.rootPc + interval) % 12,
        ),
      );

      if (
        sounding.some(
          value => !allowed.has(value),
        )
      ) {
        return false;
      }

      const relative = new Set(
        sounding.map(
          value =>
            (value - parsed.rootPc + 12) % 12,
        ),
      );

      if (
        definition.required.some(
          interval => !relative.has(interval),
        )
      ) {
        return false;
      }

      if (parsed.bassPc !== null) {
        const soundingMidi = frets
          .map(
            (fret, index) =>
              fret < 0
                ? null
                : TUNING_MIDI[index] + fret,
          )
          .filter(
            (value): value is number =>
              value !== null,
          );

        if (!soundingMidi.length) {
          return false;
        }

        const lowestMidi = Math.min(
          ...soundingMidi,
        );

        if (
          lowestMidi % 12 !==
          parsed.bassPc
        ) {
          return false;
        }
      }

      const fretted = frets.filter(
        (fret: number) => fret > 0,
      );

      if (
        fretted.length &&
        Math.max(...fretted) -
          Math.min(...fretted) >
          4
      ) {
        return false;
      }

      return true;
    }

    function scoreShape(
      frets: number[],
      parsed: ParsedChord,
    ): number {
      const fretted = frets.filter(
        (fret: number) => fret > 0,
      );

      const maxFret = fretted.length
        ? Math.max(...fretted)
        : 0;

      const minFret = fretted.length
        ? Math.min(...fretted)
        : 0;

      const span = fretted.length
        ? maxFret - minFret
        : 0;

      const openCount = frets.filter(
        (fret: number) => fret === 0,
      ).length;

      const mutedCount = frets.filter(
        (fret: number) => fret < 0,
      ).length;

      const soundingMidi = frets
        .map(
          (fret, index) =>
            fret < 0
              ? null
              : TUNING_MIDI[index] + fret,
        )
        .filter(
          (value): value is number =>
            value !== null,
        );

      const lowestPc = soundingMidi.length
        ? Math.min(...soundingMidi) % 12
        : null;

      let score = 0;

      score += maxFret * 5;
      score += span * 9;
      score += mutedCount * 40;
      score -= openCount * 4;

      if (maxFret <= 4) {
        score -= 12;
      }

      if (
        parsed.bassPc === null &&
        lowestPc === parsed.rootPc
      ) {
        score -= 9;
      }

      if (
        parsed.bassPc !== null &&
        lowestPc === parsed.bassPc
      ) {
        score -= 24;
      }

      const groups = new Map<number, number[]>();

      frets.forEach(
        (fret: number, index: number) => {
          if (fret <= 0) {
            return;
          }

          const indexes = groups.get(fret);

          if (indexes) {
            indexes.push(index);
          } else {
            groups.set(fret, [index]);
          }
        },
      );

      for (const indexes of groups.values()) {
        if (indexes.length < 2) {
          continue;
        }

        const min = Math.min(...indexes);
        const max = Math.max(...indexes);

        if (
          max - min + 1 ===
          indexes.length
        ) {
          score -= 10;
        }
      }

      return score;
    }

    function buildFingerAssignment(
      frets: number[],
    ): Pick<
      ChordShape,
      'fingers' | 'barres'
    > {
      const fingers: number[] = [
        0,
        0,
        0,
        0,
      ];

      const barres: Barre[] = [];
      const groups = new Map<
        number,
        number[]
      >();

      frets.forEach(
        (fret: number, index: number) => {
          if (fret <= 0) {
            return;
          }

          const indexes = groups.get(fret);

          if (indexes) {
            indexes.push(index);
          } else {
            groups.set(fret, [index]);
          }
        },
      );

      const barreIndexes = new Set<number>();

      [...groups.entries()]
        .sort(
          (
            a: [number, number[]],
            b: [number, number[]],
          ) => a[0] - b[0],
        )
        .forEach(
          ([fret, indexes]) => {
            if (indexes.length < 2) {
              return;
            }

            const from = Math.min(
              ...indexes,
            );

            const to = Math.max(
              ...indexes,
            );

            if (
              to - from + 1 !==
              indexes.length
            ) {
              return;
            }

            barres.push({
              fret,
              from,
              to,
              finger: 1,
            });

            indexes.forEach(
              (index: number) => {
                fingers[index] = 1;
                barreIndexes.add(index);
              },
            );
          },
        );

      let nextFinger = 2;

      frets.forEach(
        (fret: number, index: number) => {
          if (
            fret <= 0 ||
            barreIndexes.has(index)
          ) {
            return;
          }

          fingers[index] = Math.min(
            nextFinger++,
            4,
          );
        },
      );

      return {
        fingers,
        barres,
      };
    }

    function generatedShape(
      parsed: ParsedChord,
    ): ChordShape | null {
      const cacheKey =
        `${parsed.root}${parsed.quality}/${parsed.bass || ''}`;

      if (GENERATED_SHAPE_CACHE.has(cacheKey)) {
        const cached =
          GENERATED_SHAPE_CACHE.get(cacheKey);

        return cached
          ? cloneShape(cached)
          : null;
      }

      const definition =
        chordDefinition(parsed);

      if (!definition) {
        return null;
      }

      const candidateFrets: number[] = [
        -1,
        0,
        1,
        2,
        3,
        4,
        5,
        6,
        7,
        8,
      ];

      let best: BestCandidate | null = null;

      const chosen: number[] = [
        -1,
        -1,
        -1,
        -1,
      ];

      const walk = (index: number): void => {
        if (index === 4) {
          if (
            !shapeIsValid(
              chosen,
              parsed,
              definition,
            )
          ) {
            return;
          }

          const score = scoreShape(
            chosen,
            parsed,
          );

          if (
            !best ||
            score < best.score
          ) {
            best = {
              score,
              frets: [...chosen],
            };
          }

          return;
        }

        for (const fret of candidateFrets) {
          chosen[index] = fret;
          walk(index + 1);
        }
      };

      walk(0);

      if (!best) {
        return null;
      }

      const candidate: BestCandidate =
        best;

      const {
        fingers,
        barres,
      } = buildFingerAssignment(
        candidate.frets,
      );

      const shape: ChordShape = {
        frets: [...candidate.frets],
        fingers,
        barres,
      };

      GENERATED_SHAPE_CACHE.set(
        cacheKey,
        cloneShape(shape),
      );

      return shape;
    }

    function getChordShape(
      chordName: string,
    ): ChordShape | null {
      const parsed =
        parseChord(chordName);

      if (!parsed) {
        return null;
      }

      const directKey =
        `${parsed.root}${parsed.quality}`;

      if (
        parsed.bassPc === null &&
        SHAPES[directKey]
      ) {
        return cloneShape(
          SHAPES[directKey],
        );
      }

      return generatedShape(parsed);
    }

    function noteAt(
      stringIndex: number,
      fret: number,
    ): string {
      if (fret < 0) {
        return '—';
      }

      return NOTES_SHARP[
        (TUNING_PC[stringIndex] + fret) %
          12
      ];
    }

    function patternOf(
      frets: number[],
    ): string {
      return frets
        .map(fret =>
          fret < 0
            ? 'X'
            : String(fret),
        )
        .join('');
    }

    function startingFret(
      frets: number[],
    ): number {
      const positive =
        frets.filter(
          (fret: number) =>
            fret > 0,
        );

      if (!positive.length) {
        return 1;
      }

      const min = Math.min(
        ...positive,
      );

      const max = Math.max(
        ...positive,
      );

      if (max <= 4) {
        return 1;
      }

      return min;
    }

    function escapeHtml(
      value: string,
    ): string {
      return String(value)
        .replaceAll(
          '&',
          '&amp;',
        )
        .replaceAll(
          '<',
          '&lt;',
        )
        .replaceAll(
          '>',
          '&gt;',
        )
        .replaceAll(
          '"',
          '&quot;',
        )
        .replaceAll(
          "'",
          '&#39;',
        );
    }

    const transposeNote = (
      note: string | null,
      amount: number,
      preferFlats = false,
    ): string | null => {
      const normalized =
        normalizeRoot(note || '');

      if (!normalized) {
        return note;
      }

      const pc =
        NOTE_PC[normalized];

      const index =
        (pc + amount + 1200) %
        12;

      return (
        preferFlats
          ? NOTES_FLAT
          : NOTES_SHARP
      )[index];
    };

    const transposeChord = (
      chord: string,
      amount: number,
      style: NotationStyle = 'auto',
    ): string => {
      const parsed =
        parseChord(chord);

      if (!parsed) {
        return chord;
      }

      const useFlats =
        style === 'flat'
          ? true
          : style === 'sharp'
            ? false
            : /[b♭]/.test(
                parsed.original.split('/')[0],
              );

      const rootName =
        transposeNote(
          parsed.root,
          amount,
          useFlats,
        );

      const bassName =
        parsed.bassPc === null
          ? null
          : transposeNote(
              parsed.bass,
              amount,
              useFlats,
            );

      const bass =
        bassName
          ? `/${bassName}`
          : '';

      return `${rootName ?? ''}${parsed.quality}${bass}`;
    };

    function renderChordSvg(
      chordName: string,
      shape: ChordShape,
    ): string {
      const width = 260;
      const height = 316;

      const x = [
        40,
        100,
        160,
        220,
      ];

      const top = 72;
      const gap = 47;
      const bottom =
        top + gap * 4;

      const markerY = 48;
      const radius = 14;

      const firstFret =
        startingFret(shape.frets);

      const fretY = (
        fret: number,
      ): number =>
        top +
        (fret - firstFret + 0.5) *
          gap;

      const strings = x
        .map(
          (
            sx: number,
            i: number,
          ) => `
        <line
          x1="${sx}"
          y1="${top}"
          x2="${sx}"
          y2="${bottom}"
          stroke="#5f645f"
          stroke-width="${[
            2.15,
            1.9,
            1.65,
            1.4,
          ][i]}"
          stroke-linecap="round"
        />
      `,
        )
        .join('');

      const frets =
        Array.from(
          { length: 5 },
          (
            _unknown: unknown,
            i: number,
          ) => {
            const y =
              top + i * gap;

            const isNut =
              firstFret === 1 &&
              i === 0;

            return `
              <line
                x1="40"
                y1="${y}"
                x2="220"
                y2="${y}"
                stroke="${
                  isNut
                    ? '#393d39'
                    : '#adb2ad'
                }"
                stroke-width="${
                  isNut
                    ? 5
                    : 1.55
                }"
                stroke-linecap="square"
              />
            `;
          },
        ).join('');

      const openMuted =
        shape.frets
          .map(
            (
              fret: number,
              i: number,
            ) => {
              if (fret === 0) {
                return `
                  <circle
                    cx="${x[i]}"
                    cy="${markerY}"
                    r="8"
                    fill="#fff"
                    stroke="#555a55"
                    stroke-width="1.35"
                  />
                `;
              }

              if (fret < 0) {
                return `
                  <line
                    x1="${x[i] - 5}"
                    y1="${markerY - 5}"
                    x2="${x[i] + 5}"
                    y2="${markerY + 5}"
                    stroke="#555a55"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />

                  <line
                    x1="${x[i] + 5}"
                    y1="${markerY - 5}"
                    x2="${x[i] - 5}"
                    y2="${markerY + 5}"
                    stroke="#555a55"
                    stroke-width="1.6"
                    stroke-linecap="round"
                  />
                `;
              }

              return '';
            },
          )
          .join('');

      const barreCovered = (
        index: number,
        fret: number,
        finger: number,
      ): boolean =>
        shape.barres.some(
          b =>
            b.fret === fret &&
            b.finger === finger &&
            index >= b.from &&
            index <= b.to,
        );

      const barres =
        shape.barres
          .map(
            (barre: Barre) => {
              if (
                barre.fret <
                  firstFret ||
                barre.fret >
                  firstFret + 3
              ) {
                return '';
              }

              const y =
                fretY(barre.fret);

              const x1 =
                x[barre.from] -
                radius;

              const x2 =
                x[barre.to] +
                radius;

              return `
                <rect
                  x="${x1}"
                  y="${y - radius}"
                  width="${x2 - x1}"
                  height="${radius * 2}"
                  rx="${radius}"
                  fill="#353a35"
                />

                <text
                  x="${(x1 + x2) / 2}"
                  y="${y + 4.5}"
                  text-anchor="middle"
                  fill="#fff"
                  font-family="Arial, Helvetica, sans-serif"
                  font-size="11"
                  font-weight="700"
                >
                  ${barre.finger}
                </text>
              `;
            },
          )
          .join('');

      const fingers =
        shape.frets
          .map(
            (
              fret: number,
              i: number,
            ) => {
              if (
                fret <= 0 ||
                fret < firstFret ||
                fret > firstFret + 3
              ) {
                return '';
              }

              const finger =
                shape.fingers[i];

              if (
                finger &&
                barreCovered(
                  i,
                  fret,
                  finger,
                )
              ) {
                return '';
              }

              const y =
                fretY(fret);

              return `
                <circle
                  cx="${x[i]}"
                  cy="${y}"
                  r="${radius}"
                  fill="#353a35"
                />

                <text
                  x="${x[i]}"
                  y="${y + 4.5}"
                  text-anchor="middle"
                  fill="#fff"
                  font-family="Arial, Helvetica, sans-serif"
                  font-size="11"
                  font-weight="700"
                >
                  ${finger || ''}
                </text>
              `;
            },
          )
          .join('');

      const notes =
        shape.frets
          .map(
            (
              fret: number,
              i: number,
            ) => `
              <text
                x="${x[i]}"
                y="${bottom + 26}"
                text-anchor="middle"
                fill="#747a74"
                font-family="Arial, Helvetica, sans-serif"
                font-size="9"
              >
                ${noteAt(i, fret)}
              </text>
            `,
          )
          .join('');

      return `
        <svg
          class="ukulele-chord-svg"
          viewBox="0 0 ${width} ${height}"
          role="img"
          aria-label="${escapeHtml(
            chordName,
          )} ukulele chord diagram"
        >
          ${
            firstFret > 1
              ? `
                <text
                  x="230"
                  y="66"
                  fill="#858a85"
                  font-family="Arial, Helvetica, sans-serif"
                  font-size="8"
                  font-weight="700"
                >
                  ${firstFret}fr
                </text>
              `
              : ''
          }

          ${openMuted}
          ${strings}
          ${frets}
          ${barres}
          ${fingers}
          ${notes}
        </svg>
      `;
    }

    function renderDialog(
      chordName: string,
    ): void {
      if (
        !(chordDialog instanceof HTMLDialogElement)
      ) {
        return;
      }

      stopScroll();

      const shape =
        getChordShape(chordName);

      if (
        dialogChordName instanceof HTMLElement
      ) {
        dialogChordName.textContent =
          chordName;
      }

      if (!shape) {
        if (
          dialogCaption instanceof HTMLElement
        ) {
          dialogCaption.textContent =
            'G C E A · unavailable';
        }

        if (
          dialogDiagram instanceof HTMLElement
        ) {
          dialogDiagram.innerHTML = `
            <div class="diagram-unavailable">
              <strong>${escapeHtml(
                chordName,
              )}</strong>
              <span>
                Ukulele voicing belum tersedia.
              </span>
            </div>
          `;
        }

        if (
          dialogGuide instanceof HTMLElement
        ) {
          dialogGuide.innerHTML = '';
        }
      } else {
        if (
          dialogCaption instanceof HTMLElement
        ) {
          dialogCaption.textContent =
            `G C E A · ${patternOf(
              shape.frets,
            )}`;
        }

        if (
          dialogDiagram instanceof HTMLElement
        ) {
          dialogDiagram.innerHTML =
            renderChordSvg(
              chordName,
              shape,
            );
        }

        if (
          dialogGuide instanceof HTMLElement
        ) {
          dialogGuide.innerHTML =
            STRING_NAMES.map(
              (
                name: string,
                i: number,
              ) => `
                <div class="dialog-string">
                  <span class="dialog-string-name">
                    ${name}
                  </span>

                  <span class="dialog-string-note">
                    ${noteAt(
                      i,
                      shape.frets[i],
                    )}
                  </span>
                </div>
              `,
            ).join('');
        }
      }

      chordDialog.showModal();
    }

    root
      .querySelectorAll('[data-chord]')
      .forEach(button => {
        if (
          !(button instanceof HTMLButtonElement)
        ) {
          return;
        }

        button.addEventListener(
          'click',
          () => {
            const chord =
              button.getAttribute(
                'data-chord',
              );

            if (chord) {
              renderDialog(chord);
            }
          },
        );
      });

    chordDialog?.addEventListener(
      'click',
      event => {
        if (
          event.target ===
            chordDialog &&
          chordDialog instanceof HTMLDialogElement
        ) {
          chordDialog.close();
        }
      },
    );

    chordDialogClose?.addEventListener(
      'click',
      () => {
        if (
          chordDialog instanceof HTMLDialogElement
        ) {
          chordDialog.close();
        }
      },
    );

    /* =========================================================
       PLAYER / AUTO-SCROLL

       - One requestAnimationFrame loop.
       - Floating scroll position prevents jitter.
       - Instant scroll while auto-scroll is active.
       - Wheel/swipe interrupts scrolling.
       - Mobile controls never count as scroll gestures.
       - No competing scroll timeout.
    ========================================================== */

    let isScrolling = false;
    let animationFrame: number | null = null;
    let lastTimestamp = 0;
    let scrollPosition = window.scrollY;
    let scrollBehaviorBeforeAuto: string | null = null;
    let transpose = 0;
    let fontScale = 1;
    let scrollSpeed = 1.00;
    let speedIndex = 3;

    const SPEEDS = [
      0.50,
      0.65,
      0.80,
      1.00,
      1.25,
      1.50,
      1.75,
      2.00,
      2.50,
      3.00,
      3.50,
      4.00,
    ];

    const FONT_MIN = 0.85;
    const FONT_MAX = 1.35;
    const FONT_STEP = 0.05;

    const TRANSPOSE_MIN = -12;
    const TRANSPOSE_MAX = 12;

    const getMaxScroll = (): number =>
      Math.max(
        0,
        document.documentElement.scrollHeight -
          window.innerHeight,
      );

    const setStatus = (
      active: boolean,
    ): void => {
      if (
        statusText instanceof HTMLElement
      ) {
        statusText.textContent =
          active
            ? 'SCROLLING'
            : 'READY';
      }

      if (
        statusDot instanceof HTMLElement
      ) {
        statusDot.classList.toggle(
          'is-active',
          active,
        );
      }
    };

    const setPlayIcons = (
      active: boolean,
    ): void => {
      [
        playIcon,
        mobilePlayIcon,
      ].forEach(icon => {
        if (
          icon instanceof SVGElement
        ) {
          icon.classList.toggle(
            'player-icon-hidden',
            active,
          );
        }
      });

      [
        pauseIcon,
        mobilePauseIcon,
      ].forEach(icon => {
        if (
          icon instanceof SVGElement
        ) {
          icon.classList.toggle(
            'player-icon-hidden',
            !active,
          );
        }
      });
    };

    const updateScrollButton = (): void => {
      const statusLabel =
        isScrolling
          ? 'SCROLLING'
          : 'READY';

      if (
        scrollLabel instanceof HTMLElement
      ) {
        scrollLabel.textContent =
          isScrolling
            ? 'Pause Scroll'
            : 'Auto Scroll';
      }

      if (
        scrollToggle instanceof HTMLButtonElement
      ) {
        scrollToggle.setAttribute(
          'aria-pressed',
          String(isScrolling),
        );

        scrollToggle.setAttribute(
          'aria-label',
          isScrolling
            ? 'Jeda auto scroll'
            : 'Mulai auto scroll',
        );
      }

      if (
        mobilePlay instanceof HTMLButtonElement
      ) {
        mobilePlay.setAttribute(
          'aria-label',
          isScrolling
            ? 'Jeda auto scroll'
            : 'Mulai auto scroll',
        );

        mobilePlay.setAttribute(
          'aria-pressed',
          String(isScrolling),
        );
      }

      if (
        mobilePlayer instanceof HTMLElement
      ) {
        mobilePlayer.classList.toggle(
          'is-active',
          isScrolling,
        );
      }

      if (
        mobileStatus instanceof HTMLElement
      ) {
        mobileStatus.textContent =
          statusLabel;
      }

      setPlayIcons(isScrolling);
      setStatus(isScrolling);
    };

    const updateProgress = (): void => {
      const max = getMaxScroll();

      const current = Math.min(
        max,
        Math.max(
          0,
          window.scrollY,
        ),
      );

      const percentage =
        max <= 0
          ? 0
          : Math.min(
              100,
              Math.max(
                0,
                (current / max) * 100,
              ),
            );

      if (
        progress instanceof HTMLElement
      ) {
        progress.style.width =
          `${percentage}%`;
      }

      if (
        progressText instanceof HTMLElement
      ) {
        progressText.textContent =
          `${Math.round(
            percentage,
          )}%`;
      }

      if (
        mobileProgress instanceof HTMLElement
      ) {
        mobileProgress.style.width =
          `${percentage}%`;
      }
    };

    const lockScrollBehavior = (): void => {
      if (
        scrollBehaviorBeforeAuto ===
        null
      ) {
        scrollBehaviorBeforeAuto =
          document.documentElement.style
            .scrollBehavior;

        document.documentElement.style
          .scrollBehavior = 'auto';
      }
    };

    const restoreScrollBehavior = (): void => {
      if (
        scrollBehaviorBeforeAuto !==
        null
      ) {
        document.documentElement.style
          .scrollBehavior =
          scrollBehaviorBeforeAuto;

        scrollBehaviorBeforeAuto =
          null;
      }
    };

    const stopScroll = (): void => {
      isScrolling = false;

      if (
        animationFrame !== null
      ) {
        cancelAnimationFrame(
          animationFrame,
        );

        animationFrame = null;
      }

      lastTimestamp = 0;
      scrollPosition =
        window.scrollY;

      restoreScrollBehavior();
      updateScrollButton();
    };

    const scrollFrame = (
      timestamp: number,
    ): void => {
      if (!isScrolling) {
        return;
      }

      if (!lastTimestamp) {
        lastTimestamp =
          timestamp;

        scrollPosition =
          window.scrollY;
      }

      const deltaMs = Math.min(
        100,
        Math.max(
          0,
          timestamp -
            lastTimestamp,
        ),
      );

      lastTimestamp =
        timestamp;

      const pixelsPerSecond =
        10 +
        scrollSpeed * 24;

      const maxScroll =
        getMaxScroll();

      if (maxScroll <= 0) {
        stopScroll();
        return;
      }

      scrollPosition =
        Math.min(
          maxScroll,
          scrollPosition +
            (pixelsPerSecond *
              deltaMs) /
              1000,
        );

      window.scrollTo(
        0,
        scrollPosition,
      );

      if (
        scrollPosition >=
        maxScroll - 0.5
      ) {
        window.scrollTo(
          0,
          maxScroll,
        );

        stopScroll();
        return;
      }

      animationFrame =
        requestAnimationFrame(
          scrollFrame,
        );
    };

    const startScroll = (): void => {
      const maxScroll =
        getMaxScroll();

      if (maxScroll <= 0) {
        updateProgress();
        return;
      }

      if (isScrolling) {
        return;
      }

      lockScrollBehavior();

      isScrolling = true;
      scrollPosition =
        window.scrollY;
      lastTimestamp = 0;

      updateScrollButton();

      animationFrame =
        requestAnimationFrame(
          scrollFrame,
        );
    };

    const toggleScroll = (): void => {
      if (isScrolling) {
        stopScroll();
      } else {
        startScroll();
      }
    };

    const updateSpeed = (): void => {
      const value =
        `${scrollSpeed.toFixed(2)}×`;

      if (
        speedValue instanceof HTMLElement
      ) {
        speedValue.textContent =
          value;
      }

      if (
        mobileSpeed instanceof HTMLElement
      ) {
        mobileSpeed.textContent =
          value;
      }

      if (
        mobileSpeedDown instanceof HTMLButtonElement
      ) {
        mobileSpeedDown.disabled =
          speedIndex <= 0;
      }

      if (
        mobileSpeedUp instanceof HTMLButtonElement
      ) {
        mobileSpeedUp.disabled =
          speedIndex >=
          SPEEDS.length - 1;
      }

      const desktopDown =
        root.querySelector(
          '[data-speed-down]',
        );

      const desktopUp =
        root.querySelector(
          '[data-speed-up]',
        );

      if (
        desktopDown instanceof HTMLButtonElement
      ) {
        desktopDown.disabled =
          speedIndex <= 0;
      }

      if (
        desktopUp instanceof HTMLButtonElement
      ) {
        desktopUp.disabled =
          speedIndex >=
          SPEEDS.length - 1;
      }
    };

    const increaseSpeed = (): void => {
      if (
        speedIndex >=
        SPEEDS.length - 1
      ) {
        return;
      }

      speedIndex += 1;
      scrollSpeed =
        SPEEDS[speedIndex];

      updateSpeed();
    };

    const decreaseSpeed = (): void => {
      if (speedIndex <= 0) {
        return;
      }

      speedIndex -= 1;
      scrollSpeed =
        SPEEDS[speedIndex];

      updateSpeed();
    };

    const updateFont = (): void => {
      root.style.setProperty(
        '--lyrics-scale',
        String(fontScale),
      );

      if (
        fontValue instanceof HTMLElement
      ) {
        fontValue.textContent =
          `${Math.round(
            fontScale * 100,
          )}%`;
      }
    };

    const increaseFont = (): void => {
      fontScale = Math.min(
        FONT_MAX,
        Number(
          (
            fontScale +
            FONT_STEP
          ).toFixed(2),
        ),
      );

      updateFont();
      requestAnimationFrame(
        updateProgress,
      );
    };

    const decreaseFont = (): void => {
      fontScale = Math.max(
        FONT_MIN,
        Number(
          (
            fontScale -
            FONT_STEP
          ).toFixed(2),
        ),
      );

      updateFont();
      requestAnimationFrame(
        updateProgress,
      );
    };

    const notationStyleForKey = (
      key: string,
    ): NotationStyle => {
      const source =
        String(key || '').trim();

      if (!source) {
        return 'auto';
      }

      const rootMatch =
        source.match(
          /^([A-Ga-g](?:#|b|♯|♭)?)/,
        );

      const sourceRoot =
        rootMatch
          ? rootMatch[1]
              .replace(
                '♯',
                '#',
              )
              .replace(
                '♭',
                'b',
              )
          : '';

      if (/[b♭]/.test(
        sourceRoot,
      )) {
        return 'flat';
      }

      if (/[#♯]/.test(
        sourceRoot,
      )) {
        return 'sharp';
      }

      if (
        sourceRoot.toUpperCase() ===
        'F'
      ) {
        return 'flat';
      }

      return 'auto';
    };

    const inferSongNotationStyle =
      (): NotationStyle => {
        const originalKey =
          root.getAttribute(
            'data-original-key',
          ) || '';

        const fromKey =
          notationStyleForKey(
            originalKey,
          );

        if (
          fromKey !== 'auto'
        ) {
          return fromKey;
        }

        const originalChords =
          Array.from(
            root.querySelectorAll(
              '[data-original-chord]',
            ),
          ).map(
            (item: Element) =>
              item.getAttribute(
                'data-original-chord',
              ) || '',
          );

        if (
          originalChords.some(
            chord =>
              /[b♭]/.test(chord),
          )
        ) {
          return 'flat';
        }

        if (
          originalChords.some(
            chord =>
              /[#♯]/.test(chord),
          )
        ) {
          return 'sharp';
        }

        return 'sharp';
      };

    const transposeStyle =
      inferSongNotationStyle();

    const updateTransposeButtons =
      (): void => {
        const down =
          root.querySelector(
            '[data-transpose-down]',
          );

        const up =
          root.querySelector(
            '[data-transpose-up]',
          );

        if (
          down instanceof HTMLButtonElement
        ) {
          down.disabled =
            transpose <=
            TRANSPOSE_MIN;
        }

        if (
          up instanceof HTMLButtonElement
        ) {
          up.disabled =
            transpose >=
            TRANSPOSE_MAX;
        }
      };

    const updateTranspose =
      (): void => {
        root
          .querySelectorAll(
            '[data-original-chord]',
          )
          .forEach(item => {
            if (
              !(item instanceof HTMLElement)
            ) {
              return;
            }

            const original =
              item.getAttribute(
                'data-original-chord',
              ) || '';

            const next =
              transposeChord(
                original,
                transpose,
                transposeStyle,
              );

            item.setAttribute(
              'data-chord',
              next,
            );

            const name =
              item.querySelector(
                '.chord-name',
              );

            if (
              name instanceof HTMLElement
            ) {
              name.textContent =
                next;
            }
          });

        const originalKey =
          root.getAttribute(
            'data-original-key',
          );

        if (
          originalKey &&
          currentKey instanceof HTMLElement
        ) {
          currentKey.textContent =
            transposeChord(
              originalKey,
              transpose,
              transposeStyle,
            );
        }

        if (
          transposeValue instanceof HTMLElement
        ) {
          transposeValue.textContent =
            transpose === 0
              ? '0'
              : transpose > 0
                ? `+${transpose}`
                : String(transpose);
        }

        updateTransposeButtons();
      };

    const changeTranspose = (
      amount: number,
    ): void => {
      transpose =
        Math.max(
          TRANSPOSE_MIN,
          Math.min(
            TRANSPOSE_MAX,
            transpose + amount,
          ),
        );

      updateTranspose();
    };

    const scrollToTop = (): void => {
      stopScroll();

      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    };

    if (
      focusToggle instanceof HTMLButtonElement
    ) {
      focusToggle.addEventListener(
        'click',
        () => {
          root.classList.toggle(
            'focus-mode',
          );
        },
      );
    }

    if (
      ukuleleToggle instanceof HTMLButtonElement
    ) {
      ukuleleToggle.addEventListener(
        'click',
        () => {
          const active =
            root.classList.toggle(
              'ukulele-mode',
            );

          ukuleleToggle.setAttribute(
            'aria-pressed',
            String(active),
          );
        },
      );
    }

    scrollToggle?.addEventListener(
      'click',
      toggleScroll,
    );

    mobilePlay?.addEventListener(
      'click',
      toggleScroll,
    );

    root
      .querySelector(
        '[data-speed-up]',
      )
      ?.addEventListener(
        'click',
        increaseSpeed,
      );

    root
      .querySelector(
        '[data-speed-down]',
      )
      ?.addEventListener(
        'click',
        decreaseSpeed,
      );

    mobileSpeedUp?.addEventListener(
      'click',
      increaseSpeed,
    );

    mobileSpeedDown?.addEventListener(
      'click',
      decreaseSpeed,
    );

    root
      .querySelector(
        '[data-scroll-top]',
      )
      ?.addEventListener(
        'click',
        scrollToTop,
      );

    root
      .querySelector(
        '[data-reset]',
      )
      ?.addEventListener(
        'click',
        () => {
          stopScroll();

          speedIndex = 3;
          scrollSpeed =
            SPEEDS[speedIndex];

          transpose = 0;
          fontScale = 1;

          root.classList.remove(
            'focus-mode',
            'ukulele-mode',
          );

          if (
            ukuleleToggle instanceof HTMLButtonElement
          ) {
            ukuleleToggle.setAttribute(
              'aria-pressed',
              'false',
            );
          }

          updateSpeed();
          updateFont();
          updateTranspose();
          scrollToTop();
        },
      );

    root
      .querySelector(
        '[data-transpose-up]',
      )
      ?.addEventListener(
        'click',
        () => {
          changeTranspose(1);
        },
      );

    root
      .querySelector(
        '[data-transpose-down]',
      )
      ?.addEventListener(
        'click',
        () => {
          changeTranspose(-1);
        },
      );

    root
      .querySelector(
        '[data-font-up]',
      )
      ?.addEventListener(
        'click',
        increaseFont,
      );

    root
      .querySelector(
        '[data-font-down]',
      )
      ?.addEventListener(
        'click',
        decreaseFont,
      );

    const shouldIgnoreUserScrollIntent = (
      event: Event,
    ): boolean => {
      const target =
        event.target;

      if (
        !(target instanceof Element)
      ) {
        return false;
      }

      return Boolean(
        target.closest(
          '[data-player]',
        ) ||
        target.closest(
          '[data-mobile-player]',
        ) ||
        target.closest(
          '.chord-dialog',
        ),
      );
    };

    let touchStartY: number | null =
      null;

    const handleWheelIntent = (
      event: WheelEvent,
    ): void => {
      if (
        !isScrolling ||
        shouldIgnoreUserScrollIntent(
          event,
        )
      ) {
        return;
      }

      if (
        Math.abs(event.deltaY) < 1
      ) {
        return;
      }

      stopScroll();
    };

    const handleTouchStart = (
      event: TouchEvent,
    ): void => {
      if (
        !isScrolling ||
        shouldIgnoreUserScrollIntent(
          event,
        )
      ) {
        touchStartY = null;
        return;
      }

      touchStartY =
        event.touches[0]
          ?.clientY ?? null;
    };

    const handleTouchMove = (
      event: TouchEvent,
    ): void => {
      if (
        !isScrolling ||
        touchStartY === null ||
        shouldIgnoreUserScrollIntent(
          event,
        )
      ) {
        return;
      }

      const currentY =
        event.touches[0]
          ?.clientY ??
        touchStartY;

      if (
        Math.abs(
          currentY -
            touchStartY,
        ) < 8
      ) {
        return;
      }

      touchStartY = null;
      stopScroll();
    };

    const handleTouchEnd =
      (): void => {
        touchStartY = null;
      };

    window.addEventListener(
      'wheel',
      handleWheelIntent,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'touchstart',
      handleTouchStart,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'touchmove',
      handleTouchMove,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'touchend',
      handleTouchEnd,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'scroll',
      updateProgress,
      {
        passive: true,
      },
    );

    window.addEventListener(
      'resize',
      updateProgress,
      {
        passive: true,
      },
    );

    document.addEventListener(
      'visibilitychange',
      () => {
        if (
          document.hidden &&
          isScrolling
        ) {
          stopScroll();
        }
      },
    );

    chordDialog?.addEventListener(
      'close',
      () => {
        updateProgress();
      },
    );

    window.addEventListener(
      'keydown',
      (event: KeyboardEvent) => {
        if (
          event.key === 'Escape' &&
          chordDialog instanceof HTMLDialogElement &&
          chordDialog.open
        ) {
          event.preventDefault();
          chordDialog.close();
          return;
        }

        const target =
          event.target;

        if (
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target instanceof HTMLButtonElement ||
          target instanceof HTMLSelectElement
        ) {
          return;
        }

        if (event.code === 'Space') {
          event.preventDefault();
          toggleScroll();
        } else if (
          event.key === 'ArrowDown'
        ) {
          event.preventDefault();
          stopScroll();

          window.scrollBy({
            top: 140,
            behavior: 'smooth',
          });
        } else if (
          event.key === 'ArrowUp'
        ) {
          event.preventDefault();
          stopScroll();

          window.scrollBy({
            top: -140,
            behavior: 'smooth',
          });
        } else if (
          event.key === '+'
        ) {
          increaseFont();
        } else if (
          event.key === '-'
        ) {
          decreaseFont();
        } else if (
          event.key === ']'
        ) {
          increaseSpeed();
        } else if (
          event.key === '['
        ) {
          decreaseSpeed();
        } else if (
          event.key.toLowerCase() === 't'
        ) {
          changeTranspose(
            event.shiftKey
              ? -1
              : 1,
          );
        } else if (
          event.key.toLowerCase() === 'r'
        ) {
          scrollToTop();
        } else if (
          event.key === 'Home'
        ) {
          event.preventDefault();
          scrollToTop();
        }
      },
    );

    updateScrollButton();
    updateSpeed();
    updateFont();
    updateTranspose();
    updateProgress();
  }
</script>

<style>
  .song-detail {
    --lyrics-scale: 1;
    --black: #0a0a0a;
    --ink: #151515;
    --muted: #6f6f6f;
    --soft: #969b96;
    --line: #e4e6e2;
    --surface: #f6f7f5;
    --white: #ffffff;
    --accent: #16834f;
    width: 100%;
    max-width: 980px;
    margin: 0 auto;
    padding:
      18px
      14px
      calc(132px + env(safe-area-inset-bottom));
    color: var(--ink);
    -webkit-font-smoothing: antialiased;
