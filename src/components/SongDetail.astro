      maj11: {
        label: 'Major 11th',
        intervals: [0, 2, 4, 5, 7, 11],
        required: [0, 4, 5, 11],
      },

      '13': {
        label: 'Thirteenth',
        intervals: [0, 2, 4, 7, 9, 10],
        required: [0, 4, 9, 10],
      },

      m13: {
        label: 'Minor 13th',
        intervals: [0, 2, 3, 7, 9, 10],
        required: [0, 3, 9, 10],
      },

      maj13: {
        label: 'Major 13th',
        intervals: [0, 2, 4, 7, 9, 11],
        required: [0, 4, 9, 11],
      },

      add9: {
        label: 'Add 9',
        intervals: [0, 2, 4, 7],
        required: [0, 2, 4, 7],
      },

      madd9: {
        label: 'Minor Add 9',
        intervals: [0, 2, 3, 7],
        required: [0, 2, 3, 7],
      },
    };

    const QUALITY_ALIASES: Record<string, string> = {
      major: '',
      maj: '',
      M: '',
      Major: '',
      minor: 'm',
      min: 'm',
      Minor: 'm',
      min7: 'm7',
      minor7: 'm7',
      major7: 'maj7',
      Major7: 'maj7',
      M7: 'maj7',
      major9: 'maj9',
