  .player-icon-hidden {
    display: none;
  }

  body:has(.chord-dialog[open]) {
    overflow: hidden;
  }

  button,
  a {
    -webkit-tap-highlight-color: transparent;
  }

  .song-header {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: start;
    gap: 14px;
    margin-bottom: 20px;
  }

  .song-heading {
    min-width: 0;
  }

  .song-eyebrow {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 9px;
    color: var(--soft);
    font: 800 7px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .16em;
  }

  .eyebrow-line {
    width: 16px;
    height: 1px;
    flex: 0 0 auto;
    background: var(--black);
  }

  .song-kicker {
    margin-bottom: 10px;
    color: var(--muted);
    font: 800 7px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .16em;
  }

  .song-header h1 {
    max-width: 100%;
    margin: 0;
    color: var(--black);
    font-size: clamp(2.35rem, 12vw, 4rem);
    font-weight: 900;
    line-height: .9;
    letter-spacing: -.065em;
    overflow-wrap: anywhere;
  }

  .song-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 9px;
    margin-top: 14px;
  }

  .artist {
    color: var(--muted);
    font-size: 13px;
    font-weight: 500;
  }

  .meta-separator {
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--soft);
  }

  .song-key {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font: 11px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }

  .song-key .key-label {
    color: var(--soft);
    font-size: 7px;
    font-weight: 800;
    letter-spacing: .14em;
  }

  .song-key strong {
    color: var(--black);
    font-weight: 850;
  }

  .focus-button {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--white);
    color: var(--muted);
    cursor: pointer;
  }

  .focus-button:hover,
  .focus-button:focus-visible {
    border-color: var(--black);
    color: var(--black);
  }

  .focus-button svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
  }

  .focus-button span {
    display: none;
  }

  .player-shell {
    display: none;
    position: sticky;
    top: 8px;
    z-index: 30;
    margin-bottom: 18px;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgba(255,255,255,.96);
    box-shadow: 0 8px 24px rgba(0,0,0,.06);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
  }

  .player-header {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 10px;
    padding: 9px 11px;
    border-bottom: 1px solid var(--line);
    font: 800 7px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .11em;
  }

  .player-state {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    color: var(--muted);
  }

  .status-dot {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #c7cac7;
    transition:
      background 160ms ease,
      box-shadow 160ms ease;
  }

  .status-dot.is-active {
    background: var(--accent);
    box-shadow: 0 0 0 4px rgba(22,131,79,.1);
  }

  .player-mode {
    display: none;
  }

  .player-progress-text {
    color: var(--soft);
    text-align: right;
  }

  .progress-track {
    height: 2px;
    background: #ededed;
  }

  .progress-fill {
    width: 0;
    height: 100%;
    background: var(--accent);
    transition: width 100ms linear;
  }

  .player-controls {
    display: grid;
    gap: 10px;
    padding: 10px;
  }

  .player-main-controls {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
  }

  .primary-control {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 38px;
    padding: 0 12px;
    border: 1px solid var(--black);
    border-radius: 10px;
    background: var(--black);
    color: var(--white);
    font-size: 10px;
    font-weight: 750;
    cursor: pointer;
  }

  .primary-control:active {
    transform: translateY(1px);
  }

  .primary-control svg {
    width: 12px;
    height: 12px;
    fill: currentColor;
  }

  .speed-control {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }

  .control-label {
    display: none;
  }

  .speed-button {
    display: grid;
    place-items: center;
    width: 31px;
    height: 31px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
    color: var(--black);
    font-size: 15px;
    cursor: pointer;
  }

  .speed-button:disabled,
  .mobile-speed-button:disabled {
    opacity: .32;
    cursor: not-allowed;
  }

  .speed-value {
    min-width: 42px;
    color: var(--black);
    font: 9px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    text-align: center;
  }

  .player-secondary-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px;
  }

  .text-button {
    min-height: 30px;
    padding: 6px 8px;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
    color: var(--muted);
    font-size: 9px;
    font-weight: 650;
    cursor: pointer;
  }

  .utility-bar {
    display: grid;
    gap: 12px;
    margin-bottom: 28px;
    padding: 12px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .utility-heading {
    display: flex;
    flex-direction: column;
    gap: 3px;
    min-width: 0;
  }

  .utility-title {
    color: var(--black);
    font: 850 8px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .13em;
  }

  .utility-subtitle {
    color: var(--soft);
    font-size: 8px;
  }

  .utility-controls {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
    align-items: center;
  }

  .utility-group {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    min-width: 0;
  }

  .utility-action {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    flex: 0 0 auto;
    border: 1px solid var(--line);
    border-radius: 9px;
    background: var(--white);
    color: var(--black);
    font-size: 14px;
    font-weight: 750;
    cursor: pointer;
  }

  .utility-action:disabled {
    opacity: .35;
    cursor: not-allowed;
    border-color: var(--line);
    background: var(--surface);
    color: var(--soft);
  }

  .utility-action-wide {
    width: 34px;
    font-size: 10px;
  }

  .utility-value {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 44px;
    gap: 2px;
  }

  .utility-value span {
    color: var(--soft);
    font: 800 6px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .09em;
    text-align: center;
  }

  .utility-value strong {
    color: var(--black);
    font: 10px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    line-height: 1;
    text-align: center;
  }

  .utility-divider {
    display: none;
  }

  .mode-toggle {
    grid-column: 1 / -1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 40px;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--white);
    color: var(--black);
    text-align: left;
    cursor: pointer;
  }

  .toggle-track {
    position: relative;
    width: 30px;
    height: 18px;
    flex: 0 0 auto;
    border: 1px solid #cdcdcd;
    border-radius: 999px;
    background: #f0f0f0;
  }

  .toggle-thumb {
    position: absolute;
    top: 2px;
    left: 2px;
    width: 12px;
    height: 12px;
    border: 1px solid #bbb;
    border-radius: 50%;
    background: var(--white);
    transition: transform 140ms ease;
  }

  .ukulele-mode .toggle-track {
    border-color: var(--accent);
    background: var(--accent);
  }

  .ukulele-mode .toggle-thumb {
    transform: translateX(12px);
    border-color: var(--white);
  }

  .toggle-copy strong {
    display: block;
    font-size: 9px;
    line-height: 1.15;
  }

  .toggle-copy small {
    display: block;
    margin-top: 2px;
    color: var(--soft);
    font-size: 8px;
  }

  .lyrics-container {
    width: 100%;
  }

  .lyrics-inner {
    width: 100%;
  }

  .song-row {
    position: relative;
    width: 100%;
    font-family: ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
    font-size: calc(.96rem * var(--lyrics-scale));
    line-height: 1.9;
  }

  .paired-row,
  .instrumental-row,
  .lyric-only-row {
    margin-bottom: 10px;
  }

  .chord-layer {
    position: relative;
    width: 100%;
    min-height: calc(1.5em * var(--lyrics-scale));
    line-height: 1;
    white-space: nowrap;
  }

  .instrumental-chord-layer {
    min-height: calc(1.75em * var(--lyrics-scale));
  }

  .lyric-layer {
    width: 100%;
    color: var(--ink);
    font: 500 1em/1.85 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
    white-space: pre-wrap;
    overflow-wrap: normal;
    word-break: normal;
  }

  .chord-button {
    position: absolute;
    top: 0;
    left: calc(var(--chord-position) * 1ch);
    z-index: 2;
    display: inline-flex;
    align-items: center;
    height: calc(1.42em * var(--lyrics-scale));
    margin: 0;
    padding: 0 1px;
    border: 0;
    background: transparent;
    color: var(--black);
    font: 900 calc(.76rem * var(--lyrics-scale))/1 ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,"Liberation Mono",monospace;
    letter-spacing: -.045em;
    cursor: pointer;
    white-space: nowrap;
    transform: translateY(-.08em);
  }

  .chord-button:hover,
  .chord-button:focus-visible {
    color: var(--accent);
  }

  .chord-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  .ukulele-mode .chord-button {
    font-size: calc(.9rem * var(--lyrics-scale));
    font-weight: 950;
  }

  .song-blank {
    height: calc(.8rem * var(--lyrics-scale));
  }

  .section-marker {
    display: grid;
    grid-template-columns: auto 12px auto minmax(0,1fr);
    align-items: center;
    gap: 6px;
    width: 100%;
    margin: 25px 0 13px;
  }

  .section-number {
    color: #c2c2c2;
    font: 850 6px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }

  .section-rule {
    width: 12px;
    height: 1px;
    background: var(--black);
  }

  .section-rule-grow {
    width: 100%;
    background: var(--line);
  }

  .section-name {
    min-width: 0;
    color: var(--black);
    font: 900 7px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .13em;
    text-transform: uppercase;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .chord-dialog {
    width: calc(100vw - 24px);
    max-width: 430px;
    max-height: min(88dvh, 720px);
    margin: auto;
    padding: 0;
    border: 0;
    border-radius: 18px;
    background: #fff;
    color: #171917;
    overflow: hidden;
    box-shadow:
      0 34px 90px rgba(0,0,0,.2),
      0 8px 24px rgba(0,0,0,.08);
  }

  .chord-dialog:not([open]) {
    display: none;
  }

  .chord-dialog::backdrop {
    background: rgba(12,14,12,.46);
    backdrop-filter: blur(5px);
    -webkit-backdrop-filter: blur(5px);
  }

  .dialog-inner {
    padding: 15px 14px 13px;
  }

  .dialog-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 14px;
  }

  .dialog-name {
    margin: 0;
    color: #111311;
    font-size: 30px;
    line-height: .95;
    font-weight: 900;
    letter-spacing: -.06em;
  }

  .dialog-caption {
    margin: 7px 0 0;
    color: #747974;
    font: 9px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .04em;
  }

  .dialog-close {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    padding: 0;
    border: 1px solid #d8dcd7;
    border-radius: 50%;
    background: #fff;
    color: #6a706a;
    font: 300 20px/1 Arial,Helvetica,sans-serif;
    cursor: pointer;
  }

  .dialog-close:focus-visible {
    outline: none;
    border-color: var(--accent);
    box-shadow:
      0 0 0 3px rgba(22,131,79,.1);
  }

  .dialog-diagram {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 270px;
    padding: 6px 0 3px;
    background:
      linear-gradient(
        to bottom,
        #fff 0%,
        #fbfbfb 100%
      );
  }

  .ukulele-chord-svg {
    display: block;
    width: 275px;
    max-width: 100%;
    height: auto;
    overflow: visible;
  }

  .dialog-guide {
    display: grid;
    grid-template-columns: repeat(4,minmax(0,1fr));
    gap: 6px;
    margin-top: 3px;
    padding-top: 10px;
    border-top: 1px solid #eceeeb;
  }

  .dialog-string {
    min-width: 0;
    text-align: center;
  }

  .dialog-string-name {
    display: block;
    color: #434843;
    font-size: 8px;
    line-height: 1;
    font-weight: 800;
  }

  .dialog-string-note {
    display: block;
    margin-top: 4px;
    color: #777d77;
    font-size: 8px;
    line-height: 1;
  }

  .diagram-unavailable {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 220px;
    text-align: center;
  }

  .diagram-unavailable strong {
    color: #171917;
    font: 900 14px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }

  .diagram-unavailable span {
    color: #878c87;
    font-size: 9px;
  }

  .mobile-player {
    position: fixed;
    right: 10px;
    bottom: calc(10px + env(safe-area-inset-bottom));
    left: 10px;
    z-index: 50;
    display: grid;
    gap: 8px;
    padding: 9px;
    border: 1px solid rgba(218,221,217,.96);
    border-radius: 16px;
    background: rgba(255,255,255,.94);
    box-shadow: 0 18px 48px rgba(0,0,0,.12);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .mobile-player.is-active {
    border-color: rgba(22,131,79,.28);
    box-shadow:
      0 18px 48px rgba(0,0,0,.12),
      0 0 0 1px rgba(22,131,79,.08);
  }

  .mobile-player-main {
    display: grid;
    grid-template-columns: auto minmax(0,1fr) auto;
    align-items: center;
    gap: 10px;
  }

  .mobile-play {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex: 0 0 auto;
    border: 1px solid var(--black);
    border-radius: 12px;
    background: var(--black);
    color: #fff;
    cursor: pointer;
  }

  .mobile-play svg {
    width: 13px;
    height: 13px;
    fill: currentColor;
  }

  .mobile-player-info {
    min-width: 0;
  }

  .mobile-player-info span {
    display: block;
    color: var(--soft);
    font: 800 7px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
    letter-spacing: .13em;
  }

  .mobile-player-info strong {
    display: block;
    margin-top: 3px;
    color: var(--black);
    font: 800 12px ui-monospace,SFMono-Regular,Menlo,Monaco,Consolas,monospace;
  }

  .mobile-speed-control {
    display: grid;
    grid-template-columns: repeat(2, 36px);
    gap: 5px;
  }

  .mobile-speed-button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: var(--white);
    color: var(--black);
    font-size: 16px;
    cursor: pointer;
  }

  .mobile-speed-button:active,
  .mobile-play:active {
    transform: translateY(1px);
  }

  .mobile-progress-track {
    width: 100%;
    height: 2px;
    overflow: hidden;
    border-radius: 999px;
    background: #eceeeb;
  }

  .mobile-progress-fill {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: var(--accent);
    transition: width 100ms linear;
  }

  .focus-mode .song-header,
  .focus-mode .utility-bar {
    opacity: .32;
  }

  .focus-mode .lyrics-container {
    max-width: 820px;
    margin-inline: auto;
  }

  .focus-mode .song-header:hover,
  .focus-mode .utility-bar:hover {
    opacity: 1;
  }

  .ukulele-mode .lyric-layer {
    font-size: 1.04em;
  }

  @media (min-width: 540px) {
    .song-detail {
      padding-inline: 20px;
    }

    .song-header h1 {
      font-size: clamp(2.6rem, 8vw, 4.4rem);
    }

    .utility-controls {
      display: flex;
      flex-wrap: wrap;
      justify-content: flex-start;
    }

    .utility-group {
      flex: 0 0 auto;
    }

    .utility-divider {
      display: block;
      width: 1px;
      height: 24px;
      background: var(--line);
    }

    .mode-toggle {
      grid-column: auto;
      margin-left: auto;
    }

    .section-marker {
      grid-template-columns:
        auto
        16px
        auto
        minmax(0,1fr);
      gap: 8px;
    }

    .section-rule {
      width: 16px;
    }

    .section-name {
      font-size: 8px;
    }
  }

  @media (min-width: 761px) {
