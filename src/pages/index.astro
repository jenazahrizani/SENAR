---
export const prerender = false;

import Layout from '../components/Layout.astro';
import SongCard from '../components/SongCard.astro';
import { adminDb } from '../lib/firebase-admin';
import { generateSlug } from '../lib/chordParser';

interface Chord {
  id: string;
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const normalizeSearchValue = (value: string): string => {
  return value
    .toLowerCase()
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .trim();
};

const snapshot = await adminDb
  .collection('chords')
  .orderBy('title', 'asc')
  .get();

const chords = snapshot.docs.map((doc) => {
  const data = doc.data();

  const title =
    typeof data.title === 'string' && data.title.trim()
      ? data.title.trim()
      : 'Untitled';

  const artist =
    typeof data.artist === 'string' && data.artist.trim()
      ? data.artist.trim()
      : 'Unknown artist';

  const key =
    typeof data.key === 'string' && data.key.trim()
      ? data.key.trim()
      : undefined;

  const content =
    typeof data.content === 'string'
      ? data.content
      : '';

  return {
    id: doc.id,
    title,
    artist,
    key,
    content,
    slug: generateSlug(title),
  };
}) as Array<Chord & { slug: string }>;

const songCount = chords.length;
const songCountLabel = String(songCount).padStart(2, '0');
---

<Layout title="SENAR — Chord Ukulele">
  <main class="home-page">

    <!-- ======================================================
         HERO
    ======================================================= -->

    <section class="hero-section" aria-labelledby="page-title">
      <div class="hero-topline">
        <div class="hero-eyebrow">
          <span class="eyebrow-mark" aria-hidden="true"></span>
          <span>UKULELE CHORD LIBRARY</span>
        </div>

        <span class="hero-version" aria-label="Version 01">
          SENAR / 01
        </span>
      </div>

      <div class="hero-content">
        <div class="hero-copy">
          <h1 id="page-title">SENAR</h1>

          <p>
            Chord ukulele yang sederhana,
            cepat ditemukan, dan nyaman dimainkan.
          </p>
        </div>

        <div class="hero-index" aria-label={`${songCount} lagu`}>
          <span class="index-label">LIBRARY</span>

          <strong aria-hidden="true">
            {songCountLabel}
          </strong>

          <span class="index-caption">
            SONGS
          </span>
        </div>
      </div>

      <div class="hero-rule" aria-hidden="true"></div>
    </section>

    <!-- ======================================================
         SEARCH
    ======================================================= -->

    <section
      class="search-section"
      aria-label="Cari lagu"
    >
      <div class="search-box">
        <div class="search-icon" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            role="img"
          >
            <circle
              cx="11"
              cy="11"
              r="6.5"
            ></circle>

            <path d="m16 16 5 5"></path>
          </svg>
        </div>

        <input
          id="song-search"
          type="search"
          placeholder="Cari lagu atau artis..."
          autocomplete="off"
          autocapitalize="none"
          spellcheck="false"
          enterkeyhint="search"
          aria-label="Cari lagu atau artis"
          aria-controls="songList"
          aria-describedby="searchStatus"
        />

        <div class="search-meta">
          <kbd aria-hidden="true">/</kbd>

          <button
            type="button"
            class="clear-search"
            id="clearSearch"
            aria-label="Hapus pencarian"
            title="Hapus pencarian"
            hidden
          >
            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path d="M6 6l12 12"></path>
              <path d="M18 6 6 18"></path>
            </svg>
          </button>
        </div>
      </div>

      <div
        class="search-status"
        id="searchStatus"
        aria-live="polite"
        aria-atomic="true"
      >
        <span id="resultCount">
          {songCount} lagu
        </span>

        <span
          class="search-status-separator"
          aria-hidden="true"
        ></span>

        <span>
          UKULELE / ALL KEYS
        </span>
      </div>
    </section>

    <!-- ======================================================
         LIBRARY
    ======================================================= -->

    <section
      class="library-section"
      aria-labelledby="library-title"
    >
      <div class="library-heading">
        <div class="library-heading-main">
          <span class="section-kicker">
            YOUR LIBRARY
          </span>

          <div class="library-title-row">
            <h2 id="library-title">
              Semua lagu
            </h2>

            <span
              class="library-live-dot"
              aria-hidden="true"
            ></span>
          </div>
        </div>

        <div
          class="library-line"
          aria-hidden="true"
        ></div>

        <span class="library-count">
          {songCountLabel}
        </span>
      </div>

      {songCount === 0 && (
        <div class="empty-library">
          <div
            class="empty-symbol"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24">
              <path
                d="M8 3v13.5a3.5 3.5 0 1 0 2 3.15V7h8V5H8z"
              ></path>
            </svg>
          </div>

          <span class="empty-label">
            LIBRARY EMPTY
          </span>

          <h3>Belum ada chord</h3>

          <p>
            Library masih kosong.
            Login sebagai admin untuk
            menambahkan lagu pertama.
          </p>
        </div>
      )}

      {songCount > 0 && (
        <div
          class="song-list"
          id="songList"
          aria-live="polite"
        >
          {chords.map((chord, index) => (
            <div
              class="song-card-wrapper"
              data-song
              data-title={normalizeSearchValue(chord.title)}
              data-artist={normalizeSearchValue(chord.artist)}
              style={`--card-index: ${index}`}
            >
              <SongCard
                id={chord.id}
                title={chord.title}
                artist={chord.artist}
                key={chord.key}
                slug={chord.slug}
                index={index}
              />
            </div>
          ))}
        </div>
      )}

      {songCount > 0 && (
        <div
          class="search-empty"
          id="searchEmpty"
          hidden
          role="status"
          aria-live="polite"
        >
          <div
            class="empty-search-icon"
            aria-hidden="true"
          >
            <svg viewBox="0 0 24 24">
              <circle
                cx="11"
                cy="11"
                r="6.5"
              ></circle>

              <path d="m16 16 5 5"></path>
            </svg>
          </div>

          <span class="empty-label">
            NO MATCH
          </span>

          <h3>Tidak ditemukan</h3>

          <p>
            Tidak ada lagu atau artis yang cocok
            dengan pencarianmu.
          </p>

          <button
            type="button"
            id="resetSearch"
          >
            Tampilkan semua lagu
          </button>
        </div>
      )}
    </section>

    <!-- ======================================================
         FOOTER
    ======================================================= -->

    <footer class="home-footer">
      <div
        class="footer-rule"
        aria-hidden="true"
      ></div>

      <div class="footer-content">
        <span>SENAR</span>
        <span>CHORD UKULELE</span>
        <span>{new Date().getFullYear()}</span>
      </div>
    </footer>

  </main>
</Layout>

<script>
  const root = document.querySelector<HTMLElement>('.home-page');
  const searchInput =
    document.querySelector<HTMLInputElement>('#song-search');
  const clearButton =
    document.querySelector<HTMLButtonElement>('#clearSearch');
  const resetButton =
    document.querySelector<HTMLButtonElement>('#resetSearch');
  const resultCount =
    document.querySelector<HTMLElement>('#resultCount');
  const searchEmpty =
    document.querySelector<HTMLElement>('#searchEmpty');

  const normalize = (value: string): string => {
    return value
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .trim();
  };

  const songs = Array.from(
    document.querySelectorAll<HTMLElement>('[data-song]')
  ).map((element) => ({
    element,
    title: element.dataset.title || '',
    artist: element.dataset.artist || '',
  }));

  const setSearchValue = (value: string, focus = false) => {
    if (!searchInput) {
      return;
    }

    searchInput.value = value;
    updateSearch();

    if (focus) {
      requestAnimationFrame(() => {
        searchInput.focus();
        searchInput.setSelectionRange(
          searchInput.value.length,
          searchInput.value.length
        );
      });
    }
  };

  const updateSearch = () => {
    if (!searchInput) {
      return;
    }

    const query = normalize(searchInput.value);

    let visible = 0;

    for (const song of songs) {
      const matches =
        query.length === 0 ||
        song.title.includes(query) ||
        song.artist.includes(query);

      song.element.hidden = !matches;

      if (matches) {
        visible += 1;
      }
    }

    if (resultCount) {
      resultCount.textContent =
        `${visible} lagu`;
    }

    if (clearButton) {
      clearButton.hidden =
        query.length === 0;
    }

    if (searchEmpty) {
      searchEmpty.hidden =
        query.length === 0 ||
        visible !== 0;
    }

    if (root) {
      root.classList.toggle(
        'is-searching',
        query.length > 0
      );
    }
  };

  if (searchInput) {
    searchInput.addEventListener(
      'input',
      updateSearch
    );
  }

  if (clearButton) {
    clearButton.addEventListener(
      'click',
      () => {
        setSearchValue('', true);
      }
    );
  }

  if (resetButton) {
    resetButton.addEventListener(
      'click',
      () => {
        setSearchValue('', true);
      }
    );
  }

  document.addEventListener(
    'keydown',
    (event) => {
      const target = event.target;

      const isTypingTarget =
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement ||
        target instanceof HTMLSelectElement ||
        (target instanceof HTMLElement &&
          target.isContentEditable);

      /*
       * ESC:
       * Clear search when user is inside the search input.
       */
      if (
        event.key === 'Escape' &&
        target === searchInput &&
        searchInput
      ) {
        event.preventDefault();

        if (searchInput.value !== '') {
          setSearchValue('');
        } else {
          searchInput.blur();
        }

        return;
      }

      if (isTypingTarget) {
        return;
      }

      /*
       * / opens search.
       */
      if (
        event.key === '/' &&
        searchInput
      ) {
        event.preventDefault();
        searchInput.focus();
        return;
      }

      /*
       * CMD/CTRL + K also opens search.
       */
      if (
        event.key.toLowerCase() === 'k' &&
        (event.metaKey || event.ctrlKey) &&
        searchInput
      ) {
        event.preventDefault();
        searchInput.focus();
      }
    }
  );

  /*
   * Progressive enhancement only.
   * Cards remain visible before JavaScript is ready.
   */
  if (root) {
    root.classList.add('is-ready');

    requestAnimationFrame(() => {
      root.classList.add('is-animated');
    });
  }
</script>

<style is:global>
  /* =========================================================
     ROOT
  ========================================================== */

  .home-page {
    --black: #090909;
    --ink: #171717;
    --muted: #737373;
    --soft: #a3a3a3;
    --line: #e4e4e4;
    --surface: #fafafa;
    --white: #ffffff;

    width: 100%;
    max-width: 960px;

    margin: 0 auto;

    padding:
      28px
      14px
      calc(56px + env(safe-area-inset-bottom));

    color: var(--ink);

    -webkit-tap-highlight-color: transparent;
  }

  /* =========================================================
     HERO
  ========================================================== */

  .hero-section {
    margin-bottom: 34px;
  }

  .hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 14px;
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;

    min-width: 0;

    gap: 9px;

    color: var(--muted);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 8px;
    font-weight: 800;

    letter-spacing: 0.16em;

    white-space: nowrap;
  }

  .eyebrow-mark {
    flex: 0 0 auto;

    width: 18px;
    height: 1px;

    background: var(--black);
  }

  .hero-version {
    flex: 0 0 auto;

    color: #c0c0c0;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.12em;

    white-space: nowrap;
  }

  .hero-content {
    display: block;

    margin-top: 17px;
  }

  .hero-copy {
    min-width: 0;
  }

  .hero-copy h1 {
    margin: 0;

    color: var(--black);

    font-size:
      clamp(
        3.9rem,
        21vw,
        6rem
      );

    line-height: 0.79;

    font-weight: 900;

    letter-spacing: -0.09em;
  }

  .hero-copy p {
    max-width: 340px;

    margin: 19px 0 0;

    color: var(--muted);

    font-size: 13px;
    line-height: 1.7;
  }

  .hero-index {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    margin-top: 23px;
  }

  .index-label {
    margin-bottom: 3px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.14em;
  }

  .hero-index strong {
    color: var(--black);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 30px;
    line-height: 0.9;
    font-weight: 850;

    letter-spacing: -0.08em;
  }

  .index-caption {
    margin-top: 5px;

    color: #bdbdbd;

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 6px;
    font-weight: 800;

    letter-spacing: 0.1em;
  }

  .hero-rule {
    width: 100%;
    height: 1px;

    margin-top: 26px;

    background: var(--line);
  }

  /* =========================================================
     SEARCH
  ========================================================== */

  .search-section {
    position: sticky;
    top: 0;
    z-index: 25;

    margin:
      0
      -1px
      34px;

    padding:
      8px
      1px
      10px;

    background:
      rgba(
        255,
        255,
        255,
        0.94
      );

    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
  }

  .search-box {
    display: flex;
    align-items: center;

    min-width: 0;
    height: 54px;

    border: 1px solid #d7d7d7;

    background: var(--white);

    transition:
      border-color 160ms ease,
      box-shadow 160ms ease;
  }

  .search-box:hover {
    border-color: #bdbdbd;
  }

  .search-box:focus-within {
    border-color: var(--black);

    box-shadow:
      0 0 0 1px var(--black);
  }

  .search-icon {
    display: grid;
    place-items: center;

    flex: 0 0 auto;

    width: 47px;
    height: 100%;
  }

  .search-icon svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke: var(--black);
    stroke-width: 1.7;

    stroke-linecap: round;
  }

  .search-box input {
    min-width: 0;

    flex: 1;

    width: 100%;
    height: 100%;

    border: 0;
    outline: 0;

    padding: 0;

    background: transparent;
    color: var(--black);

    font:
      inherit;

    font-size: 16px;
    font-weight: 500;

    -webkit-appearance: none;
    appearance: none;
  }

  .search-box input::placeholder {
    color: #a4a4a4;
  }

  .search-box input::-webkit-search-cancel-button {
    display: none;
  }

  .search-meta {
    display: flex;
    align-items: center;

    flex: 0 0 auto;

    gap: 6px;

    padding-right: 6px;
  }

  .search-meta kbd {
    display: none;
  }

  .clear-search {
    display: grid;
    place-items: center;

    width: 40px;
    height: 40px;

    border: 0;

    padding: 0;

    background: transparent;
    color: var(--muted);

    cursor: pointer;

    touch-action: manipulation;

    transition:
      color 150ms ease,
      background 150ms ease;
  }

  .clear-search:hover {
    color: var(--black);
  }

  .clear-search:focus-visible,
  .search-empty button:focus-visible {
    outline:
      2px solid
      var(--black);

    outline-offset: 2px;
  }

  .clear-search svg {
    width: 15px;
    height: 15px;

    fill: none;

    stroke: currentColor;
    stroke-width: 1.8;

    stroke-linecap: round;
  }

  .search-status {
    display: flex;
    align-items: center;

    gap: 9px;

    min-height: 16px;

    margin-top: 7px;
    padding-inline: 2px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 700;

    letter-spacing: 0.08em;
  }

  .search-status span:first-child {
    color: var(--black);
  }

  .search-status-separator {
    flex: 0 0 auto;

    width: 3px;
    height: 3px;

    border-radius: 50%;

    background: #cfcfcf;
  }

  /* =========================================================
     LIBRARY
  ========================================================== */

  .library-section {
    min-height: 320px;
  }

  .library-heading {
    display: flex;
    align-items: flex-end;

    gap: 9px;

    margin-bottom: 15px;
  }

  .library-heading-main {
    flex: 0 0 auto;
  }

  .section-kicker {
    display: block;

    margin-bottom: 7px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.15em;
  }

  .library-title-row {
    display: flex;
    align-items: center;

    gap: 8px;
  }

  .library-heading h2 {
    margin: 0;

    color: var(--black);

    font-size: 22px;
    line-height: 1;

    font-weight: 850;

    letter-spacing: -0.045em;
  }

  .library-live-dot {
    flex: 0 0 auto;

    width: 5px;
    height: 5px;

    border-radius: 50%;

    background: var(--black);
  }

  .library-line {
    flex: 1;

    width: 100%;
    height: 1px;

    margin-bottom: 5px;

    background: var(--line);
  }

  .library-count {
    flex: 0 0 auto;

    margin-bottom: 1px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 9px;
    font-weight: 800;
  }

  /* =========================================================
     SONG LIST
  ========================================================== */

  .song-list {
    display: flex;
    flex-direction: column;

    gap: 7px;
  }

  .song-card-wrapper {
    opacity: 1;
    transform: none;
  }

  .song-card-wrapper[hidden] {
    display: none;
  }

  .is-animated .song-card-wrapper {
    animation:
      homeCardEnter
      420ms
      cubic-bezier(
        0.22,
        1,
        0.36,
        1
      )
      both;

    animation-delay:
      calc(
        var(--card-index) *
        35ms
      );
  }

  @keyframes homeCardEnter {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* =========================================================
     EMPTY SEARCH
  ========================================================== */

  .search-empty {
    padding:
      64px
      18px;

    border:
      1px
      dashed
      #d8d8d8;

    background: #fcfcfc;

    text-align: center;
  }

  .search-empty[hidden] {
    display: none;
  }

  .empty-search-icon {
    display: grid;
    place-items: center;

    width: 42px;
    height: 42px;

    margin:
      0
      auto
      15px;

    border: 1px solid var(--line);

    background: white;
  }

  .empty-search-icon svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke: var(--black);

    stroke-width: 1.5;

    stroke-linecap: round;
  }

  .empty-label {
    display: block;

    margin-bottom: 7px;

    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;
    font-weight: 800;

    letter-spacing: 0.15em;
  }

  .search-empty h3,
  .empty-library h3 {
    margin: 0;

    color: var(--black);

    font-size: 18px;
    font-weight: 850;

    letter-spacing: -0.03em;
  }

  .search-empty p,
  .empty-library p {
    max-width: 340px;

    margin:
      8px
      auto
      20px;

    color: var(--muted);

    font-size: 11px;
    line-height: 1.7;
  }

  .search-empty button {
    min-height: 40px;

    padding:
      0
      15px;

    border: 1px solid var(--black);

    background: var(--black);
    color: white;

    font-size: 9px;
    font-weight: 750;

    cursor: pointer;

    touch-action: manipulation;

    transition:
      background 150ms ease,
      color 150ms ease;
  }

  .search-empty button:hover {
    background: white;
    color: var(--black);
  }

  /* =========================================================
     EMPTY LIBRARY
  ========================================================== */

  .empty-library {
    padding:
      74px
      18px;

    border:
      1px
      dashed
      #d8d8d8;

    background: #fcfcfc;

    text-align: center;
  }

  .empty-symbol {
    display: grid;
    place-items: center;

    width: 44px;
    height: 44px;

    margin:
      0
      auto
      16px;

    border: 1px solid var(--line);

    background: white;
  }

  .empty-symbol svg {
    width: 17px;
    height: 17px;

    fill: none;

    stroke: var(--black);

    stroke-width: 1.5;

    stroke-linejoin: round;
  }

  .empty-library p {
    margin-bottom: 0;
