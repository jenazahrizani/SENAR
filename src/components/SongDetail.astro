      halfdiminished: 'm7b5',
      'half-diminished': 'm7b5',
      sus: 'sus4',
      '2': 'sus2',
      '4': 'sus4',
    };

    const GENERATED_SHAPE_CACHE = new Map<string, ChordShape>();

    const SHAPES: Record<string, ChordShape> = {
      C: {
        frets: [0, 0, 0, 3],
        fingers: [0, 0, 0, 3],
        barres: [],
