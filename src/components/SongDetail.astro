---
import { parseSongContent } from '../lib/chordParser';

export interface Props {
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const { title, artist, key, content } = Astro.props;
const parsedSong = parseSongContent(content);
---

<section
  class="song-detail"
  data-song-detail
  data-original-key={key || ''}
>
  <header class="song-header">
    <div class="song-heading">
      <div class="song-eyebrow">
        <span class="eyebrow-line"></span>
        <span>SENAR / CHORD</span>
      </div>

      <div class="song-kicker">CHORD &amp; LYRICS</div>
      <h1>{title}</h1>

      <div class="song-meta">
        <span class="artist">{artist}</span>

        {key && (
          <>
            <span class="meta-separator"></span>

            <span class="song-key">
              <span class="key-label">KEY</span>
              <strong data-current-key>{key}</strong>
            </span>
          </>
        )}
      </div>
    </div>

    <button
      type="button"
      class="focus-button"
      data-focus-toggle
      aria-label="Aktifkan mode fokus"
      title="Focus mode"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M8 3H5a2 2 0 0 0-2 2v3" />
        <path d="M16 3h3a2 2 0 0 1 2 2v3" />
        <path d="M21 16v3a2 2 0 0 1-2 2h-3" />
        <path d="M3 16v3a2 2 0 0 0 2 2h3" />
      </svg>
      <span>Focus</span>
    </button>
  </header>

  <section class="player-shell" data-player aria-label="Song player">
    <div class="player-header">
      <div class="player-state">
        <span class="status-dot" data-status-dot></span>
        <span data-status-text>READY</span>
      </div>

      <span class="player-mode">PLAYER MODE</span>

      <span class="player-progress-text" data-progress-text>0%</span>
    </div>

    <div class="progress-track" aria-hidden="true">
      <div class="progress-fill" data-progress></div>
    </div>

    <div class="player-controls">
      <div class="player-main-controls">
        <button
          type="button"
          class="primary-control"
          data-scroll-toggle
          aria-label="Mulai auto scroll"
          aria-pressed="false"
        >
          <span class="control-icon">
            <svg viewBox="0 0 24 24" aria-hidden="true" data-play-icon>
              <path d="M8 5v14l11-7z" />
            </svg>

            <svg
              viewBox="0 0 24 24"
              aria-hidden="true"
              data-pause-icon
              class="player-icon-hidden"
            >
              <path d="M7 5h3v14H7z" />
              <path d="M14 5h3v14h-3z" />
            </svg>
          </span>

          <span data-scroll-label>Auto Scroll</span>
        </button>

        <div class="speed-control">
          <span class="control-label">SPEED</span>

          <button
            type="button"
            class="speed-button"
            data-speed-down
            aria-label="Kurangi kecepatan"
          >
            −
          </button>

          <strong class="speed-value" data-speed-value>1.00×</strong>

          <button
            type="button"
            class="speed-button"
            data-speed-up
            aria-label="Tambah kecepatan"
          >
            +
          </button>
        </div>
      </div>

      <div class="player-secondary-controls">
        <button type="button" class="text-button" data-reset>
          Reset
        </button>

        <button type="button" class="text-button" data-scroll-top>
          Atas
        </button>
      </div>
    </div>
  </section>

  <section class="utility-bar">
    <div class="utility-heading">
      <span class="utility-title">PLAYER TOOLS</span>
      <span class="utility-subtitle">optimized for ukulele · GCEA</span>
    </div>

    <div class="utility-controls">
      <div class="utility-group">
        <button
          type="button"
          class="utility-action"
          data-transpose-down
          aria-label="Turunkan satu semitone"
        >
          −
        </button>

        <div class="utility-value">
          <span>TRANSPOSE</span>
          <strong data-transpose-value>0</strong>
        </div>

        <button
          type="button"
          class="utility-action"
          data-transpose-up
          aria-label="Naikkan satu semitone"
        >
          +
        </button>
      </div>

      <span class="utility-divider"></span>

      <div class="utility-group">
        <button
          type="button"
          class="utility-action utility-action-wide"
          data-font-down
          aria-label="Perkecil teks"
        >
          A−
        </button>

        <div class="utility-value">
          <span>TEXT</span>
          <strong data-font-value>100%</strong>
        </div>

        <button
          type="button"
          class="utility-action utility-action-wide"
          data-font-up
          aria-label="Perbesar teks"
        >
          A+
        </button>
      </div>

      <span class="utility-divider"></span>

      <button
        type="button"
        class="mode-toggle"
        data-ukulele-toggle
        aria-pressed="false"
      >
        <span class="toggle-track">
          <span class="toggle-thumb"></span>
        </span>

        <span class="toggle-copy">
          <strong>Ukulele Mode</strong>
          <small>Enlarge chord</small>
        </span>
      </button>
    </div>
  </section>

  <article class="lyrics-container" data-lyrics>
    <div class="lyrics-inner">
      {
        parsedSong.map((block, blockIndex) => {
          if (block.type === 'blank') {
            return (
              <div
                class="song-blank"
                aria-hidden="true"
                style={`--line-index:${blockIndex}`}
              ></div>
            );
          }

          if (block.type === 'section') {
            const sectionName = block.value
              .replace(/^\[/, '')
              .replace(/\]$/, '')
              .trim();

            return (
              <div
                class="section-marker"
                style={`--line-index:${blockIndex}`}
              >
                <span class="section-number">
                  {String(blockIndex + 1).padStart(2, '0')}
                </span>

                <span class="section-rule"></span>

                <span class="section-name">
                  {sectionName}
                </span>

                <span class="section-rule section-rule-grow"></span>
              </div>
            );
          }

          if (block.type === 'line') {
            return (
              <div
                class="song-row paired-row"
                style={`--line-index:${blockIndex}`}
              >
                <div class="chord-layer" aria-label="Chords">
                  {block.chords.map((chord) => (
                    <button
                      type="button"
                      class="chord-button"
                      data-chord={chord.value}
                      data-original-chord={chord.value}
                      style={`--chord-position:${chord.position}`}
                      title={`Lihat chord ${chord.value}`}
                      aria-label={`Lihat diagram chord ${chord.value}`}
                    >
                      <span class="chord-name">
                        {chord.value}
                      </span>
                    </button>
                  ))}
                </div>

                <div class="lyric-layer" data-lyric-line>
                  {block.lyric}
                </div>
              </div>
            );
          }

          if (block.type === 'instrumental') {
            return (
              <div
                class="song-row instrumental-row"
                style={`--line-index:${blockIndex}`}
              >
                <div class="chord-layer instrumental-chord-layer">
                  {block.chords.map((chord) => (
                    <button
                      type="button"
                      class="chord-button"
                      data-chord={chord.value}
                      data-original-chord={chord.value}
                      style={`--chord-position:${chord.position}`}
                      title={`Lihat chord ${chord.value}`}
                      aria-label={`Lihat diagram chord ${chord.value}`}
                    >
                      <span class="chord-name">
                        {chord.value}
                      </span>
                    </button>
                  ))}
                </div>
              </div>
            );
          }

          if (block.type === 'lyric') {
            return (
              <div
                class="song-row lyric-only-row"
                style={`--line-index:${blockIndex}`}
              >
                <div class="lyric-layer" data-lyric-line>
                  {block.lyric}
                </div>
              </div>
            );
          }

          return null;
        })
      }
    </div>
  </article>

  <dialog
    id="chordDialog"
    class="chord-dialog"
    aria-labelledby="dialogChordName"
  >
    <div class="dialog-inner">
      <div class="dialog-top">
        <div>
          <h2 id="dialogChordName" class="dialog-name">C</h2>

          <p id="dialogCaption" class="dialog-caption">
            G C E A · 0003
          </p>
        </div>

        <form method="dialog">
          <button
            type="submit"
            class="dialog-close"
            aria-label="Close chord"
          >
            ×
          </button>
        </form>
      </div>

      <div id="dialogDiagram" class="dialog-diagram"></div>

      <div
        id="dialogGuide"
        class="dialog-guide"
        aria-label="Strings and notes"
      ></div>
    </div>
  </dialog>

  <div
    class="mobile-player"
    data-mobile-player
    aria-label="Auto scroll controls"
  >
    <div class="mobile-player-main">
      <button
        type="button"
        class="mobile-play"
        data-mobile-play
        aria-label="Mulai auto scroll"
        aria-pressed="false"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          data-mobile-play-icon
        >
          <path d="M8 5v14l11-7z" />
        </svg>

        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          data-mobile-pause-icon
          class="player-icon-hidden"
        >
          <path d="M7 5h3v14H7z" />
          <path d="M14 5h3v14h-3z" />
        </svg>
      </button>

      <div class="mobile-player-info">
        <span data-mobile-status>READY</span>
        <strong data-mobile-speed>1.00×</strong>
      </div>

      <div
        class="mobile-speed-control"
        role="group"
        aria-label="Kecepatan auto scroll"
      >
        <button
          type="button"
          class="mobile-speed-button"
          data-mobile-speed-down
          aria-label="Kurangi kecepatan scroll"
        >
          −
        </button>

        <button
          type="button"
          class="mobile-speed-button"
          data-mobile-speed-up
          aria-label="Tambah kecepatan scroll"
        >
          +
        </button>
      </div>
    </div>

    <div class="mobile-progress-track" aria-hidden="true">
      <span
        class="mobile-progress-fill"
        data-mobile-progress
      ></span>
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-song-detail]');

  if (root instanceof HTMLElement) {
    type NotationStyle = 'auto' | 'flat' | 'sharp';

    type Barre = {
      fret: number;
      from: number;
      to: number;
      finger: number;
    };

    type ChordShape = {
      frets: number[];
      fingers: number[];
      barres: Barre[];
    };

    type ChordDefinition = {
      label: string;
      intervals: number[];
      required: number[];
    };

    type ParsedChord = {
      original: string;
      root: string;
      rootPc: number;
      quality: string;
      bass: string | null;
      bassPc: number | null;
    };

    type BestCandidate = {
      score: number;
      frets: number[];
    };

    const lyrics = root.querySelector('[data-lyrics]');
    const progress = root.querySelector('[data-progress]');
    const progressText = root.querySelector('[data-progress-text]');
    const statusText = root.querySelector('[data-status-text]');
    const statusDot = root.querySelector('[data-status-dot]');
    const scrollToggle = root.querySelector('[data-scroll-toggle]');
    const scrollLabel = root.querySelector('[data-scroll-label]');
    const playIcon = root.querySelector('[data-play-icon]');
    const pauseIcon = root.querySelector('[data-pause-icon]');
    const mobilePlayIcon = root.querySelector('[data-mobile-play-icon]');
    const mobilePauseIcon = root.querySelector('[data-mobile-pause-icon]');
    const speedValue = root.querySelector('[data-speed-value]');
    const mobileSpeed = root.querySelector('[data-mobile-speed]');
    const mobilePlay = root.querySelector('[data-mobile-play]');
    const mobilePlayer = root.querySelector('[data-mobile-player]');
    const mobileStatus = root.querySelector('[data-mobile-status]');
    const mobileProgress = root.querySelector('[data-mobile-progress]');
    const mobileSpeedDown = root.querySelector('[data-mobile-speed-down]');
    const mobileSpeedUp = root.querySelector('[data-mobile-speed-up]');
    const transposeValue = root.querySelector('[data-transpose-value]');
    const fontValue = root.querySelector('[data-font-value]');
    const currentKey = root.querySelector('[data-current-key]');
    const focusToggle = root.querySelector('[data-focus-toggle]');
    const ukuleleToggle = root.querySelector('[data-ukulele-toggle]');

    const chordDialog = root.querySelector('#chordDialog');
    const dialogChordName = root.querySelector('#dialogChordName');
    const dialogCaption = root.querySelector('#dialogCaption');
    const dialogDiagram = root.querySelector('#dialogDiagram');
    const dialogGuide = root.querySelector('#dialogGuide');
    const chordDialogClose = root.querySelector('.dialog-close');

    /* =========================================================
       CHORD ENGINE
       Standard high-G GCEA.

       Goals:
       - Never show a mathematically-valid but musically-wrong voicing.
       - Prefer familiar low-position shapes for common chords.
       - Validate every generated shape against the exact chord formula.
       - Respect slash-chord bass notes.
       - Cache generated shapes so repeated dialogs are instant.
    ========================================================== */

    const NOTES_SHARP: string[] = [
      'C',
      'C#',
      'D',
      'D#',
      'E',
      'F',
      'F#',
      'G',
      'G#',
      'A',
      'A#',
      'B',
    ];

    const NOTES_FLAT: string[] = [
      'C',
      'Db',
      'D',
      'Eb',
      'E',
      'F',
      'Gb',
      'G',
      'Ab',
      'A',
      'Bb',
      'B',
    ];

    const TUNING_PC: number[] = [7, 0, 4, 9];
    const TUNING_MIDI: number[] = [67, 60, 64, 69];
    const STRING_NAMES: string[] = ['G', 'C', 'E', 'A'];

    const NOTE_PC: Record<string, number> = {
      C: 0,
      'C#': 1,
      Db: 1,
      D: 2,
      'D#': 3,
      Eb: 3,
      E: 4,
      F: 5,
      'F#': 6,
      Gb: 6,
      G: 7,
      'G#': 8,
      Ab: 8,
      A: 9,
      'A#': 10,
      Bb: 10,
      B: 11,
    };

    const ROOT_ALIASES: Record<string, string> = {
      Cb: 'B',
      'B#': 'C',
      Db: 'C#',
      Eb: 'D#',
      Fb: 'E',
      Gb: 'F#',
      Ab: 'G#',
      Bb: 'A#',
    };

    const QUALITIES: Record<string, ChordDefinition> = {
      '': {
        label: 'Major',
        intervals: [0, 4, 7],
        required: [0, 4, 7],
      },

      m: {
        label: 'Minor',
