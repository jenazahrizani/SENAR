---
export const prerender = false;

import Layout from '../../components/Layout.astro';
const base = import.meta.env.BASE_URL || '';
---

<Layout title="Tambah Chord — SENAR">
  <main class="editor-page">

    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="editor-header">

      <div class="editor-heading">

        <a
          href={`${base}/admin`}
          class="back-link"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>

          <span>Library</span>
        </a>

        <div class="editor-eyebrow">
          <span class="eyebrow-line"></span>
          <span>SENAR / NEW ENTRY</span>
        </div>

        <h1>Tambah chord</h1>

        <p>
          Buat entri lagu baru untuk library chord
          ukulele SENAR.
        </p>

      </div>

      <div class="editor-top-actions">

        <span
          class="save-status"
          data-save-status
        >
          NEW
        </span>

        <a
          href={`${base}/admin`}
          class="preview-link"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M19 12H5"></path>
            <path d="m11 18-6-6 6-6"></path>
          </svg>

          <span>Kembali</span>
        </a>

      </div>

    </header>

    <!-- =========================================================
         MAIN EDITOR
    ========================================================== -->

    <div class="editor-layout">

      <!-- =======================================================
           LEFT / FORM
      ======================================================== -->

      <section class="editor-main">

        <form
          id="createForm"
          class="create-form"
        >

          <!-- =====================================================
               SONG INFORMATION
          ====================================================== -->

          <div class="editor-section">

            <div class="section-heading">

              <div>
                <span class="section-index">
                  01
                </span>

                <div>
                  <span class="section-kicker">
                    SONG INFORMATION
                  </span>

                  <h2>
                    Informasi lagu
                  </h2>
                </div>
              </div>

            </div>

            <div class="metadata-grid">

              <label class="field field-title">

                <span class="field-label">
                  Judul lagu
                  <b>*</b>
                </span>

                <input
                  type="text"
                  id="title"
                  required
                  autocomplete="off"
                  class="field-input field-input-large"
                  placeholder="Contoh: Rasa Cinta Ini"
                  data-field
                />

              </label>

              <label class="field">

                <span class="field-label">
                  Artis
                  <b>*</b>
                </span>

                <input
                  type="text"
                  id="artist"
                  required
                  autocomplete="off"
                  class="field-input"
                  placeholder="Nama artis"
                  data-field
                />

              </label>

              <label class="field field-key">

                <span class="field-label">
                  Kunci
                  <small>opsional</small>
                </span>

                <input
                  type="text"
                  id="key"
                  autocomplete="off"
                  class="field-input key-input"
                  placeholder="C"
                  maxlength="8"
                  data-field
                />

              </label>

            </div>

          </div>

          <!-- =====================================================
               CHORD EDITOR
          ====================================================== -->

          <div class="editor-section chord-editor-section">

            <div class="section-heading editor-section-heading">

              <div>
                <span class="section-index">
                  02
                </span>

                <div>
                  <span class="section-kicker">
                    CHORD CONTENT
                  </span>

                  <h2>
                    Chord & lirik
                  </h2>
                </div>
              </div>

              <div class="content-stats">

                <div>
                  <span>LINES</span>
                  <strong data-line-count>
                    0
                  </strong>
                </div>

                <div>
                  <span>CHARS</span>
                  <strong data-char-count>
                    0
                  </strong>
                </div>

              </div>

            </div>

            <!-- FORMAT BAR -->

            <div class="editor-toolbar">

              <div class="toolbar-group">

                <span class="toolbar-label">
                  FORMAT
                </span>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Intro]"
                >
                  Intro
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Verse 1]"
                >
                  Verse
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Chorus]"
                >
                  Chorus
                </button>

                <button
                  type="button"
                  class="toolbar-button"
                  data-insert="[Bridge]"
                >
                  Bridge
                </button>

              </div>

              <div class="toolbar-hint">

                <span>
                  [C]Rasa [G]cinta
                </span>

                <span>
                  ·
                </span>

                <span>
                  TAB = indent
                </span>

              </div>

            </div>

            <!-- EDITOR -->

            <div class="editor-wrapper">

              <div
                class="line-numbers"
                data-line-numbers
                aria-hidden="true"
              >
                <span>1</span>
              </div>

              <textarea
                id="content"
                rows="24"
                required
                spellcheck="false"
                autocomplete="off"
                data-content-editor
                class="content-editor"
                placeholder="[Intro]

[C] [G] [Am] [F]

[Verse 1]
[C]Rasa [G]cinta ini
[Am]tak pernah [F]hilang

[Chorus]
[C]...
[G]..."
              ></textarea>

            </div>

            <div class="editor-footer">

              <span>
                Plain text chord format
              </span>

              <span>
                Ukulele · GCEA
              </span>

            </div>

          </div>

          <!-- =====================================================
               ACTIONS
          ====================================================== -->

          <div class="form-actions">

            <button
              type="button"
              id="cancelBtn"
              class="cancel-button"
            >
              Batal
            </button>

            <button
              type="button"
              id="previewBtn"
              class="preview-button"
            >
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                <circle cx="12" cy="12" r="2.5"></circle>
              </svg>

              <span>Preview</span>
            </button>

            <button
              type="submit"
              id="saveBtn"
              class="save-button"
            >
              <span data-save-label>
                Simpan chord
              </span>

              <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M5 12h13"></path>
                <path d="m13 6 6 6-6 6"></path>
              </svg>
            </button>

          </div>

        </form>

      </section>

      <!-- =======================================================
           RIGHT / LIVE PREVIEW
      ======================================================== -->

      <aside class="preview-panel">

        <div class="preview-panel-header">

          <div>
            <span class="section-kicker">
              LIVE PREVIEW
            </span>

            <h2>
              Song preview
            </h2>
          </div>

          <span class="preview-state">
            LIVE
          </span>

        </div>

        <div
          id="previewArea"
          class="song-preview"
        >

          <header class="preview-song-header">

            <span class="preview-eyebrow">
              CHORD & LYRICS
            </span>

            <h3 data-preview-title>
              Untitled song
            </h3>

            <div class="preview-meta">

              <span data-preview-artist>
                Unknown artist
              </span>

              <span
                class="preview-key-wrap"
                data-preview-key-wrap
                hidden
              >
                <span class="preview-dot"></span>

                <span>
                  KEY
                  <strong data-preview-key>
                  </strong>
                </span>
              </span>

            </div>

          </header>

          <div
            class="preview-content"
            data-preview-content
          >
            <div class="preview-placeholder">
              Mulai mengetik chord dan lirik
              untuk melihat preview.
            </div>
          </div>

        </div>

        <div class="preview-footer">

          <span>
            Preview tidak menyimpan perubahan
          </span>

          <span>
            LIVE
          </span>

        </div>

      </aside>

    </div>

    <!-- =========================================================
         FOOTER
    ========================================================== -->

    <footer class="editor-bottom">

      <div>
        <span class="danger-label">
          NEW RECORD
        </span>

        <code>
          AUTO-ID
        </code>
      </div>

      <span>
        Chord baru akan ditambahkan
        ke library SENAR.
      </span>

    </footer>

  </main>
</Layout>

<script>
  import { parseChordContent } from '../../lib/chordParser';

  const basePath =
    window.location.pathname
      .split('/')
      .slice(0, 2)
      .join('/') || '';

  const form =
    document.getElementById('createForm');

  const saveBtn =
    document.getElementById('saveBtn');

  const saveLabel =
    document.querySelector('[data-save-label]');

  const saveStatus =
    document.querySelector('[data-save-status]');

  const cancelBtn =
    document.getElementById('cancelBtn');

  const previewBtn =
    document.getElementById('previewBtn');

  const titleInput =
    document.getElementById('title');

  const artistInput =
    document.getElementById('artist');

  const keyInput =
    document.getElementById('key');

  const contentInput =
    document.getElementById('content');

  const lineCount =
    document.querySelector('[data-line-count]');

  const charCount =
    document.querySelector('[data-char-count]');

  const lineNumbers =
    document.querySelector('[data-line-numbers]');

  const previewTitle =
    document.querySelector('[data-preview-title]');

  const previewArtist =
    document.querySelector('[data-preview-artist]');

  const previewKey =
    document.querySelector('[data-preview-key]');

  const previewKeyWrap =
    document.querySelector('[data-preview-key-wrap]');

  const previewContent =
    document.querySelector('[data-preview-content]');

  if (
    form &&
    titleInput &&
    artistInput &&
    keyInput &&
    contentInput
  ) {

    let isDirty = false;

    /*
     * =========================================================
     * ESCAPE HTML
     * =========================================================
     */

    const escapeHTML = (value) => {
      const element =
        document.createElement('div');

      element.textContent = value;

      return element.innerHTML;
    };

    /*
     * =========================================================
     * STATS
     * =========================================================
     */

    const updateStats = () => {
      const content =
        contentInput.value;

      const lines =
        content.length === 0
          ? 0
          : content.split('\n').length;

      if (lineCount) {
        lineCount.textContent =
          String(lines);
      }

      if (charCount) {
        charCount.textContent =
          String(content.length);
      }
    };

    /*
     * =========================================================
     * LINE NUMBERS
     * =========================================================
     */

    const updateLineNumbers = () => {
      if (!lineNumbers) return;

      const lines =
        contentInput.value.split('\n');

      lineNumbers.innerHTML =
        lines
          .map((_, index) => {
            return `<span>${index + 1}</span>`;
          })
          .join('');
    };

    /*
     * =========================================================
     * PREVIEW METADATA
     * =========================================================
     */

    const updatePreviewMetadata = () => {

      const title =
        titleInput.value.trim();

      const artist =
        artistInput.value.trim();

      const key =
        keyInput.value.trim();

      if (previewTitle) {
        previewTitle.textContent =
          title || 'Untitled song';
      }

      if (previewArtist) {
        previewArtist.textContent =
          artist || 'Unknown artist';
      }

      if (previewKey) {
        previewKey.textContent =
          key;
      }

      if (previewKeyWrap) {
        previewKeyWrap.hidden =
          key.length === 0;
      }
    };

    /*
     * =========================================================
     * LIVE PREVIEW
     * =========================================================
     */

    const renderPreview = () => {
      if (!previewContent) return;

      const content =
        contentInput.value;

      if (!content.trim()) {
        previewContent.innerHTML = `
          <div class="preview-placeholder">
            Mulai mengetik chord dan lirik
            untuk melihat preview.
          </div>
        `;

        return;
      }

      const parsed =
        parseChordContent(content);

      previewContent.innerHTML =
        parsed
          .map((line, index) => {

            if (line.length === 0) {
              return `
                <div class="preview-empty-line"></div>
              `;
            }

            const parts =
              line
                .map((part) => {

                  if (
                    part.type === 'section'
                  ) {
                    return `
                      <div class="preview-section">
                        <span class="preview-section-line"></span>

                        <span>
                          ${escapeHTML(
                            String(part.value)
                          )}
                        </span>
                      </div>
                    `;
                  }

                  if (
                    part.type === 'chord'
                  ) {
                    return `
                      <span class="preview-chord">
                        ${escapeHTML(
                          String(part.value)
                        )}
                      </span>
                    `;
                  }

                  return `
                    <span class="preview-lyric">
                      ${escapeHTML(
                        String(part.value)
                      )}
                    </span>
                  `;
                })
                .join('');

            return `
              <div
                class="preview-line"
                style="--preview-index:${index}"
              >
                ${parts}
              </div>
            `;
          })
          .join('');
    };

    const updatePreview = () => {
      updatePreviewMetadata();
      renderPreview();
      updateStats();
      updateLineNumbers();
    };

    /*
     * =========================================================
     * DIRTY STATE
     * =========================================================
     */

    const checkDirtyState = () => {

      const dirty =
        titleInput.value.trim().length > 0 ||
        artistInput.value.trim().length > 0 ||
        keyInput.value.trim().length > 0 ||
        contentInput.value.trim().length > 0;

      isDirty = dirty;

      if (saveStatus) {
        saveStatus.textContent =
          dirty
            ? 'DRAFT'
            : 'NEW';

        saveStatus.classList.toggle(
          'is-draft',
          dirty
        );
      }
    };

    /*
     * =========================================================
     * INPUT EVENTS
     * =========================================================
     */

    [
      titleInput,
      artistInput,
      keyInput,
      contentInput,
    ].forEach((input) => {

      input.addEventListener(
        'input',
        () => {
          updatePreview();
          checkDirtyState();
        }
      );
    });

    /*
     * =========================================================
     * CONTENT SCROLL
     * =========================================================
     */

    contentInput.addEventListener(
      'scroll',
      () => {

        if (!lineNumbers) {
          return;
        }

        lineNumbers.scrollTop =
          contentInput.scrollTop;
      }
    );

    /*
     * =========================================================
     * TAB SUPPORT
     * =========================================================
     */

    contentInput.addEventListener(
      'keydown',
      (event) => {

        if (event.key !== 'Tab') {
          return;
        }

        event.preventDefault();

        const start =
          contentInput.selectionStart;

        const end =
          contentInput.selectionEnd;

        const before =
          contentInput.value.slice(
            0,
            start
          );

        const after =
          contentInput.value.slice(
            end
          );

        contentInput.value =
          `${before}  ${after}`;

        contentInput.selectionStart =
          start + 2;

        contentInput.selectionEnd =
          start + 2;

        updatePreview();
        checkDirtyState();
      }
    );

    /*
     * =========================================================
     * FORMAT INSERT
     * =========================================================
     */

    document
      .querySelectorAll('[data-insert]')
      .forEach((button) => {

        button.addEventListener(
          'click',
          () => {

            const value =
              button.dataset.insert || '';

            const start =
              contentInput.selectionStart;

            const end =
              contentInput.selectionEnd;

            const text =
              contentInput.value;

            const before =
              text.slice(
                0,
                start
              );

            const after =
              text.slice(end);

            const needsNewLine =
              before.length > 0 &&
              !before.endsWith('\n');

            const insertion =
              `${needsNewLine ? '\n' : ''}${value}\n`;

            contentInput.value =
              `${before}${insertion}${after}`;

            const cursor =
              start + insertion.length;

            contentInput.selectionStart =
              cursor;

            contentInput.selectionEnd =
              cursor;

            contentInput.focus();

            updatePreview();
            checkDirtyState();
          }
        );
      });

    /*
     * =========================================================
     * PREVIEW BUTTON
     * =========================================================
     */

    if (previewBtn) {

      previewBtn.addEventListener(
        'click',
        () => {

          updatePreview();

          const panel =
            document.querySelector(
              '.preview-panel'
            );

          if (panel) {
            panel.scrollIntoView({
              behavior: 'smooth',
              block: 'start',
            });
          }
        }
      );
    }

    /*
     * =========================================================
     * CANCEL
     * =========================================================
     */

    if (cancelBtn) {

      cancelBtn.addEventListener(
        'click',
        () => {

          if (isDirty) {

            const confirmed =
              window.confirm(
                'Data yang sudah kamu masukkan akan hilang. Kembali ke library?'
              );

            if (!confirmed) {
              return;
            }
          }

          window.location.href =
            `${basePath}/admin`;
        }
      );
    }

    /*
     * =========================================================
     * SAVE
     * =========================================================
     */

    form.addEventListener(
      'submit',
      async (event) => {

        event.preventDefault();

        const title =
          titleInput.value.trim();

        const artist =
          artistInput.value.trim();

        const key =
          keyInput.value.trim();

        const content =
          contentInput.value.trim();

        if (!title) {
          alert(
            'Judul lagu harus diisi.'
          );

          titleInput.focus();

          return;
        }

        if (!artist) {
          alert(
            'Artis harus diisi.'
          );

          artistInput.focus();

          return;
        }

        if (!content) {
          alert(
            'Isi chord harus diisi.'
          );

          contentInput.focus();

          return;
        }

        if (saveBtn) {
          saveBtn.disabled = true;
        }

        if (saveLabel) {
          saveLabel.textContent =
            'Menyimpan...';
        }

        if (saveStatus) {
          saveStatus.textContent =
            'SAVING...';

          saveStatus.classList.remove(
            'is-draft'
          );
        }

        try {

          const response =
            await fetch(
              `${basePath}/api/admin/chords`,
              {
                method: 'POST',

                headers: {
                  'Content-Type':
                    'application/json',
                },

                body: JSON.stringify({
                  title,
                  artist,
                  key,
                  content,
                }),
              }
            );

          if (!response.ok) {

            let message =
              'Gagal menyimpan chord.';

            try {

              const data =
                await response.json();

              if (
                data &&
                typeof data.error ===
                  'string'
              ) {
                message =
                  data.error;
              }

            } catch {
              // Response bukan JSON.
            }

            throw new Error(message);
          }

          if (saveLabel) {
            saveLabel.textContent =
              'Saved';
          }

          if (saveStatus) {
            saveStatus.textContent =
              'SAVED';
          }

          isDirty = false;

          setTimeout(() => {
            window.location.href =
              `${basePath}/admin`;
          }, 350);

        } catch (error) {

          console.error(
            'Create chord error:',
            error
          );

          if (saveLabel) {
            saveLabel.textContent =
              'Simpan chord';
          }

          if (saveStatus) {
            saveStatus.textContent =
              'ERROR';
          }

          if (saveBtn) {
            saveBtn.disabled = false;
          }

          alert(
            error instanceof Error
              ? error.message
              : 'Gagal menyimpan chord.'
          );
        }
      }
    );

    /*
     * =========================================================
     * CTRL / CMD + S
     * =========================================================
     */

    window.addEventListener(
      'keydown',
      (event) => {

        const modifier =
          event.ctrlKey ||
          event.metaKey;

        if (
          modifier &&
          event.key.toLowerCase() === 's'
        ) {

          event.preventDefault();

          form.requestSubmit();
        }
      }
    );

    /*
     * =========================================================
     * BEFORE LEAVE
     * =========================================================
     */

    window.addEventListener(
      'beforeunload',
      (event) => {

        if (!isDirty) {
          return;
        }

        event.preventDefault();

        event.returnValue = '';
      }
    );

    /*
     * =========================================================
     * INITIAL STATE
     * =========================================================
     */

    updatePreview();
    checkDirtyState();

    requestAnimationFrame(() => {

      const page =
        document.querySelector(
          '.editor-page'
        );

      if (page) {
        page.classList.add(
          'is-ready'
        );
      }
    });
  }
</script>

<style is:global>
  /* =========================================================
     ROOT
  ========================================================== */

  .editor-page {
    --black: #090909;
    --ink: #171717;
    --muted: #737373;
    --soft: #a3a3a3;
    --line: #e2e2e2;
    --surface: #fafafa;
    --white: #ffffff;

    width: 100%;
    max-width: 1200px;

    margin: 0 auto;

    padding:
      48px
      28px
      70px;

    color: var(--ink);
  }

  /* =========================================================
     HEADER
  ========================================================== */

  .editor-header {
    display: flex;

    align-items: flex-end;

    justify-content: space-between;

    gap: 32px;

    padding-bottom: 31px;

    margin-bottom: 30px;

    border-bottom: 1px solid var(--line);
  }

  .back-link {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 19px;

    color: var(--muted);

    text-decoration: none;

    font-size: 10px;

    font-weight: 650;

    transition:
      color 150ms ease,
      transform 150ms ease;
  }

  .back-link:hover {
    color: var(--black);
    transform: translateX(-2px);
  }

  .back-link svg {
    width: 13px;
    height: 13px;

    fill: none;

    stroke: currentColor;

    stroke-width: 1.7;

    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .editor-eyebrow {
    display: flex;

    align-items: center;

    gap: 8px;

    margin-bottom: 12px;

    color: var(--muted);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.18em;
  }

  .eyebrow-line {
    width: 20px;
    height: 1px;

    background: var(--black);
  }

  .editor-heading h1 {
    margin: 0;

    color: var(--black);

    font-size:
      clamp(2.5rem, 7vw, 4.8rem);

    line-height: 0.88;

    font-weight: 900;

    letter-spacing: -0.07em;
  }

  .editor-heading p {
    max-width: 470px;

    margin:
      17px
      0
      0;

    color: var(--muted);

    font-size: 12px;

    line-height: 1.7;
  }

  .editor-top-actions {
    display: flex;

    align-items: center;

    gap: 14px;

    padding-bottom: 4px;
  }

  .save-status {
    color: var(--soft);

    font-family:
      ui-monospace,
      SFMono-Regular,
      Menlo,
      Monaco,
      Consolas,
      monospace;

    font-size: 7px;

    font-weight: 800;

    letter-spacing: 0.13em;
  }

  .save-status.is-draft {
    color: var(--black);
  }

  .preview-link {
    display: inline-flex;

    align-items: center;

    gap: 7px;

    height: 34px;

    padding: 0 11px;

    border: 1px solid var(--line);

    background: white;

    color: var(--muted);

