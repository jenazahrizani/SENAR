    .focus-button span {
      display: inline;
      font-size: 10px;
      font-weight: 700;
    }

    .song-eyebrow {
      gap: 9px;
      margin-bottom: 11px;
      font-size: 8px;
    }

    .eyebrow-line {
      width: 20px;
    }

    .song-kicker {
      margin-bottom: 13px;
      font-size: 8px;
    }

    .song-header h1 {
      max-width: 820px;
      font-size: clamp(3rem, 7vw, 5.2rem);
    }

    .song-meta {
      gap: 13px;
      margin-top: 19px;
    }

    .artist {
      font-size: 14px;
    }

    .song-key {
      gap: 7px;
      font-size: 12px;
    }

    .song-key .key-label {
      font-size: 8px;
    }

    .player-shell {
      top: 14px;
      margin-bottom: 25px;
      border-radius: 0;
    }

    .player-header {
      grid-template-columns:
        1fr
        auto
        1fr;
      padding: 9px 13px;
      font-size: 8px;
    }

    .player-mode {
      display: inline;
      color: var(--black);
    }

    .player-controls {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
      padding: 10px 13px;
    }

    .player-main-controls {
      display: flex;
      align-items: center;
      gap: 9px;
    }

    .primary-control {
      min-height: 32px;
      padding: 0 11px;
      border-radius: 0;
    }

    .control-label {
      display: inline;
    }

    .speed-button {
      width: 26px;
      height: 26px;
      border-radius: 0;
    }

    .player-secondary-controls {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .text-button {
      min-height: 0;
      padding: 6px 8px;
      border: 0;
      border-radius: 0;
      background: transparent;
    }

    .utility-bar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      margin-bottom: 42px;
