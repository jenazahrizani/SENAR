---
import { parseChordContent } from '../lib/chordParser';

export interface Props {
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const { title, artist, key, content } = Astro.props;
const parsedLines = parseChordContent(content);
---

<section class="song-detail" data-song-detail>
  <!-- =========================================================
       SONG HEADER
  ========================================================== -->
  <header class="song-header">
    <div class="song-header-main">
      <div class="song-eyebrow">
        <span class="eyebrow-line"></span>
        <span>CHORD & LYRICS</span>
      </div>

      <h1>{title}</h1>

      <div class="song-meta">
        <span class="artist">{artist}</span>

        {key && (
          <>
            <span class="meta-separator"></span>
            <span class="song-key">
              <span class="key-label">KEY</span>
              <span data-current-key>{key}</span>
            </span>
          </>
        )}
      </div>
    </div>

    <div class="header-actions">
      <button
        type="button"
        class="icon-button"
        data-focus-toggle
        aria-label="Aktifkan mode fokus"
        title="Mode fokus"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3"/>
        </svg>
      </button>
    </div>
  </header>

  <!-- =========================================================
       PLAYER BAR
  ========================================================== -->
  <div class="player-shell" data-player>
    <div class="player-top">
      <div class="player-status">
        <span class="status-dot" data-status-dot></span>
        <span data-status-text>READY</span>
      </div>

      <div class="player-title">
        <span>PLAYER MODE</span>
      </div>

      <div class="player-time">
        <span data-progress-text>0%</span>
      </div>
    </div>

    <div class="progress-track" aria-hidden="true">
      <div class="progress-fill" data-progress></div>
    </div>

    <div class="player-controls">
      <!-- Auto scroll -->
      <div class="control-group auto-scroll-controls">
        <button
          type="button"
          class="primary-control"
          data-scroll-toggle
          aria-label="Mulai auto scroll"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" data-play-icon>
            <path d="M8 5v14l11-7z"/>
          </svg>

          <svg viewBox="0 0 24 24" aria-hidden="true" data-pause-icon hidden>
            <path d="M7 5h3v14H7zM14 5h3v14h-3z"/>
          </svg>

          <span data-scroll-label>Auto Scroll</span>
        </button>

        <div class="speed-control">
          <span>SPEED</span>

          <button
            type="button"
            class="speed-button"
            data-speed-down
            aria-label="Kurangi kecepatan"
          >
            −
          </button>

          <span class="speed-value" data-speed-value>1.0×</span>

          <button
            type="button"
            class="speed-button"
            data-speed-up
            aria-label="Tambah kecepatan"
          >
            +
          </button>
        </div>
      </div>

      <!-- Right controls -->
      <div class="control-group secondary-controls">
        <button type="button" class="text-control" data-reset>
          Reset
        </button>

        <button type="button" class="text-control" data-scroll-top>
          Atas
        </button>
      </div>
    </div>
  </div>

  <!-- =========================================================
       UKULELE TOOLBAR
  ========================================================== -->
  <div class="utility-bar">
    <div class="utility-heading">
      <span class="utility-label">PLAYER TOOLS</span>
      <span class="utility-description">optimized for ukulele · GCEA</span>
    </div>

    <div class="utility-controls">
      <!-- Transpose -->
      <div class="utility-control transpose-control">
        <button
          type="button"
          class="utility-button"
          data-transpose-down
          aria-label="Turunkan satu semitone"
        >
          −
        </button>

        <div class="utility-value">
          <span class="utility-small">TRANSPOSE</span>
          <strong data-transpose-value>0</strong>
        </div>

        <button
          type="button"
          class="utility-button"
          data-transpose-up
          aria-label="Naikkan satu semitone"
        >
          +
        </button>
      </div>

      <div class="utility-divider"></div>

      <!-- Font -->
      <div class="utility-control">
        <button
          type="button"
          class="utility-button utility-button-wide"
          data-font-down
          aria-label="Perkecil teks"
        >
          A−
        </button>

        <div class="utility-value">
          <span class="utility-small">TEXT</span>
          <strong data-font-value>100%</strong>
        </div>

        <button
          type="button"
          class="utility-button utility-button-wide"
          data-font-up
          aria-label="Perbesar teks"
        >
          A+
        </button>
      </div>

      <div class="utility-divider"></div>

      <!-- Ukulele mode -->
      <button
        type="button"
        class="utility-toggle"
        data-ukulele-toggle
        aria-pressed="false"
      >
        <span class="toggle-indicator"></span>
        <span>
          <strong>Ukulele Mode</strong>
          <small>Chord lebih besar</small>
        </span>
      </button>
    </div>
  </div>

  <!-- =========================================================
       CHORD CONTENT
  ========================================================== -->
  <article class="lyrics-container" data-lyrics>
    <div class="lyrics-inner">
      {parsedLines.map((line, lineIndex) => (
        <div
          class:list={['chord-line', line.length === 0 && 'empty-line']}
          style={`--line-index:${lineIndex}`}
        >
          {line.length === 0 ? (
            <span class="line-spacer" aria-hidden="true"></span>
          ) : (
            line.map((part, partIndex) => {
              if (part.type === 'section') {
                return (
                  <div
                    class="section-marker"
                    data-section
                    data-value={part.value}
                  >
                    <span class="section-line"></span>
                    <span>{part.value}</span>
                    <span class="section-line"></span>
                  </div>
                );
              }

              if (part.type === 'chord') {
                return (
                  <span
                    class="chord-item"
                    data-chord={part.value}
                    data-original-chord={part.value}
                    title={`Chord ${part.value}`}
                  >
                    <span class="chord-name">{part.value}</span>
                  </span>
                );
              }

              return (
                <span class="lyric-item">{part.value}</span>
              );
            })
          )}
        </div>
      ))}
    </div>
  </article>

  <!-- =========================================================
       MOBILE FLOATING CONTROL
  ========================================================== -->
  <div class="mobile-player">
    <button
      type="button"
      class="mobile-play"
      data-mobile-play
      aria-label="Mulai atau hentikan auto scroll"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true" data-mobile-play-icon>
        <path d="M8 5v14l11-7z"/>
      </svg>

      <svg viewBox="0 0 24 24" aria-hidden="true" data-mobile-pause-icon hidden>
        <path d="M7 5h3v14H7zM14 5h3v14h-3z"/>
      </svg>
    </button>

    <div class="mobile-player-info">
      <span>SCROLL</span>
      <strong data-mobile-speed>1.0×</strong>
    </div>

    <button
      type="button"
      class="mobile-speed"
      data-mobile-speed-up
      aria-label="Naikkan kecepatan scroll"
    >
      +
    </button>
  </div>
</section>

<script>
  const root = document.querySelector('[data-song-detail]');

  if (root) {
    const lyrics = root.querySelector('[data-lyrics]');
    const progress = root.querySelector('[data-progress]');
    const progressText = root.querySelector('[data-progress-text]');
    const statusText = root.querySelector('[data-status-text]');
    const statusDot = root.querySelector('[data-status-dot]');

    const scrollToggle = root.querySelector('[data-scroll-toggle]');
    const scrollLabel = root.querySelector('[data-scroll-label]');
    const playIcon = root.querySelector('[data-play-icon]');
    const pauseIcon = root.querySelector('[data-pause-icon]');

    const speedValue = root.querySelector('[data-speed-value]');
    const mobileSpeed = root.querySelector('[data-mobile-speed]');

    const transposeValue = root.querySelector('[data-transpose-value]');
    const fontValue = root.querySelector('[data-font-value]');

    const mobilePlay = root.querySelector('[data-mobile-play]');
    const mobilePlayIcon = root.querySelector('[data-mobile-play-icon]');
    const mobilePauseIcon = root.querySelector('[data-mobile-pause-icon]');

    const chordItems = Array.from(
      root.querySelectorAll('[data-chord]')
    );

    let isScrolling = false;
    let scrollAnimationFrame = null;

    let scrollSpeed = 1;
    let transpose = 0;
    let fontScale = 1;
    let lastTimestamp = 0;

    const SPEED_MIN = 0.5;
    const SPEED_MAX = 2.5;
    const SPEED_STEP = 0.5;

    const FONT_MIN = 0.85;
    const FONT_MAX = 1.3;
    const FONT_STEP = 0.05;

    const notes = [
      'C',
      'C#',
      'D',
      'D#',
      'E',
      'F',
      'F#',
      'G',
      'G#',
      'A',
      'A#',
      'B'
    ];

    const flatToSharp = {
      Db: 'C#',
      Eb: 'D#',
      Gb: 'F#',
      Ab: 'G#',
      Bb: 'A#'
    };

    const scrollableHeight = () => {
      return Math.max(
        0,
        document.documentElement.scrollHeight - window.innerHeight
      );
    };

    const updateProgress = () => {
      const max = scrollableHeight();
      const current = window.scrollY;

      const percentage =
        max <= 0 ? 0 : Math.min(100, Math.max(0, (current / max) * 100));

      if (progress) {
        progress.style.width = `${percentage}%`;
      }

      if (progressText) {
        progressText.textContent = `${Math.round(percentage)}%`;
      }
    };

    const setStatus = (active) => {
      if (statusText) {
        statusText.textContent = active ? 'SCROLLING' : 'READY';
      }

      if (statusDot) {
        statusDot.classList.toggle('is-active', active);
      }
    };

    const setPlayIcons = (active) => {
      if (playIcon) playIcon.hidden = active;
      if (pauseIcon) pauseIcon.hidden = !active;

      if (mobilePlayIcon) mobilePlayIcon.hidden = active;
      if (mobilePauseIcon) mobilePauseIcon.hidden = !active;
    };

    const updateScrollButton = () => {
      if (scrollLabel) {
        scrollLabel.textContent = isScrolling
          ? 'Pause Scroll'
          : 'Auto Scroll';
      }

      setPlayIcons(isScrolling);
      setStatus(isScrolling);
    };

    const stopScroll = () => {
      isScrolling = false;

      if (scrollAnimationFrame) {
        cancelAnimationFrame(scrollAnimationFrame);
        scrollAnimationFrame = null;
      }

      lastTimestamp = 0;
      updateScrollButton();
    };

    const scrollFrame = (timestamp) => {
      if (!isScrolling) return;

      if (!lastTimestamp) {
        lastTimestamp = timestamp;
      }

      const delta = Math.min(50, timestamp - lastTimestamp);
      lastTimestamp = timestamp;

      /*
       * Base movement is deliberately slow so that the lyrics
       * remain readable while playing ukulele.
       */
      const pixelsPerSecond = 10 + scrollSpeed * 16;
      const movement = (pixelsPerSecond * delta) / 1000;

      window.scrollBy({
        top: movement,
        behavior: 'auto'
      });

      if (window.scrollY >= scrollableHeight() - 2) {
        stopScroll();
        return;
      }

      scrollAnimationFrame = requestAnimationFrame(scrollFrame);
    };

    const startScroll = () => {
      if (scrollableHeight() <= 0) return;

      isScrolling = true;
      lastTimestamp = 0;

      updateScrollButton();

      scrollAnimationFrame = requestAnimationFrame(scrollFrame);
    };

    const toggleScroll = () => {
      if (isScrolling) {
        stopScroll();
      } else {
        startScroll();
      }
    };

    const updateSpeed = () => {
      const value = `${scrollSpeed.toFixed(1)}×`;

      if (speedValue) {
        speedValue.textContent = value;
      }

      if (mobileSpeed) {
        mobileSpeed.textContent = value;
      }
    };

    const updateFont = () => {
      root.style.setProperty('--lyrics-scale', String(fontScale));

      if (fontValue) {
        fontValue.textContent = `${Math.round(fontScale * 100)}%`;
      }
    };

    const normalizeNote = (note) => {
      return flatToSharp[note] || note;
    };

    const transposeChord = (chord, amount) => {
      /*
       * Supports:
       * C
       * Cm
       * C7
       * Cmaj7
       * C#m7
       * Asus4
       * F#dim
       * Bbmaj7
       * C/G
       */
      const match = chord.match(
        /^([A-G](?:#|b)?)(.*?)(?:\/([A-G](?:#|b)?))?$/
      );

      if (!match) return chord;

      const root = normalizeNote(match[1]);
      const quality = match[2] || '';
      const bass = match[3]
        ? normalizeNote(match[3])
        : null;

      const rootIndex = notes.indexOf(root);

      if (rootIndex === -1) return chord;

      const getTransposed = (note) => {
        const index = notes.indexOf(note);

        if (index === -1) return note;

        return notes[(index + amount + 120) % 12];
      };

      const nextRoot = getTransposed(root);
      const nextBass = bass ? getTransposed(bass) : '';

      return `${nextRoot}${quality}${nextBass ? `/${nextBass}` : ''}`;
    };

    const updateTranspose = () => {
      chordItems.forEach((item) => {
        const original =
          item.getAttribute('data-original-chord') || '';

        const value = transposeChord(original, transpose);

        const name = item.querySelector('.chord-name');

        if (name) {
          name.textContent = value;
        }
      });

      if (transposeValue) {
        transposeValue.textContent =
          transpose > 0 ? `+${transpose}` : String(transpose);
      }
    };

    const changeTranspose = (amount) => {
      transpose += amount;

      if (transpose > 11) transpose = 0;
      if (transpose < -11) transpose = 0;

      updateTranspose();
    };

    const scrollToTop = () => {
      stopScroll();

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    };

    const resetPlayer = () => {
      stopScroll();

      transpose = 0;
      fontScale = 1;
      scrollSpeed = 1;

      updateTranspose();
      updateFont();
      updateSpeed();

      window.scrollTo({
        top: 0,
        behavior: 'smooth'
      });
    };

    const increaseSpeed = () => {
      scrollSpeed = Math.min(
        SPEED_MAX,
        scrollSpeed + SPEED_STEP
      );

      updateSpeed();
    };

    const decreaseSpeed = () => {
      scrollSpeed = Math.max(
        SPEED_MIN,
        scrollSpeed - SPEED_STEP
      );

      updateSpeed();
    };

    const increaseFont = () => {
      fontScale = Math.min(
        FONT_MAX,
        fontScale + FONT_STEP
      );

      updateFont();
    };

    const decreaseFont = () => {
      fontScale = Math.max(
        FONT_MIN,
        fontScale - FONT_STEP
      );

      updateFont();
    };

    /*
     * Focus mode
     */
    const focusToggle = root.querySelector(
      '[data-focus-toggle]'
    );

    focusToggle?.addEventListener('click', () => {
      root.classList.toggle('focus-mode');

      const active = root.classList.contains('focus-mode');

      focusToggle.setAttribute(
        'aria-label',
        active
          ? 'Keluar dari mode fokus'
          : 'Aktifkan mode fokus'
      );
    });

    /*
     * Ukulele mode
     */
    const ukuleleToggle = root.querySelector(
      '[data-ukulele-toggle]'
    );

    ukuleleToggle?.addEventListener('click', () => {
      const active = root.classList.toggle('ukulele-mode');

      ukuleleToggle.setAttribute(
        'aria-pressed',
        String(active)
      );
    });

    /*
     * Main controls
     */
    scrollToggle?.addEventListener('click', toggleScroll);
    mobilePlay?.addEventListener('click', toggleScroll);

    root
      .querySelector('[data-speed-up]')
      ?.addEventListener('click', increaseSpeed);

    root
      .querySelector('[data-speed-down]')
      ?.addEventListener('click', decreaseSpeed);

    root
      .querySelector('[data-mobile-speed-up]')
      ?.addEventListener('click', increaseSpeed);

    root
      .querySelector('[data-scroll-top]')
      ?.addEventListener('click', scrollToTop);

    root
      .querySelector('[data-reset]')
      ?.addEventListener('click', resetPlayer);

    /*
     * Transpose
     */
    root
      .querySelector('[data-transpose-up]')
      ?.addEventListener('click', () => {
        changeTranspose(1);
      });

    root
      .querySelector('[data-transpose-down]')
      ?.addEventListener('click', () => {
        changeTranspose(-1);
      });

    /*
     * Font
     */
    root
      .querySelector('[data-font-up]')
      ?.addEventListener('click', increaseFont);

    root
      .querySelector('[data-font-down]')
      ?.addEventListener('click', decreaseFont);

    /*
     * Keyboard shortcuts
     *
     * Space = auto scroll
     * ↑ / ↓ = scroll
     * + / - = font size
     * [ / ] = scroll speed
     * T = transpose up
     * R = reset
     */
    window.addEventListener('keydown', (event) => {
      const target = event.target;

      if (
        target instanceof HTMLInputElement ||
        target instanceof HTMLTextAreaElement
      ) {
        return;
      }

      if (event.code === 'Space') {
        event.preventDefault();
        toggleScroll();
      }

      if (event.key === 'ArrowDown') {
        window.scrollBy({
          top: 140,
          behavior: 'smooth'
        });
      }

      if (event.key === 'ArrowUp') {
        window.scrollBy({
          top: -140,
          behavior: 'smooth'
        });
      }

      if (event.key === '+') {
        increaseFont();
      }

      if (event.key === '-') {
        decreaseFont();
      }

      if (event.key === ']') {
        increaseSpeed();
      }

      if (event.key === '[') {
        decreaseSpeed();
      }

      if (event.key.toLowerCase() === 't') {
        changeTranspose(1);
      }

      if (event.key.toLowerCase() === 'r') {
        resetPlayer();
      }
    });

    /*
     * When user manually scrolls while auto scroll is active,
     * leave the player running. This feels more like a music
     * player than a locked animation.
     */
    let scrollTimeout;

    window.addEventListener(
      'scroll',
      () => {
        updateProgress();

        clearTimeout(scrollTimeout);

        scrollTimeout = setTimeout(() => {
          const nearBottom =
            window.scrollY >= scrollableHeight() - 10;

          if (nearBottom && isScrolling) {
            stopScroll();
          }
        }, 150);
      },
      { passive: true }
    );

    /*
     * Initial state
     */
    updateScrollButton();
    updateSpeed();
    updateFont();
    updateTranspose();
    updateProgress();
  }
</script>

<style>
  .song-detail {
    --lyrics-scale: 1;
    --black: #0a0a0a;
    --ink: #171717;
    --muted: #737373;
    --soft: #a3a3a3;
    --line: #e5e5e5;
    --surface: #fafafa;
    --white: #ffffff;

    width: 100%;
    max-width: 900px;
    margin: 0 auto;
    padding: 48px 28px 140px;
    color: var(--ink);
  }

  /* =========================================================
     HEADER
  ========================================================== */

  .song-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 32px;
    margin-bottom: 42px;
  }

  .song-header-main {
    min-width: 0;
  }

  .song-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 18px;
    color: var(--muted);
    font-size: 10px;
    font-weight: 800;
    letter-spacing: 0.18em;
  }

  .eyebrow-line {
    width: 20px;
    height: 1px;
    background: var(--black);
  }

  .song-header h1 {
    margin: 0;
    color: var(--black);
    font-size: clamp(2.2rem, 6vw, 4.2rem);
    line-height: 0.98;
    font-weight: 850;
    letter-spacing: -0.055em;
    max-width: 780px;
  }

  .song-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    margin-top: 20px;
  }

  .artist {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }

  .meta-separator {
    width: 3px;
    height: 3px;
    background: var(--soft);
    border-radius: 999px;
  }

  .song-key {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 12px;
    font-weight: 700;
  }

  .key-label {
    color: var(--soft);
    font-size: 9px;
    letter-spacing: 0.12em;
  }

  .icon-button {
    flex: 0 0 auto;
    width: 42px;
    height: 42px;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--black);
    cursor: pointer;
    transition:
      background 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .icon-button:hover {
    background: var(--surface);
    border-color: #cfcfcf;
  }

  .icon-button:active {
    transform: scale(0.95);
  }

  .icon-button svg {
    width: 17px;
    height: 17px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
  }

  /* =========================================================
     PLAYER
  ========================================================== */

  .player-shell {
    position: sticky;
    z-index: 30;
    top: 14px;
    margin-bottom: 28px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.96);
    border: 1px solid #dedede;
    box-shadow:
      0 1px 0 rgba(0, 0, 0, 0.04),
      0 12px 32px rgba(0, 0, 0, 0.06);
    backdrop-filter: blur(14px);
  }

  .player-top {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding: 10px 14px;
    border-bottom: 1px solid var(--line);
    color: var(--soft);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 9px;
    font-weight: 800;
    letter-spacing: 0.12em;
  }

  .player-status {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .status-dot {
    width: 6px;
    height: 6px;
    background: #c7c7c7;
    border-radius: 50%;
  }

  .status-dot.is-active {
    background: var(--black);
    box-shadow: 0 0 0 3px #e5e5e5;
  }

  .player-title {
    color: var(--black);
  }

  .player-time {
    text-align: right;
  }

  .progress-track {
    width: 100%;
    height: 2px;
    background: #eeeeee;
  }

  .progress-fill {
    width: 0;
    height: 100%;
    background: var(--black);
    transition: width 100ms linear;
  }

  .player-controls {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 11px 14px;
  }

  .control-group {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .primary-control {
