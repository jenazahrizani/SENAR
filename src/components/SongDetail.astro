---
import { parseChordContent } from '../lib/chordParser';

export interface Props {
  title: string;
  artist: string;
  key?: string;
  content: string;
}

const { title, artist, key, content } = Astro.props;
const parsedLines = parseChordContent(content);
---

<section
  class="song-detail"
  data-song-detail
  data-original-key={key || ''}
>
  <!-- =========================================================
       SONG HEADER
  ========================================================== -->

  <header class="song-header">
    <div class="song-header-main">

      <div class="song-eyebrow">
        <span class="eyebrow-line"></span>
        <span>CHORD &amp; LYRICS</span>
      </div>

      <h1>{title}</h1>

      <div class="song-meta">
        <span class="artist">{artist}</span>

        {key && (
          <>
            <span class="meta-separator"></span>

            <span class="song-key">
              <span class="key-label">KEY</span>

              <span data-current-key>
                {key}
              </span>
            </span>
          </>
        )}
      </div>
    </div>

    <div class="header-actions">
      <button
        type="button"
        class="icon-button"
        data-focus-toggle
        aria-label="Aktifkan mode fokus"
        title="Mode fokus"
      >
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M8 3H5a2 2 0 0 0-2 2v3M16 3h3a2 2 0 0 1 2 2v3M21 16v3a2 2 0 0 1-2 2h-3M3 16v3a2 2 0 0 0 2 2h3"
          />
        </svg>
      </button>
    </div>
  </header>

  <!-- =========================================================
       PLAYER BAR
  ========================================================== -->

  <div
    class="player-shell"
    data-player
  >
    <div class="player-top">

      <div class="player-status">
        <span
          class="status-dot"
          data-status-dot
        ></span>

        <span data-status-text>
          READY
        </span>
      </div>

      <div class="player-title">
        <span>PLAYER MODE</span>
      </div>

      <div class="player-time">
        <span data-progress-text>
          0%
        </span>
      </div>

    </div>

    <div
      class="progress-track"
      aria-hidden="true"
    >
      <div
        class="progress-fill"
        data-progress
      ></div>
    </div>

    <div class="player-controls">

      <!-- AUTO SCROLL -->

      <div class="control-group auto-scroll-controls">

        <button
          type="button"
          class="primary-control"
          data-scroll-toggle
          aria-label="Mulai auto scroll"
        >
          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            data-play-icon
          >
            <path d="M8 5v14l11-7z" />
          </svg>

          <svg
            viewBox="0 0 24 24"
            aria-hidden="true"
            data-pause-icon
            class="player-icon-hidden"
          >
            <path d="M7 5h3v14H7zM14 5h3v14h-3z" />
          </svg>

          <span data-scroll-label>
            Auto Scroll
          </span>
        </button>

        <div class="speed-control">

          <span>SPEED</span>

          <button
            type="button"
            class="speed-button"
            data-speed-down
            aria-label="Kurangi kecepatan"
          >
            −
          </button>

          <span
            class="speed-value"
            data-speed-value
          >
            1.10×
          </span>

          <button
            type="button"
            class="speed-button"
            data-speed-up
            aria-label="Tambah kecepatan"
          >
            +
          </button>

        </div>

      </div>

      <!-- SECONDARY CONTROLS -->

      <div class="control-group secondary-controls">

        <button
          type="button"
          class="text-control"
          data-reset
        >
          Reset
        </button>

        <button
          type="button"
          class="text-control"
          data-scroll-top
        >
          Atas
        </button>

      </div>
    </div>
  </div>

  <!-- =========================================================
       PLAYER TOOLS
  ========================================================== -->

  <div class="utility-bar">

    <div class="utility-heading">
      <span class="utility-label">
        PLAYER TOOLS
      </span>

      <span class="utility-description">
        optimized for ukulele · GCEA
      </span>
    </div>

    <div class="utility-controls">

      <!-- TRANSPOSE -->

      <div class="utility-control transpose-control">

        <button
          type="button"
          class="utility-button"
          data-transpose-down
          aria-label="Turunkan satu semitone"
        >
          −
        </button>

        <div class="utility-value">
          <span class="utility-small">
            TRANSPOSE
          </span>

          <strong data-transpose-value>
            0
          </strong>
        </div>

        <button
          type="button"
          class="utility-button"
          data-transpose-up
          aria-label="Naikkan satu semitone"
        >
          +
        </button>

      </div>

      <div class="utility-divider"></div>

      <!-- TEXT -->

      <div class="utility-control">

        <button
          type="button"
          class="utility-button utility-button-wide"
          data-font-down
          aria-label="Perkecil teks"
        >
          A−
        </button>

        <div class="utility-value">
          <span class="utility-small">
            TEXT
          </span>

          <strong data-font-value>
            100%
          </strong>
        </div>

        <button
          type="button"
          class="utility-button utility-button-wide"
          data-font-up
          aria-label="Perbesar teks"
        >
          A+
        </button>

      </div>

      <div class="utility-divider"></div>

      <!-- UKULELE MODE -->

      <button
        type="button"
        class="utility-toggle"
        data-ukulele-toggle
        aria-pressed="false"
      >
        <span class="toggle-indicator"></span>

        <span>
          <strong>Ukulele Mode</strong>
          <small>Chord lebih besar</small>
        </span>
      </button>

    </div>
  </div>

  <!-- =========================================================
       CHORD CONTENT
  ========================================================== -->

  <article
    class="lyrics-container"
    data-lyrics
  >
    <div class="lyrics-inner">

      {parsedLines.map((line, lineIndex) => (
        <div
          class:list={[
            'chord-line',
            line.length === 0 && 'empty-line'
          ]}
          style={`--line-index:${lineIndex}`}
        >
          {line.length === 0 ? (
            <span
              class="line-spacer"
              aria-hidden="true"
            ></span>
          ) : (
            line.map((part) => {

              if (part.type === 'section') {
                return (
                  <div
                    class="section-marker"
                    data-section
                    data-value={part.value}
                  >
                    <span class="section-line"></span>

                    <span>
                      {part.value}
                    </span>

                    <span class="section-line"></span>
                  </div>
                );
              }

              if (part.type === 'chord') {
                return (
                  <span
                    class="chord-item"
                    data-chord={part.value}
                    data-original-chord={part.value}
                    title={`Chord ${part.value}`}
                  >
                    <span class="chord-name">
                      {part.value}
                    </span>
                  </span>
                );
              }

              return (
                <span class="lyric-item">
                  {part.value}
                </span>
              );
            })
          )}
        </div>
      ))}

    </div>
  </article>

  <!-- =========================================================
       MOBILE PLAYER
  ========================================================== -->

  <div class="mobile-player">

    <button
      type="button"
      class="mobile-play"
      data-mobile-play
      aria-label="Mulai atau hentikan auto scroll"
    >
      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        data-mobile-play-icon
      >
        <path d="M8 5v14l11-7z" />
      </svg>

      <svg
        viewBox="0 0 24 24"
        aria-hidden="true"
        data-mobile-pause-icon
        class="player-icon-hidden"
      >
        <path d="M7 5h3v14H7zM14 5h3v14h-3z" />
      </svg>
    </button>

    <div class="mobile-player-info">
      <span>SCROLL</span>

      <strong data-mobile-speed>
        1.10×
      </strong>
    </div>

    <button
      type="button"
      class="mobile-speed"
      data-mobile-speed-up
      aria-label="Naikkan kecepatan scroll"
    >
      +
    </button>

  </div>
</section>

<script>
  const root = document.querySelector(
    '[data-song-detail]'
  );

  if (root instanceof HTMLElement) {

    /* =========================================================
       ELEMENTS
    ========================================================== */

    const lyrics =
      root.querySelector('[data-lyrics]');

    const progress =
      root.querySelector('[data-progress]');

    const progressText =
      root.querySelector('[data-progress-text]');

    const statusText =
      root.querySelector('[data-status-text]');

    const statusDot =
      root.querySelector('[data-status-dot]');

    const scrollToggle =
      root.querySelector('[data-scroll-toggle]');

    const scrollLabel =
      root.querySelector('[data-scroll-label]');

    const playIcon =
      root.querySelector('[data-play-icon]');

    const pauseIcon =
      root.querySelector('[data-pause-icon]');

    const speedValue =
      root.querySelector('[data-speed-value]');

    const mobileSpeed =
      root.querySelector('[data-mobile-speed]');

    const mobilePlay =
      root.querySelector('[data-mobile-play]');

    const mobilePlayIcon =
      root.querySelector('[data-mobile-play-icon]');

    const mobilePauseIcon =
      root.querySelector('[data-mobile-pause-icon]');

    const transposeValue =
      root.querySelector('[data-transpose-value]');

    const fontValue =
      root.querySelector('[data-font-value]');

    const currentKey =
      root.querySelector('[data-current-key]');

    const focusToggle =
      root.querySelector('[data-focus-toggle]');

    const ukuleleToggle =
      root.querySelector('[data-ukulele-toggle]');

    const chordItems = Array.from(
      root.querySelectorAll('[data-chord]')
    );

    /* =========================================================
       STATE
    ========================================================== */

    let isScrolling = false;

    let animationFrame:
      number | null = null;

    let scrollTimeout:
      ReturnType<typeof setTimeout> | null = null;

    let lastTimestamp = 0;

    let scrollSpeed = 1.10;

    let speedIndex = 3;

    let transpose = 0;

    let fontScale = 1;

    /* =========================================================
       CONFIG
    ========================================================== */

    const SPEEDS = [
      0.60,
      0.80,
      1.00,
      1.10,
      1.25,
      1.50,
      2.00,
      2.50,
      3.00,
      4.00,
      5.00,
      6.00,
      8.00
    ];

    const FONT_MIN = 0.85;
    const FONT_MAX = 1.35;
    const FONT_STEP = 0.05;

    const TRANSPOSE_MIN = -12;
    const TRANSPOSE_MAX = 12;

    /* =========================================================
       NOTES
    ========================================================== */

    const notes = [
      'C',
      'C#',
      'D',
      'D#',
      'E',
      'F',
      'F#',
      'G',
      'G#',
      'A',
      'A#',
      'B'
    ];

    const flatToSharp: Record<
      string,
      string
    > = {
      Db: 'C#',
      Eb: 'D#',
      Gb: 'F#',
      Ab: 'G#',
      Bb: 'A#'
    };

    const normalizeNote = (
      note: string
    ): string => {
      return flatToSharp[note] || note;
    };

    /* =========================================================
       SCROLL DIMENSIONS
    ========================================================== */

    const getScrollableHeight = (): number => {
      return Math.max(
        0,
        document.documentElement.scrollHeight -
          window.innerHeight
      );
    };

    /* =========================================================
       PROGRESS
    ========================================================== */

    const updateProgress = (): void => {

      const max =
        getScrollableHeight();

      const current =
        window.scrollY;

      const percentage =
        max <= 0
          ? 0
          : Math.min(
              100,
              Math.max(
                0,
                (current / max) * 100
              )
            );

      if (
        progress instanceof HTMLElement
      ) {
        progress.style.width =
          `${percentage}%`;
      }

      if (
        progressText instanceof HTMLElement
      ) {
        progressText.textContent =
          `${Math.round(percentage)}%`;
      }
    };

    /* =========================================================
       PLAYER STATUS
    ========================================================== */

    const setStatus = (
      active: boolean
    ): void => {

      if (
        statusText instanceof HTMLElement
      ) {
        statusText.textContent =
          active
            ? 'SCROLLING'
            : 'READY';
      }

      if (
        statusDot instanceof HTMLElement
      ) {
        statusDot.classList.toggle(
          'is-active',
          active
        );
      }
    };

    /* =========================================================
       PLAY / PAUSE ICONS
    ========================================================== */

    const setPlayIcons = (
      active: boolean
    ): void => {

      if (
        playIcon instanceof SVGElement
      ) {
        playIcon.classList.toggle(
          'player-icon-hidden',
          active
        );
      }

      if (
        pauseIcon instanceof SVGElement
      ) {
        pauseIcon.classList.toggle(
          'player-icon-hidden',
          !active
        );
      }

      if (
        mobilePlayIcon instanceof SVGElement
      ) {
        mobilePlayIcon.classList.toggle(
          'player-icon-hidden',
          active
        );
      }

      if (
        mobilePauseIcon instanceof SVGElement
      ) {
        mobilePauseIcon.classList.toggle(
          'player-icon-hidden',
          !active
        );
      }
    };

    /* =========================================================
       PLAYER CONTROL UI
    ========================================================== */

    const updateScrollButton = (): void => {

      if (
        scrollLabel instanceof HTMLElement
      ) {
        scrollLabel.textContent =
          isScrolling
            ? 'Pause Scroll'
            : 'Auto Scroll';
      }

      setPlayIcons(
        isScrolling
      );

      setStatus(
        isScrolling
      );
    };

    /* =========================================================
       STOP SCROLL
    ========================================================== */

    const stopScroll = (): void => {

      isScrolling = false;

      if (
        animationFrame !== null
      ) {
        cancelAnimationFrame(
          animationFrame
        );

        animationFrame = null;
      }

      lastTimestamp = 0;

      updateScrollButton();
    };

    /* =========================================================
       AUTO SCROLL FRAME
    ========================================================== */

    const scrollFrame = (
      timestamp: number
    ): void => {

      if (!isScrolling) {
        return;
      }

      if (!lastTimestamp) {
        lastTimestamp =
          timestamp;
      }

      const delta =
        Math.min(
          50,
          timestamp -
            lastTimestamp
        );

      lastTimestamp =
        timestamp;

      /*
       * Default 1.10× ≈ 34px/s.
       *
       * Maximum 8× ≈ 200px/s.
       *
       * Cocok dari slow-reading sampai fast skip.
       */

      const pixelsPerSecond =
        8 +
        scrollSpeed * 24;

      const movement =
        (
          pixelsPerSecond *
          delta
        ) / 1000;

      window.scrollBy({
        top: movement,
        behavior: 'auto'
      });

      const max =
        getScrollableHeight();

      if (
        max <= 0 ||
        window.scrollY >=
          max - 2
      ) {
        stopScroll();
        return;
      }

      animationFrame =
        requestAnimationFrame(
          scrollFrame
        );
    };

    /* =========================================================
       START
    ========================================================== */

    const startScroll = (): void => {

      if (
        getScrollableHeight() <= 0
      ) {
        return;
      }

      isScrolling = true;

      lastTimestamp = 0;

      updateScrollButton();

      animationFrame =
        requestAnimationFrame(
          scrollFrame
        );
    };

    /* =========================================================
       TOGGLE
    ========================================================== */

    const toggleScroll = (): void => {

      if (isScrolling) {
        stopScroll();
      } else {
        startScroll();
      }
    };

    /* =========================================================
       SPEED
    ========================================================== */

    const updateSpeed = (): void => {

      const value =
        `${scrollSpeed.toFixed(2)}×`;

      if (
        speedValue instanceof HTMLElement
      ) {
        speedValue.textContent =
          value;
      }

      if (
        mobileSpeed instanceof HTMLElement
      ) {
        mobileSpeed.textContent =
          value;
      }
    };

    const increaseSpeed = (): void => {

      if (
        speedIndex <
        SPEEDS.length - 1
      ) {
        speedIndex += 1;

        scrollSpeed =
          SPEEDS[speedIndex];
      }

      updateSpeed();
    };

    const decreaseSpeed = (): void => {

      if (
        speedIndex > 0
      ) {
        speedIndex -= 1;

        scrollSpeed =
          SPEEDS[speedIndex];
      }

      updateSpeed();
    };

    /* =========================================================
       FONT
    ========================================================== */

    const updateFont = (): void => {

      root.style.setProperty(
        '--lyrics-scale',
        String(fontScale)
      );

      if (
        fontValue instanceof HTMLElement
      ) {
        fontValue.textContent =
          `${Math.round(
            fontScale * 100
          )}%`;
      }
    };

    const increaseFont = (): void => {

      fontScale =
        Math.min(
          FONT_MAX,
          Number(
            (
              fontScale +
              FONT_STEP
            ).toFixed(2)
          )
        );

      updateFont();
    };

    const decreaseFont = (): void => {

      fontScale =
        Math.max(
          FONT_MIN,
          Number(
            (
              fontScale -
              FONT_STEP
            ).toFixed(2)
          )
        );

      updateFont();
    };

    /* =========================================================
       TRANSPOSE CHORD
    ========================================================== */

    const transposeChord = (
      chord: string,
      amount: number
    ): string => {

      /*
       * Supported:
       *
       * C
       * Cm
       * C7
       * Cmaj7
       * C#m7
       * Asus4
       * F#dim
       * Bbmaj7
       * C/G
       * Am7/G
       */

      const match =
        chord.match(
          /^([A-G](?:#|b)?)([^/]*?)(?:\/([A-G](?:#|b)?))?$/
        );

      if (!match) {
        return chord;
      }

      const root =
        normalizeNote(
          match[1]
        );

      const quality =
        match[2] || '';

      const bass =
        match[3]
          ? normalizeNote(
              match[3]
            )
          : null;

      const moveNote = (
        note: string
      ): string => {

        const index =
          notes.indexOf(
            normalizeNote(note)
          );

        if (index < 0) {
          return note;
        }

        return notes[
          (
            index +
            amount +
            1200
          ) % 12
        ];
      };

      const nextRoot =
        moveNote(root);

      const nextBass =
        bass
          ? moveNote(bass)
          : '';

      return (
        `${nextRoot}` +
        `${quality}` +
        `${
          nextBass
            ? `/${nextBass}`
            : ''
        }`
      );
    };

    /* =========================================================
       UPDATE TRANSPOSE
    ========================================================== */

    const updateTranspose = (): void => {

      chordItems.forEach(
        (item) => {

          if (
            !(item instanceof HTMLElement)
          ) {
            return;
          }

          const original =
            item.getAttribute(
              'data-original-chord'
            ) || '';

          const value =
            transposeChord(
              original,
              transpose
            );

          const chordName =
            item.querySelector(
              '.chord-name'
            );

          if (
            chordName instanceof HTMLElement
          ) {
            chordName.textContent =
              value;
          }
        }
      );

      /*
       * Header key ikut transpose.
       */

      const originalKey =
        root.getAttribute(
          'data-original-key'
        );

      if (
        originalKey &&
        currentKey instanceof HTMLElement
      ) {
        currentKey.textContent =
          transposeChord(
            originalKey,
            transpose
          );
      }

      if (
        transposeValue instanceof HTMLElement
      ) {
        if (transpose === 0) {
          transposeValue.textContent =
            '0';
        } else if (
          transpose > 0
        ) {
          transposeValue.textContent =
            `+${transpose}`;
        } else {
          transposeValue.textContent =
            String(transpose);
        }
      }
    };

    /* =========================================================
       CHANGE TRANSPOSE
    ========================================================== */

    const changeTranspose = (
      amount: number
    ): void => {

      transpose += amount;

      /*
       * Circular semitone range.
       */

      if (
        transpose >
        TRANSPOSE_MAX
      ) {
        transpose =
          TRANSPOSE_MIN;
      }

      if (
        transpose <
        TRANSPOSE_MIN
      ) {
        transpose =
          TRANSPOSE_MAX;
      }

      updateTranspose();
    };

    /* =========================================================
       GO TO SONG TOP
    ========================================================== */

    const scrollToLyricsTop =
      (): void => {

        stopScroll();

        let target:
          Element | null =
          lyrics;

        if (
          !(target instanceof HTMLElement)
        ) {
          target =
            root.querySelector(
              '.lyrics-container'
            );
        }

        if (
          !(target instanceof HTMLElement)
        ) {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });

          return;
        }

        const rect =
          target.getBoundingClientRect();

        /*
         * Sticky player/header offset.
         */

        const offset =
          105;

        const destination =
          Math.max(
            0,
            window.scrollY +
              rect.top -
              offset
          );

        window.scrollTo({
          top: destination,
          behavior: 'smooth'
        });
      };

    /* =========================================================
       RESET PLAYER
    ========================================================== */

    const resetPlayer = (): void => {

      stopScroll();

      /*
       * Restore speed.
       */

      speedIndex = 3;

      scrollSpeed =
        SPEEDS[speedIndex];

      /*
       * Restore transpose.
       */

      transpose = 0;

      /*
       * Restore text size.
       */

      fontScale = 1;

      /*
       * Restore modes.
       */

      root.classList.remove(
        'focus-mode'
      );

      root.classList.remove(
        'ukulele-mode'
      );

      if (
        focusToggle instanceof HTMLButtonElement
      ) {
        focusToggle.setAttribute(
          'aria-label',
          'Aktifkan mode fokus'
        );
      }

      if (
        ukuleleToggle instanceof HTMLButtonElement
      ) {
        ukuleleToggle.setAttribute(
          'aria-pressed',
          'false'
        );
      }

      updateSpeed();
      updateFont();
      updateTranspose();

      /*
       * Reset position ke awal lagu.
       */

      scrollToLyricsTop();
    };

    /* =========================================================
       FOCUS MODE
    ========================================================== */

    if (
      focusToggle instanceof HTMLButtonElement
    ) {
      focusToggle.addEventListener(
        'click',
        () => {

          const active =
            root.classList.toggle(
              'focus-mode'
            );

          focusToggle.setAttribute(
            'aria-label',
            active
              ? 'Keluar dari mode fokus'
              : 'Aktifkan mode fokus'
          );
        }
      );
    }

    /* =========================================================
       UKULELE MODE
    ========================================================== */

    if (
      ukuleleToggle instanceof HTMLButtonElement
    ) {
      ukuleleToggle.addEventListener(
        'click',
        () => {

          const active =
            root.classList.toggle(
              'ukulele-mode'
            );

          ukuleleToggle.setAttribute(
            'aria-pressed',
            String(active)
          );
        }
      );
    }

    /* =========================================================
       MAIN CONTROLS
    ========================================================== */

    if (
      scrollToggle instanceof HTMLButtonElement
    ) {
      scrollToggle.addEventListener(
        'click',
        toggleScroll
      );
    }

    if (
      mobilePlay instanceof HTMLButtonElement
    ) {
      mobilePlay.addEventListener(
        'click',
        toggleScroll
      );
    }

    const speedUp =
      root.querySelector(
        '[data-speed-up]'
      );

    if (
      speedUp instanceof HTMLButtonElement
    ) {
      speedUp.addEventListener(
        'click',
        increaseSpeed
      );
    }

    const speedDown =
      root.querySelector(
        '[data-speed-down]'
      );

    if (
      speedDown instanceof HTMLButtonElement
    ) {
      speedDown.addEventListener(
        'click',
        decreaseSpeed
      );
    }

    const mobileSpeedUp =
      root.querySelector(
        '[data-mobile-speed-up]'
      );

    if (
      mobileSpeedUp instanceof HTMLButtonElement
    ) {
      mobileSpeedUp.addEventListener(
        'click',
        increaseSpeed
      );
    }

    const topButton =
      root.querySelector(
        '[data-scroll-top]'
      );

    if (
      topButton instanceof HTMLButtonElement
    ) {
      topButton.addEventListener(
        'click',
        scrollToLyricsTop
      );
    }

    const resetButton =
      root.querySelector(
        '[data-reset]'
      );

    if (
      resetButton instanceof HTMLButtonElement
    ) {
      resetButton.addEventListener(
        'click',
        resetPlayer
      );
    }

    /* =========================================================
       TRANSPOSE BUTTONS
    ========================================================== */

    const transposeUp =
      root.querySelector(
        '[data-transpose-up]'
      );

    if (
      transposeUp instanceof HTMLButtonElement
    ) {
      transposeUp.addEventListener(
        'click',
        () => {
          changeTranspose(1);
        }
      );
    }

    const transposeDown =
      root.querySelector(
        '[data-transpose-down]'
      );

    if (
      transposeDown instanceof HTMLButtonElement
    ) {
      transposeDown.addEventListener(
        'click',
        () => {
          changeTranspose(-1);
        }
      );
    }

    /* =========================================================
       FONT BUTTONS
    ========================================================== */

    const fontUp =
      root.querySelector(
        '[data-font-up]'
      );

    if (
      fontUp instanceof HTMLButtonElement
    ) {
      fontUp.addEventListener(
        'click',
        increaseFont
      );
    }

    const fontDown =
      root.querySelector(
        '[data-font-down]'
      );

    if (
      fontDown instanceof HTMLButtonElement
    ) {
      fontDown.addEventListener(
        'click',
        decreaseFont
      );
    }

    /* =========================================================
       KEYBOARD SHORTCUTS
    ========================================================== */

    window.addEventListener(
      'keydown',
      (event: KeyboardEvent) => {

        const target =
          event.target;

        if (
          target instanceof HTMLInputElement ||
          target instanceof HTMLTextAreaElement ||
          target instanceof HTMLButtonElement ||
          target instanceof HTMLSelectElement
        ) {
          return;
        }

        /*
         * Space
         */

        if (
          event.code === 'Space'
        ) {
          event.preventDefault();

          toggleScroll();

          return;
        }

        /*
         * Manual movement.
         */

        if (
          event.key === 'ArrowDown'
        ) {
          event.preventDefault();

          stopScroll();

          window.scrollBy({
            top: 140,
            behavior: 'smooth'
          });

          return;
        }

        if (
          event.key === 'ArrowUp'
        ) {
          event.preventDefault();

          stopScroll();

          window.scrollBy({
            top: -140,
            behavior: 'smooth'
          });

          return;
        }

        /*
         * Font
         */

        if (
          event.key === '+'
        ) {
          increaseFont();
          return;
        }

        if (
          event.key === '-'
        ) {
          decreaseFont();
          return;
        }

        /*
         * Speed
         */

        if (
          event.key === ']'
        ) {
          increaseSpeed();
          return;
        }

        if (
          event.key === '['
        ) {
          decreaseSpeed();
          return;
        }

        /*
         * Transpose.
         *
         * T       = +1
         * Shift T = -1
         */

        if (
          event.key.toLowerCase() === 't'
        ) {
          changeTranspose(
            event.shiftKey
              ? -1
              : 1
          );

          return;
        }

        /*
         * Reset.
         */

        if (
          event.key.toLowerCase() === 'r'
        ) {
          resetPlayer();
          return;
        }

        /*
         * Home.
         */

        if (
          event.key === 'Home'
        ) {
          event.preventDefault();

          scrollToLyricsTop();
        }
      }
    );

    /* =========================================================
       SCROLL LISTENER
    ========================================================== */

    window.addEventListener(
      'scroll',
      () => {

        updateProgress();

        if (
          scrollTimeout !== null
        ) {
          clearTimeout(
            scrollTimeout
          );
        }

        scrollTimeout =
          setTimeout(
            () => {

              const max =
                getScrollableHeight();

              const nearBottom =
                max <= 0 ||
                window.scrollY >=
                  max - 10;

              if (
                nearBottom &&
                isScrolling
              ) {
                stopScroll();
              }

            },
            120
          );
      },
      {
        passive: true
      }
    );

    /* =========================================================
       INITIAL STATE
    ========================================================== */

    updateScrollButton();
    updateSpeed();
    updateFont();
    updateTranspose();
    updateProgress();
  }
</script>

